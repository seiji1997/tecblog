---
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

const branches = [
  {
    id: 'topics', code: '01', label: 'Topics', caption: '分野から探す', tone: 'cyan',
    items: [
      { label: 'AI / Machine Learning', href: route('topics/ai-ml/') },
      { label: 'Data Engineering', href: route('topics/data-engineering/') },
      { label: 'Google Cloud', href: route('topics/cloud/') },
      { label: 'Snowflake', href: route('topics/snowflake/') },
      { label: 'Engineering Tools', href: route('topics/engineering/') },
    ],
  },
  {
    id: 'learn', code: '02', label: 'Learn', caption: '学習ページを読む', tone: 'violet',
    items: [
      { label: 'AI / Machine Learning', href: route('learn/ai-ml/') },
      { label: 'Data Engineering', href: route('learn/data-engineering/') },
      { label: 'Google Cloud', href: route('learn/cloud/') },
    ],
  },
  {
    id: 'thoughts', code: '03', label: 'Thoughts', caption: '考えをたどる', tone: 'amber',
    items: [
      { label: 'T.01 · Technology & Engineering', href: route('thoughts/technology-engineering/') },
      { label: 'T.02 · Work & Career', href: route('thoughts/work-career/') },
      { label: 'T.03 · Learning & Growth', href: route('thoughts/learning-growth/') },
      { label: 'T.04 · Life & Interests', href: route('thoughts/life-interests/') },
      { label: 'T.05 · The First Beat', href: route('thoughts/the-first-beat/') },
    ],
  },
  {
    id: 'about', code: '04', label: 'My path', caption: '人と経歴を知る', tone: 'mint',
    items: [
      { label: 'Career timeline', href: `${route('')}#career` },
      { label: 'About this atlas', href: `${route('')}#about` },
    ],
  },
];
---

<div class="atlas-map" aria-label="サイトのインタラクティブマップ">
  <div class="center-node">
    <small>YOU ARE HERE</small>
    <strong>Seiji Tech Atlas</strong>
    <span>Learn <b>·</b> Build <b>·</b> Think</span>
  </div>
  <div class="branches">
    {branches.map((branch) => (
      <details class={`branch ${branch.tone}`} name="atlas-branches" open={branch.id === 'topics'}>
        <summary aria-label={`${branch.label}を開く・閉じる`}>
          <span class="branch-code">{branch.code}</span>
          <span class="branch-title"><strong>{branch.label}</strong><small>{branch.caption}</small></span>
          <span class="expand" aria-hidden="true">＋</span>
        </summary>
        <ul>
          {branch.items.map((item) => <li><a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </details>
    ))}
  </div>
  <p class="hint">枝をクリックして展開。項目をクリックすると、そのページへ移動します。</p>
</div>

<style>
  .atlas-map{--line:rgba(161,199,215,.27);position:relative;isolation:isolate;padding:34px 22px 20px;border:1px solid rgba(184,215,228,.21);border-radius:22px;background:radial-gradient(circle at 50% 15%,rgba(89,183,207,.12),transparent 42%),#0e1a25;overflow:hidden}
  .atlas-map::before{content:"";position:absolute;inset:0;z-index:-1;opacity:.24;background-image:radial-gradient(#779aac .7px,transparent .7px);background-size:22px 22px}
  .center-node{position:relative;display:flex;flex-direction:column;align-items:center;width:min(310px,100%);margin:0 auto;padding:23px 20px;border:1px solid #8ad9ef;border-radius:17px;background:#172d3b;box-shadow:0 0 36px rgba(82,179,210,.12);text-align:center}
  .center-node::after{content:"";position:absolute;top:100%;left:50%;width:1px;height:37px;background:var(--line)}.center-node small,.branch-code{font:700 .64rem ui-monospace,monospace;letter-spacing:.13em;color:#93d9eb}.center-node strong{margin:7px 0;color:#edf8fa;font-size:1.32rem;letter-spacing:-.025em}.center-node span{color:#98b6c1;font-size:.77rem}.center-node b{margin:0 5px;color:#e6b98d}
  .branches{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:start;gap:13px;margin-top:38px}.branches::before{content:"";position:absolute;top:-1px;left:calc(12.5% + 2px);right:calc(12.5% + 2px);height:1px;background:var(--line)}
  .branch{--accent:#90d6ec;position:relative;min-width:0;border:1px solid rgba(158,195,207,.22);border-radius:12px;background:#142431;overflow:visible}.branch::before{content:"";position:absolute;bottom:100%;left:50%;height:18px;width:1px;background:var(--line)}.branch.violet{--accent:#c3a9f3}.branch.amber{--accent:#efb989}.branch.mint{--accent:#95d8bf}.branch[open]{border-color:var(--accent)}
  summary{display:flex;align-items:center;gap:9px;padding:16px 12px;list-style:none;cursor:pointer}summary::-webkit-details-marker{display:none}summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:11px}.branch-code{color:var(--accent)}.branch-title{display:flex;flex:1;min-width:0;flex-direction:column;gap:4px}.branch-title strong{color:#eef5f7;font-size:.9rem}.branch-title small{color:#91a9b4;font-size:.69rem;line-height:1.4}.expand{color:var(--accent);font-size:1.2rem;line-height:1}.branch[open] .expand{transform:rotate(45deg)}
  ul{margin:0;padding:0 10px 12px;list-style:none}li{position:relative;margin-left:9px;padding-left:12px;border-left:1px solid rgba(155,188,204,.28)}li:last-child{border-left-color:transparent}li::before{content:"";position:absolute;left:-1px;top:17px;width:11px;height:1px;background:rgba(155,188,204,.38)}li a{display:flex;justify-content:space-between;gap:5px;padding:9px 7px;border-radius:6px;color:#c0d3db;font-size:.75rem;line-height:1.5;text-decoration:none;overflow-wrap:anywhere}li a:hover,li a:focus-visible{background:#203645;color:#fff;outline:none}li a span{flex:none;color:var(--accent)}.hint{margin:23px 0 0;color:#92a9b4;font-size:.73rem;text-align:center}
  @media(max-width:900px){.branches{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.branches::before{display:none}.branch::before{height:18px}.branch:nth-child(n+3)::before{display:none}.center-node::after{height:37px}}
  @media(max-width:560px){.atlas-map{padding:24px 15px 18px}.branches{grid-template-columns:1fr;gap:10px;margin-top:32px}.branch::before,.branches::before{display:none}.center-node::after{height:33px}.branch-title strong{font-size:1rem}li a{font-size:.84rem}}
</style>
