---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; description?: string; }
const { title = 'Seiji Tech Atlas', description = 'Knowledge, projects and thoughts around AI, Data Engineering, Snowflake and Cloud by Seiji Tanimoto.' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080d14" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <header class="topbar-wrap">
      <div class="topbar">
        <a class="brand" href="/"><span class="brand-mark">ST</span><span><b>Seiji</b> Tech Atlas</span></a>
        <div class="topbar-center">KNOWLEDGE · PROJECTS · THOUGHTS</div>
        <div class="topbar-actions"><a href="/#thoughts">Thoughts</a><a href="/#projects">Projects</a><a href="https://github.com/seiji1997" target="_blank">GitHub ↗</a></div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer">
      <div class="footer-inner shell-width">
        <span>© {new Date().getFullYear()} Seiji Tanimoto</span>
        <span>Knowledge should compound.</span>
        <span>Astro · GitHub Pages · ¥0 / month</span>
      </div>
    </footer>
  </body>
</html>
