---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeftRail from '../components/LeftRail.astro';
import RightRail from '../components/RightRail.astro';
import { getCollection } from 'astro:content';
import { topics, certifications, modes, projects, thoughts } from '../data';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout>
  <div class="site-shell shell-width">
    <LeftRail />

    <div class="main-column">
      <section class="atlas-hero">
        <div class="hero-gridline" aria-hidden="true"></div>
        <div class="hero-status"><span></span> Living knowledge base · 2026</div>
        <div class="hero-kicker">SEIJI TANIMOTO / PERSONAL ATLAS</div>
        <h1>I learn.<br/><em>I build.</em> I think.</h1>
        <p class="hero-copy">AI・Data・Cloudを中心に、学んだこと、作ったもの、考えたことを構造化して残す。資格対策で終わらせず、実務と次の学習に再利用できる自分の知識地図。</p>
        <div class="hero-path" aria-label="Site philosophy">
          <span>Learn</span><i>→</i><span>Structure</span><i>→</i><span>Publish</span><i>→</i><span>Reuse</span>
        </div>
        <div class="hero-signature">Knowledge should compound.</div>
      </section>

      <section class="mode-grid" aria-label="Three ways to explore">
        {modes.map((mode) => (
          <a class="mode-card" href={mode.href}>
            <div class="mode-card-top"><span>{mode.code}</span><small>{mode.jp}</small></div>
            <h2>{mode.title}</h2>
            <p>{mode.description}</p>
            <div class="mode-arrow">Explore <span>↗</span></div>
          </a>
        ))}
      </section>

      <section class="section-block atlas-overview" id="knowledge">
        <div class="block-heading">
          <div><span class="micro-label">01 · KNOWLEDGE MAP</span><h2>Explore by field</h2></div>
          <p>最初に全体像を見て、興味のある分野から深く潜る。記事が増えても迷わない構造を優先します。</p>
        </div>
        <div class="topic-stack">
          {topics.map((topic, index) => (
            <a class={`topic-row accent-${topic.accent}`} href={`/topics/${topic.slug}/`}>
              <div class="topic-row-index">0{index + 1}</div>
              <div class="topic-row-main">
                <div class="topic-row-eyebrow">{topic.eyebrow}</div>
                <h3>{topic.title}</h3>
                <p>{topic.description}</p>
                <div class="subtopic-pills">{topic.subtopics.map((s) => <span>{s}</span>)}</div>
              </div>
              <div class="topic-row-code"><small>{topic.count}</small>{topic.code}</div>
              <div class="topic-row-arrow">↗</div>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block personal-map-section">
        <div class="block-heading">
          <div><span class="micro-label">02 · PERSONAL MAP</span><h2>Where my interests meet</h2></div>
          <p>専門分野をバラバラに並べるのではなく、自分の仕事・学習・制作がどこで交わるかを可視化。</p>
        </div>
        <div class="constellation" aria-label="Personal interest map">
          <div class="constellation-line l1"></div><div class="constellation-line l2"></div><div class="constellation-line l3"></div><div class="constellation-line l4"></div>
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="node center-node"><small>ME</small><strong>AI & Data<br/>Consultant</strong></div>
          <div class="node node-ai"><small>THINK</small><strong>AI / ML</strong></div>
          <div class="node node-de"><small>BUILD</small><strong>Data<br/>Engineering</strong></div>
          <div class="node node-sf"><small>LEARN</small><strong>Snowflake</strong></div>
          <div class="node node-pm"><small>DELIVER</small><strong>PMO / Global</strong></div>
          <div class="constellation-caption">Technical depth ↔ Business context</div>
        </div>
      </section>

      <section class="section-block" id="certifications">
        <div class="block-heading">
          <div><span class="micro-label">03 · CERTIFICATION TRACK</span><h2>Study once. Reuse later.</h2></div>
          <p>合格のための暗記ではなく、2年後の再受験・実務・記事に再利用できる学習ログへ。</p>
        </div>
        <div class="roadmap-strip">
          {certifications.map((cert, i) => (
            <div class="roadmap-item">
              <div class="roadmap-number">0{i+1}</div>
              <div class="roadmap-content"><small>{cert.status}</small><strong>{cert.name}</strong><span>{cert.code}</span></div>
              <div class="roadmap-progress"><i style={`width:${cert.progress}%`}></i></div>
              <time>{cert.date}</time>
            </div>
          ))}
        </div>
      </section>

      <section class="section-block" id="projects">
        <div class="block-heading">
          <div><span class="micro-label">04 · BUILD</span><h2>Projects & experiments</h2></div>
          <p>完成品だけでなく、試作・検証・途中経過も残す。GitHubは実装、Atlasは文脈と学び。</p>
        </div>
        <div class="project-grid">
          {projects.map((project, i) => (
            <a class={`project-card project-${i+1}`} href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined}>
              <div class="project-meta"><span>{project.type}</span><span class="project-status">{project.status}</span></div>
              <div class="project-visual"><span>0{i+1}</span><div class="project-glyph">{i===0?'⌘':i===1?'◇':'↯'}</div></div>
              <h3>{project.title}</h3><p>{project.description}</p>
              <div class="note-tags">{project.tags.map(t => <span>#{t}</span>)}</div>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block" id="thoughts">
        <div class="block-heading">
          <div><span class="micro-label">05 · THINK</span><h2>Thoughts in progress</h2></div>
          <p>結論だけではなく、その時点の問いや仮説も残す。考えがどう変わったかも、このサイトの一部。</p>
        </div>
        <div class="thought-list">
          {thoughts.map((thought, i) => (
            <article class="thought-card">
              <div class="thought-index">T.{String(i+1).padStart(2,'0')}</div>
              <div><div class="thought-theme">{thought.theme} · {thought.status}</div><h3>{thought.title}</h3><p>{thought.excerpt}</p></div>
              <div class="thought-mark">“</div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-block" id="latest">
        <div class="block-heading">
          <div><span class="micro-label">06 · LATEST NOTES</span><h2>Recently documented</h2></div>
          <p>完璧な長文より、あとから検索して使える小さな知識単位を優先。</p>
        </div>
        <div class="note-grid">
          {posts.slice(0,6).map((post, index) => (
            <a class="note-card" href={`/notes/${post.id}/`}>
              <div class="note-card-top"><span>{String(index + 1).padStart(2,'0')}</span><span>{post.data.category}</span></div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
              <div class="note-tags">{post.data.tags.slice(0,3).map(t => <span>#{t}</span>)}</div>
              <div class="note-card-foot"><time>{post.data.publishedAt.toLocaleDateString('ja-JP')}</time><span>Read →</span></div>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block journey-panel" id="journey">
        <div class="block-heading">
          <div><span class="micro-label">07 · JOURNEY</span><h2>From chemistry to AI & Data</h2></div>
          <p>技術だけではなく、どこから来て、どこへ向かっているかも記録する。</p>
        </div>
        <div class="journey-line">
          <div class="journey-item"><time>Research</time><strong>Chemistry / Sustainable Engineering</strong><span>Organic synthesis → ML for yield prediction</span></div>
          <div class="journey-item"><time>2021–2025</time><strong>Machine Learning Engineer</strong><span>ML / DWH / Data Pipeline / Cloud</span></div>
          <div class="journey-item active"><time>2025–Now</time><strong>AI & Data Consultant</strong><span>Data / BI / PMO / Global Delivery</span></div>
          <div class="journey-item future"><time>Next</time><strong>Data × AI × Architecture</strong><span>Build deeper technical and delivery expertise</span></div>
        </div>
      </section>

      <section class="section-block about-panel" id="about">
        <span class="micro-label">08 · ABOUT</span>
        <div class="about-grid">
          <div><h2>Technical depth,<br/><em>business context.</em></h2></div>
          <div>
            <p>AI & Data領域で、Machine Learning / Data Engineering の実装経験と、PMO・グローバルプロジェクト推進の両方を経験しています。</p>
            <p>このサイトは履歴書ではなく、学習・制作・思考の変化まで含めて、自分自身を長期的に可視化する場所です。</p>
          </div>
        </div>
      </section>
    </div>

    <RightRail />
  </div>
</BaseLayout>
