---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeftRail from '../components/LeftRail.astro';
import RightRail from '../components/RightRail.astro';
import { topics, thoughts } from '../data';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

const skillGroups = [
  {
    code: 'AI',
    title: 'AI / Machine Learning',
    items: ['Python', 'scikit-learn', 'XGBoost', 'TensorFlow', 'Generative AI', 'LLM / RAG', 'AI Agents', 'Evaluation'],
  },
  {
    code: 'DE',
    title: 'Data Engineering',
    items: ['SQL', 'DWH', 'Data Modeling', 'ETL / ELT', 'Data Pipelines', 'Data Quality', 'Spark', 'PySpark'],
  },
  {
    code: 'GC',
    title: 'Google Cloud',
    items: ['Architecture', 'BigQuery', 'Data', 'Machine Learning', 'IAM', 'Security', 'Storage', 'Certification'],
  },
  {
    code: 'SF',
    title: 'Snowflake',
    items: ['Architecture', 'Warehouses', 'Streams & Tasks', 'Dynamic Tables', 'Snowpark', 'Streamlit', 'Stored Procedures', 'Governance'],
  },
  {
    code: 'BI',
    title: 'BI / Analytics',
    items: ['Tableau', 'Power BI', 'Looker', 'QuickSight', 'Excel / VBA', 'Data Visualization', 'Reporting', 'Monitoring'],
  },
  {
    code: 'ET',
    title: 'Engineering Tools',
    items: ['Git / GitHub', 'Linux', 'Docker', 'JavaScript', 'React', 'Automation', 'Developer Tools', 'Web'],
  },
];

const career = [
  {
    period: '2025–Now',
    state: 'CURRENT',
    title: 'AI & Data Consultant',
    description: 'Data platforms, BI, data validation, implementation support, PMO, vendor coordination, and global stakeholder collaboration.',
    tags: ['AI & Data', 'Snowflake', 'BI', 'PMO', 'Global Delivery'],
    active: true,
  },
  {
    period: '2021–2025',
    state: 'ENGINEERING',
    title: 'Machine Learning Engineer',
    description: 'Worked across machine learning, DWH, data pipelines, cloud environments, analytics, performance improvement, and implementation support.',
    tags: ['Machine Learning', 'Python', 'Data Engineering', 'Cloud', 'DWH'],
  },
  {
    period: '2019–2021',
    state: 'GRADUATE RESEARCH',
    title: 'Chemistry × Sustainable Engineering',
    description: 'Graduate study spanning organic synthesis and sustainable engineering, including machine-learning-based reaction yield prediction with XGBoost.',
    tags: ['Organic Synthesis', 'Sustainable Engineering', 'XGBoost', 'Research'],
  },
  {
    period: '2015–2019',
    state: 'UNIVERSITY',
    title: 'Applied Chemistry / Organic Synthesis',
    description: 'Started in applied chemistry and developed a foundation in organic synthesis, experiments, scientific reasoning, and quantitative analysis.',
    tags: ['Applied Chemistry', 'Organic Chemistry', 'Laboratory', 'Research'],
  },
];
---

<BaseLayout>
  <div class="site-shell shell-width">
    <LeftRail />

    <div class="main-column">
      <section class="atlas-hero">
        <div class="hero-gridline" aria-hidden="true"></div>
        <div class="hero-status"><span></span> Living knowledge base · 2026</div>
        <div class="hero-kicker">SEIJI / PERSONAL ATLAS</div>

        <h1>I learn.<br/><em>I build.</em> I think.</h1>

        <p class="hero-copy">
          AI・Data・Cloudを軸に、学び・制作・思考・キャリアを体系化し、
          自分の知識資産として蓄積するためのPersonal Atlas。
          振り返りながら再利用できる形に整え、次の学習・実装・挑戦へつなげていきます。
        </p>

        <div class="philosophy-map" aria-label="Learn Build Think">
          <div class="philosophy-line"></div>

          <div class="philosophy-step learn-step">
            <small>ABSORB</small>
            <strong>LEARN</strong>
            <p>Understand deeply.</p>
          </div>

          <div class="philosophy-step build-step">
            <small>TRANSFORM</small>
            <strong>BUILD</strong>
            <p>Turn knowledge into form.</p>
          </div>

          <div class="philosophy-step think-step">
            <small>REFLECT</small>
            <strong>THINK</strong>
            <p>Connect it to what comes next.</p>
          </div>
        </div>

        <div class="hero-signature">Knowledge should compound.</div>
        <a class="map-jump" href={route('map/')}>Explore the interactive map ↗</a>
      </section>

      <section class="section-block atlas-overview" id="knowledge">
        <div class="block-heading heading-solo">
          <div>
            <span class="micro-label">01 · KNOWLEDGE MAP</span>
            <h2>Explore by domain</h2>
          </div>
        </div>

        <div class="topic-stack">
          {topics.map((topic, index) => (
            <a
              class={`topic-row accent-${topic.accent}`}
              href={route(`topics/${topic.slug}/`)}
            >
              <div class="topic-row-index">0{index + 1}</div>

              <div class="topic-row-main">
                <div class="topic-row-eyebrow">{topic.eyebrow}</div>
                <h3>{topic.title}</h3>
                <p>{topic.description}</p>

                <div class="subtopic-pills">
                  {topic.subtopics.map((subtopic) => <span>{subtopic}</span>)}
                </div>
              </div>

              <div class="topic-row-code">
                <small>{topic.count}</small>
                {topic.code}
              </div>

              <div class="topic-row-arrow">↗</div>
            </a>
          ))}
        </div>
      </section>

      <section class="section-block personal-map-section">
        <div class="block-heading heading-solo">
          <div>
            <span class="micro-label">02 · PERSONAL MAP</span>
            <h2>Where my interests meet</h2>
          </div>
        </div>

        <div class="skills-map">
          <div class="skills-center">
            <span>SEIJI</span>
            <strong>AI & Data</strong>
            <small>Learn · Build · Deliver</small>
          </div>

          <div class="skills-branches">
            {skillGroups.map((group) => (
              <article class="skill-branch">
                <div class="branch-head">
                  <span>{group.code}</span>
                  <h3>{group.title}</h3>
                </div>

                <div class="branch-items">
                  {group.items.map((item) => <span>{item}</span>)}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section-block thought-blog" id="thoughts">
        <div class="block-heading heading-solo">
          <div>
            <span class="micro-label">03 · THINK / BLOG</span>
            <h2>Thoughts in progress</h2>
          </div>
        </div>

        <div class="thought-blog-list">
          {thoughts.map((thought, i) => (
            <a class="thought-blog-card" href={route(`thoughts/${thought.slug}/`)}>
              <div class="thought-blog-meta">
                <span>T.{String(i + 1).padStart(2, '0')}</span>
                <small>{thought.theme} · {thought.status}</small>
              </div>

              <h3>{thought.title}</h3>
              <p>{thought.excerpt}</p>

              <div class="thought-blog-foot">Open collection ↗</div>
            </a>
          ))}
          <a class="thought-blog-card" href={route('thoughts/the-first-beat/')}>
            <div class="thought-blog-meta">
              <span>T.05</span>
              <small>Thinking · Living note</small>
            </div>

            <h3>The First Beat</h3>
            <p>論理と感情、芸術と学習。考えが動き始めた瞬間を、話題ごとに少しずつ言葉にしていく。</p>

            <div class="thought-blog-foot">Open collection ↗</div>
          </a>
        </div>
      </section>

      <section class="section-block career-panel" id="career">
        <div class="block-heading heading-solo">
          <div>
            <span class="micro-label">04 · MY CAREER</span>
            <h2>My Career</h2>
          </div>
        </div>

        <div class="career-timeline">
          {career.map((item, index) => (
            <article class={`career-item ${item.active ? 'active' : ''}`}>
              <div class="career-axis">
                <div class="career-dot"></div>
                {index < career.length - 1 && <div class="career-line"></div>}
              </div>

              <div class="career-period">
                <time>{item.period}</time>
                <span>{item.state}</span>
              </div>

              <div class="career-content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>

                <div class="career-tags">
                  {item.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-block about-panel" id="about">
        <span class="micro-label">05 · ABOUT</span>

        <div class="about-grid expanded">
          <div>
            <h2>Technical depth,<br/><em>business context.</em></h2>
          </div>

          <div class="about-copy">
            <p>
              I work across AI and Data, with a background spanning machine learning,
              data engineering, cloud, BI, implementation, and project delivery.
              I am especially interested in the point where technical depth meets practical use.
            </p>

            <p>
              Seiji Tech Atlas is my personal knowledge base.
              I use it to organize what I learn, document what I build,
              and keep a visible record of how my interests and thinking evolve.
            </p>

            <div class="disclaimer">
              <strong>Personal site / disclaimer</strong>
              <p>
                This website is independently created and maintained by me.
                The views, opinions, notes, and interpretations published here are my own
                and do not represent, speak for, or reflect the official position of my employer
                or any organization I am affiliated with.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <RightRail />
  </div>
</BaseLayout>

<style>
  .map-jump{position:relative;z-index:3;display:inline-block;margin-top:19px;padding:9px 13px;border:1px solid rgba(113,208,235,.45);border-radius:8px;color:#a5e6f6;font-size:.8rem;text-decoration:none}.map-jump:hover{background:rgba(113,208,235,.12)}
  .hero-gridline{pointer-events:none}
  :global(body) {
    background:
      radial-gradient(circle at 72% 10%, rgba(76, 162, 255, .11), transparent 30%),
      radial-gradient(circle at 12% 32%, rgba(57, 208, 196, .07), transparent 24%),
      #0a1119;
  }

  :global(.section-block) {
    border-top-color: rgba(190, 220, 240, .2) !important;
  }

  .heading-solo {
    grid-template-columns: 1fr;
  }

  :global(.topic-row) {
    border-color: rgba(190, 220, 240, .22) !important;
    background:
      linear-gradient(135deg, rgba(18, 30, 43, .95), rgba(11, 20, 31, .96)) !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, .14);
  }

  :global(.topic-row:hover) {
    border-color: rgba(105, 211, 248, .42) !important;
    background:
      linear-gradient(135deg, rgba(22, 39, 55, .98), rgba(13, 24, 36, .98)) !important;
  }

  :global(.topic-row-main p) {
    color: #a7b7c1 !important;
  }

  :global(.subtopic-pills span) {
    border-color: rgba(190, 220, 240, .19) !important;
    background: #111c27 !important;
    color: #c0ccd3 !important;
  }

  .philosophy-map {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 34px;
    padding: 24px 0 10px;
  }

  .philosophy-line {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(104, 212, 248, .55) 18%,
        rgba(167, 139, 250, .55) 50%,
        rgba(251, 191, 36, .48) 82%,
        transparent
      );
    box-shadow: 0 0 16px rgba(104, 212, 248, .16);
  }

  .philosophy-step {
    position: relative;
    min-height: 130px;
    padding: 20px 18px 18px;
    border: 1px solid rgba(190, 220, 240, .18);
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(16, 28, 40, .94), rgba(10, 19, 29, .92));
    overflow: hidden;
  }

  .philosophy-step::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: .8;
    pointer-events: none;
  }

  .learn-step::before {
    background: radial-gradient(circle at 20% 0, rgba(104, 212, 248, .15), transparent 42%);
  }

  .build-step::before {
    background: radial-gradient(circle at 50% 0, rgba(167, 139, 250, .14), transparent 42%);
  }

  .think-step::before {
    background: radial-gradient(circle at 80% 0, rgba(251, 191, 36, .11), transparent 42%);
  }

  .philosophy-step small {
    position: relative;
    display: block;
    color: #758b9a;
    font: 800 7px/1 ui-monospace, monospace;
    letter-spacing: .18em;
  }

  .philosophy-step strong {
    position: relative;
    display: block;
    margin-top: 14px;
    color: #f2f7fa;
    font-size: clamp(1.45rem, 2.2vw, 2.1rem);
    letter-spacing: .18em;
    text-shadow: 0 0 18px rgba(104, 212, 248, .09);
  }

  .philosophy-step p {
    position: relative;
    margin: 9px 0 0;
    color: #91a5b2;
    font-size: .7rem;
    letter-spacing: .02em;
  }

  .skills-map {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 30px;
    align-items: stretch;
  }

  .skills-center {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px 24px;
    border: 1px solid rgba(105, 211, 248, .34);
    border-radius: 18px;
    background:
      radial-gradient(circle at 50% 35%, rgba(76, 201, 240, .17), transparent 48%),
      #101b25;
  }

  .skills-center > span {
    color: #6dd8ff;
    font-size: .68rem;
    letter-spacing: .2em;
  }

  .skills-center strong {
    margin: 9px 0 4px;
    color: #f4f9fc;
    font-size: 1.65rem;
    letter-spacing: -.04em;
  }

  .skills-center small {
    color: #93a7b2;
  }

  .skills-branches {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .skill-branch {
    position: relative;
    padding: 20px 22px;
    border: 1px solid rgba(190, 220, 240, .2);
    border-radius: 16px;
    background:
      linear-gradient(145deg, rgba(19, 31, 43, .94), rgba(12, 22, 32, .94));
  }

  .skill-branch::before {
    content: '';
    position: absolute;
    left: -31px;
    top: 50%;
    width: 30px;
    border-top: 1px solid #3f6071;
  }

  .branch-head {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 14px;
  }

  .branch-head > span {
    color: #66d1f8;
    font-family: monospace;
    font-size: .7rem;
  }

  .branch-head h3 {
    margin: 0;
    color: #f1f7fa;
    font-size: 1rem;
  }

  .branch-items {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .branch-items span,
  .career-tags span {
    padding: 5px 8px;
    border: 1px solid rgba(190, 220, 240, .18);
    border-radius: 999px;
    color: #becbd3;
    background: #111c26;
    font-size: .64rem;
  }

  .thought-blog-list {
    display: grid;
    gap: 12px;
  }

  .thought-blog-card {
    display: block;
    padding: 24px 26px;
    border: 1px solid rgba(190, 220, 240, .2);
    border-radius: 16px;
    background:
      linear-gradient(135deg, rgba(19, 31, 44, .97), rgba(12, 21, 31, .96));
    box-shadow: 0 10px 28px rgba(0, 0, 0, .12);
    transition: transform .18s ease, border-color .18s ease, background .18s ease;
  }

  .thought-blog-card:hover {
    transform: translateY(-2px);
    border-color: rgba(105, 211, 248, .42);
    background:
      linear-gradient(135deg, rgba(23, 40, 55, .98), rgba(14, 25, 36, .98));
  }

  .thought-blog-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    color: #92a5b0;
    font-size: .7rem;
  }

  .thought-blog-meta > span {
    color: #68d2f8;
    font-family: monospace;
  }

  .thought-blog-card h3 {
    margin: 10px 0 7px;
    color: #f1f7fa;
    font-size: 1.35rem;
    letter-spacing: -.03em;
  }

  .thought-blog-card p {
    margin: 0;
    color: #a2b2bc;
    line-height: 1.7;
  }

  .thought-blog-foot {
    margin-top: 18px;
    color: #6bd2f7;
    font-size: .72rem;
  }

  .career-timeline {
    display: grid;
    gap: 0;
    padding: 8px 0 0;
  }

  .career-item {
    display: grid;
    grid-template-columns: 34px 120px 1fr;
    gap: 20px;
    min-height: 150px;
  }

  .career-axis {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .career-dot {
    position: relative;
    z-index: 2;
    width: 11px;
    height: 11px;
    margin-top: 8px;
    border: 2px solid #7890a0;
    border-radius: 50%;
    background: #0b131c;
  }

  .career-line {
    position: absolute;
    top: 20px;
    bottom: -8px;
    width: 1px;
    background: linear-gradient(#536b79, #273641);
  }

  .career-item.active .career-dot {
    border-color: #69d7ff;
    background: #69d7ff;
    box-shadow: 0 0 18px rgba(105, 215, 255, .5);
  }

  .career-period {
    padding-top: 2px;
  }

  .career-period time {
    display: block;
    color: #e1e9ed;
    font-family: monospace;
    font-size: .78rem;
  }

  .career-period span {
    display: block;
    margin-top: 7px;
    color: #7690a0;
    font-size: .58rem;
    letter-spacing: .13em;
  }

  .career-content {
    padding: 0 0 34px;
  }

  .career-content h3 {
    margin: 0 0 8px;
    color: #f1f7fa;
    font-size: 1.25rem;
    letter-spacing: -.035em;
  }

  .career-content p {
    max-width: 720px;
    margin: 0;
    color: #9caeb8;
    line-height: 1.7;
    font-size: .84rem;
  }

  .career-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
  }

  .career-item.active .career-content {
    padding: 20px 22px 26px;
    margin: -20px 0 30px;
    border: 1px solid rgba(105, 211, 248, .42);
    border-radius: 16px;
    background:
      linear-gradient(90deg, rgba(47, 164, 207, .13), rgba(14, 25, 35, .72));
  }

  .about-grid.expanded {
    align-items: start;
  }

  .about-copy p {
    color: #a7b6bf;
    line-height: 1.8;
  }

  .disclaimer {
    margin-top: 28px;
    padding: 18px 20px;
    border: 1px solid rgba(190, 220, 240, .2);
    border-radius: 14px;
    background: #111a23;
  }

  .disclaimer strong {
    color: #e4edf1;
    font-size: .8rem;
  }

  .disclaimer p {
    margin-bottom: 0;
    color: #8fa2ad;
    font-size: .76rem;
  }

  @media (max-width: 900px) {
    .philosophy-map {
      grid-template-columns: 1fr;
    }

    .philosophy-line {
      display: none;
    }

    .skills-map {
      grid-template-columns: 1fr;
    }

    .skill-branch::before {
      display: none;
    }

    .skills-branches {
      grid-template-columns: 1fr;
    }

    .career-item {
      grid-template-columns: 30px 1fr;
      gap: 14px;
    }

    .career-period,
    .career-content {
      grid-column: 2;
    }

    .career-period {
      grid-row: 1;
    }

    .career-content {
      grid-row: 2;
      padding-bottom: 30px;
    }

    .career-axis {
      grid-row: 1 / span 2;
    }

    .career-item.active .career-content {
      margin-top: 0;
    }
  }
</style>
