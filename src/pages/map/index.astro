---
import BaseLayout from '../../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

// ページ単位のマップ。記事内の見出しが変わっても更新不要。
const domains = [
  { code: '01', title: 'AI / Machine Learning', description: '生成AI、AIシステム、古典的な機械学習をつなぐ。', path: 'topics/ai-ml/' },
  { code: '02', title: 'Data Engineering', description: '取り込みから変換、品質、運用までを見渡す。', path: 'topics/data-engineering/' },
  { code: '03', title: 'Google Cloud', description: '使い道からクラウドの製品と機能を探す。', path: 'topics/cloud/' },
  { code: '04', title: 'Snowflake', description: 'アーキテクチャ、データ活用、資格学習をたどる。', path: 'topics/snowflake/' },
  { code: '05', title: 'Engineering Tools', description: '開発やデータの仕事を支える道具を整理する。', path: 'topics/engineering/' },
];
const thoughts = [
  { code: 'T.01', title: 'Technology & Engineering', description: '何を作り、どう分け、変化に耐える形にするか。', path: 'thoughts/technology-engineering/' },
  { code: 'T.02', title: 'Work & Career', description: '仕事への向き合い方とキャリアの選び方を考える。', path: 'thoughts/work-career/' },
  { code: 'T.03', title: 'Learning & Growth', description: '学んだことをつなぎ、行動につなげていく。', path: 'thoughts/learning-growth/' },
  { code: 'T.04', title: 'Life & Interests', description: '日々の興味と、心が動くものの変化を残す。', path: 'thoughts/life-interests/' },
  { code: 'T.05', title: 'The First Beat', description: '論理、人間、芸術。考えの始まりをストックする。', path: 'thoughts/the-first-beat/' },
];
---

<BaseLayout title="Interactive Map | Seiji Tech Atlas" description="I learn. I build. I think. から10のページへ広がる Seiji Tech Atlas のマップ。">
  <main class="map-page">
    <a class="back" href={route('')}>← Back to Atlas</a>
    <header class="intro">
      <p class="eyebrow">02.5 / PERSONAL ATLAS</p>
      <h1>See how it <em>connects.</em></h1>
      <p>学ぶことと、考えること。中央から気になる枝を選び、詳しい内容はそのページで読めます。</p>
    </header>
    <div class="mind-map" aria-label="Seiji Tech Atlas のページマップ">
      <svg class="connections" viewBox="0 0 1000 860" preserveAspectRatio="none" aria-hidden="true">
        <path d="M500 430 L305 103 M500 430 L305 266 M500 430 L305 430 M500 430 L305 594 M500 430 L305 757" />
        <path d="M500 430 L695 103 M500 430 L695 266 M500 430 L695 430 M500 430 L695 594 M500 430 L695 757" />
        <circle cx="500" cy="430" r="9" />
      </svg>
      <div class="center" aria-label="I learn. I build. I think.">
        <small>SEIJI / PERSONAL ATLAS</small>
        <strong><span>I learn.</span><span><i>I build.</i></span><span>I think.</span></strong>
        <p>Learn <b>·</b> Build <b>·</b> Think</p>
      </div>
      <section class="side domains" aria-labelledby="domains-title">
        <h2 id="domains-title">Explore by domain <span>01—05</span></h2>
        <div class="nodes">
          {domains.map((item) => (
            <a class="map-card" href={route(item.path)}>
              <span class="node-meta">{item.code} / LEARN</span>
              <span class="node-title">{item.title}<span class="arrow" aria-hidden="true">↗</span></span>
              <span class="node-description">{item.description}</span>
            </a>
          ))}
        </div>
      </section>
      <section class="side thoughts" aria-labelledby="thoughts-title">
        <h2 id="thoughts-title">Thoughts in progress <span>T.01—T.05</span></h2>
        <div class="nodes">
          {thoughts.map((item) => (
            <a class="map-card" href={route(item.path)}>
              <span class="node-meta">{item.code} / THINK</span>
              <span class="node-title">{item.title}<span class="arrow" aria-hidden="true">↗</span></span>
              <span class="node-description">{item.description}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
    <p class="map-note">ページをクリックすると記事へ移動します。記事の中の項目は、それぞれのページで探せます。</p>
  </main>
</BaseLayout>

<style>
  :global(body){background:radial-gradient(circle at 50% 26%,rgba(92,171,195,.13),transparent 38%),#0a1119}
  .map-page{width:min(1400px,calc(100% - 40px));margin:auto;padding:38px 0 100px;color:#f3f8fa}
  .back{color:#9bd9ec;text-decoration:none;font-size:.82rem}.back:hover{text-decoration:underline}
  .intro{padding:60px 0 42px}.eyebrow{color:#93aebd;font:700 .69rem ui-monospace,monospace;letter-spacing:.17em}
  h1{margin:16px 0 20px;font-size:clamp(3.2rem,7vw,6.1rem);line-height:1;letter-spacing:-.065em}h1 em{color:#a5e2f1;font-style:normal}
  .intro>p:last-child{max-width:680px;color:#aabdc5;line-height:1.8}
  .mind-map{position:relative;isolation:isolate;min-height:860px;overflow:hidden;border:1px solid #364b57;border-radius:28px;background:radial-gradient(circle at center,rgba(80,154,183,.16),transparent 39%),#101c27}
  .mind-map::before{content:"";position:absolute;z-index:-1;inset:0;background-image:radial-gradient(#8ca5b2 .7px,transparent .7px);background-size:24px 24px;opacity:.15}
  .connections{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.connections path{fill:none;stroke:#607e8d;stroke-width:1.25;opacity:.65}.connections circle{fill:#a0e6f1}
  .center{position:absolute;z-index:1;top:50%;left:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;width:27%;min-height:238px;transform:translate(-50%,-50%);padding:18px;border:1px solid #92d6e8;border-radius:23px;background:radial-gradient(circle at 50% 25%,#234352,#162b38 72%);box-shadow:0 0 70px rgba(53,162,190,.15);text-align:center}
  .center small{color:#a4dbe9;font:700 .57rem ui-monospace,monospace;letter-spacing:.12em}.center strong{display:grid;gap:2px;margin:16px 0 10px;font-size:clamp(1.3rem,2.5vw,2.5rem);line-height:1.06;letter-spacing:-.045em}.center strong span{display:block}.center i{color:#9fe3f0;font-style:normal}.center p{color:#91abb9;font-size:.75rem}.center b{margin:0 4px;color:#eabf98}
  .side{position:absolute;top:0;bottom:0;width:29%;padding:22px 0}.domains{left:2%}.thoughts{right:2%}
  .side h2{display:flex;justify-content:space-between;gap:10px;align-items:baseline;margin:0 0 16px 5px;color:#aedfed;font-size:.83rem}.side h2 span{color:#778f9e;font:.66rem ui-monospace,monospace}.thoughts h2{color:#efc29c}
  .nodes{display:grid;grid-template-rows:repeat(5,1fr);gap:12px;height:calc(100% - 40px)}
  .map-card{position:relative;width:auto;display:flex;min-height:0;flex-direction:column;justify-content:center;padding:15px 17px;border:1px solid #415869;border-radius:14px;background:linear-gradient(130deg,#192c39,#14232f);color:#edf6f7;text-decoration:none;transition:transform .18s,border-color .18s,background .18s}
  .map-card:hover,.map-card:focus-visible{transform:translateY(-2px);border-color:#9cdeeb;background:#203746;outline:none}.thoughts .map-card:hover,.thoughts .map-card:focus-visible{border-color:#ecc29d}
  .node-meta{color:#9fddef;font:700 .63rem ui-monospace,monospace;letter-spacing:.13em}.thoughts .node-meta{color:#ecc19e}
  .node-title{display:flex;justify-content:space-between;gap:9px;align-items:start;margin:8px 0 5px;font-size:clamp(.9rem,1.25vw,1.08rem);font-weight:750;line-height:1.3}.arrow{flex:none;color:#9adced}.thoughts .arrow{color:#ecc19e}.node-description{color:#9eafb8;font-size:.73rem;line-height:1.5}
  .map-note{margin:19px 0 0;color:#8fa7b2;text-align:center;font-size:.77rem;line-height:1.7}
  @media(max-width:1000px){.mind-map{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;min-height:0;padding:26px}.connections{display:none}.center{position:static;grid-column:1/-1;transform:none;width:min(360px,100%);min-height:190px;margin:0 auto 9px}.center strong{font-size:2rem}.side{position:static;width:auto;padding:0}.nodes{height:auto;grid-template-rows:none}.map-card{min-height:112px}.node-title{font-size:.95rem}}
  @media(max-width:640px){.map-page{width:calc(100% - 28px)}.intro{padding:46px 0 27px}h1{font-size:clamp(2.8rem,12vw,4.4rem)}.mind-map{grid-template-columns:1fr;padding:18px;gap:24px}.center{grid-column:1;min-height:180px}.side{width:100%}.map-card{min-height:98px}.side h2{font-size:.82rem}}
</style>
