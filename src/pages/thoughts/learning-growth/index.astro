---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const updated = '2026-09-23';
const essays = [{"id": "learning-bridges", "number": "01", "title": "専門の山を深めながら、分野の間に橋を架ける。", "description": "知識をためるだけでなく、説明し、使い、次の判断につなげる。私が続けたい学び方。", "sections": [{"heading": "深く理解する面白さを、土台にする。", "paragraphs": ["研究を通じて、一つの物事を深く理解する面白さを知った。要素に分け、それぞれの性質や関係を捉え、そこから何ができるかを考える。新しく考え、自分でつくり上げ、整理していく。その過程を、今も大切にしたい。", "だから、専門を深めることは続けたい。ただ、一つの分野の知識だけを高く積むのではなく、違う領域の見方も取り入れて、自分の考え方に幅を持たせていきたい。"]}, {"heading": "学ぶ。説明する。使ってみる。", "paragraphs": ["資格や本は、知識の全体像をつかみ、抜けを見つけるために使いたい。学んだ内容を自分の言葉で説明し、実装や仕事の場面に結びつける。「知っている」から、「必要なときに使える」状態へ近づけたい。", "分野が違っても、問いの立て方や確かめ方には持ち込めるものがある。別の領域で出会った視点を試し、合わないところも確かめる。知識をつなぐこと自体ではなく、つないだ結果、自分の判断がどう変わるかを見ていきたい。"]}, {"heading": "考えを残し、経験で書き直す。", "paragraphs": ["きれいにまとめた文章を、最後の答えにはしない。使ってみた結果や、最初の見立てと違ったことも残す。何を知ったかだけでなく、何を見て考えを変えたかまで記録しておきたい。", "この場所には、本や技術から受け取ったことと、そこから自分が考えたことを分けて書く。学び方そのものを振り返りながら、次の仕事や制作に返していくためのノートにしたい。"]}]}];
const notes = [{"label": "QUESTION 01 / PURPOSE", "title": "いま、何を理解できるようになりたいのか。", "text": "読む本や学ぶ技術を増やす前に、今回の問いを一つ置く。好奇心から広げる時間と、答えを確かめる時間を分けて考える。"}, {"label": "QUESTION 02 / EXPLAIN", "title": "自分の言葉と、具体例で説明できるか。", "text": "用語を知っているだけで止まらず、何に使え、どこでは使えないかを説明する。説明できないところを、次に戻る場所にする。"}, {"label": "QUESTION 03 / USE", "title": "次の仕事や制作で、どこを変えるか。", "text": "学びを別の大型プロジェクトにせず、問いを一つ書き直す、確かめ方を一つ変えるなど、今ある活動へ小さく取り込む。"}, {"label": "QUESTION 04 / UPDATE", "title": "何を見て、最初の考えを変えたか。", "text": "当てたことだけでなく、外れた見立てや残る疑問も記録する。最初の答えを守るより、次の判断を良くするために残す。"}];
---

<BaseLayout title="Learning & Growth | Seiji Tech Atlas" description="専門の理解を深め、異なる分野をつなぎ、自分の言葉で説明し、仕事と制作に使う。学び方と考え方を更新していく、Seiji Tanimotoの学習ノート。">
 <div class="learning-growth" id="learning-growth-top">
  <a class="lg-back" href={`${route('')}#thoughts`}>← Back to Thoughts</a>
  <header class="lg-hero">
   <p class="lg-kicker">THINK / LEARNING & GROWTH</p>
   <h1>Learning<br class="lg-mobile-break" /> & Growth</h1>
   <p class="lg-hero-title">学びをつなぎ、使い、考え方を更新する。</p>
   <p class="lg-intro">専門を深く学ぶ。違う分野の見方を取り入れる。そして、自分の言葉で説明し、仕事や制作に使ってみる。何を知ったかだけでなく、どう考えが変わったかを残していきます。</p>
   <div class="lg-meta"><span>Seiji Tanimoto</span><time datetime={updated}>2026.09.23</time><span>Learn → Explain → Use</span></div>
   <nav class="lg-tabs" aria-label="Learning & Growthの目次"><a href="#reflections">Reflections <span>01</span></a><a href="#essays">Essay <span>01</span></a><a href="#notes">Notes <span>04</span></a></nav>
  </header>
  <section class="lg-section" id="reflections" aria-labelledby="reflections-heading">
   <div class="lg-section-heading"><div><p class="lg-kicker">IDEAS INTO PRACTICE</p><h2 id="reflections-heading">Reflections</h2></div><p>本や考え方を、そのまま正解にせず、自分の学びへ。</p></div>
   <a class="lg-feature" href={route('thoughts/learning-growth/issue-hypothesis-thinking/')} aria-labelledby="thinking-card-title" aria-describedby="thinking-card-description">
    <div class="lg-feature-copy"><div class="lg-feature-meta"><span>LEARNING NOTE / 内田和成の2冊から考える</span><time datetime={updated}>2026.09.23</time></div><h3 id="thinking-card-title">論点思考 × 仮説思考</h3><p class="lg-feature-subtitle">何を決めるために、何を確かめるか。</p><p id="thinking-card-description">研究と実装で育ててきた「深く理解し、つくる力」に、問いを選ぶ力を足す。私が取り入れたい6つの実践と、仕事の前に使う5行メモ。</p><div class="lg-tags"><span>問いの選び方</span><span>見立ての更新</span><span>学びと実装</span><span>6つのテンプレート</span></div><span class="lg-feature-read">この文章を読む <span aria-hidden="true">↗</span></span></div>
    <div class="lg-feature-mark" aria-hidden="true"><span>ASK.</span><span>TEST.</span><span>LEARN.</span><small>A BETTER QUESTION.<br />A BETTER NEXT STEP.</small></div>
   </a>
  </section>
  <section class="lg-section" id="essays" aria-labelledby="essays-heading">
   <div class="lg-section-heading"><div><p class="lg-kicker">HOW I WANT TO LEARN</p><h2 id="essays-heading">Essay</h2></div><p>私が続けたい、学びへの向き合い方。</p></div>
   {essays.map((essay)=><article class="lg-essay" id={essay.id} aria-labelledby={`${essay.id}-title`}><header class="lg-essay-heading"><p class="lg-kicker">ESSAY {essay.number}</p><h3 id={`${essay.id}-title`}>{essay.title}</h3><p class="lg-summary">{essay.description}</p><p class="lg-bridge">Build bridges,<br />not just towers.</p></header><div class="lg-essay-body">{essay.sections.map((section)=><section class="lg-chapter"><h4>{section.heading}</h4>{section.paragraphs.map((p)=><p>{p}</p>)}</section>)}</div></article>)}
  </section>
  <section class="lg-section" id="notes" aria-labelledby="notes-heading"><div class="lg-section-heading"><div><p class="lg-kicker">QUESTIONS TO RETURN TO</p><h2 id="notes-heading">Notes</h2></div><p>学ぶ前と、使った後に立ち返る四つの問い。</p></div><div class="lg-notes">{notes.map((note)=><article class="lg-note"><p class="lg-kicker">{note.label}</p><h3>{note.title}</h3><p>{note.text}</p></article>)}</div></section>
  <aside class="lg-connection" aria-label="仕事とキャリアへのつながり"><p class="lg-kicker">FROM LEARNING TO WORK</p><h2>学び方の先に、働き方を考える。</h2><p>思考・実行・信頼の全体像や、FDEを含む将来の方向性は、Work & Careerにまとめています。学び方と仕事の選び方を、行き来しながら考えていきます。</p><a class="lg-text-link" href={route('thoughts/work-career/')}>Work & Careerへ ↗</a></aside>
  <footer class="lg-page-footer"><p>2026年9月時点の考えです。学び、試し、説明する中で、少しずつ書き足していきます。</p><a class="lg-text-link" href="#learning-growth-top">ページの先頭へ ↑</a></footer>
 </div>
</BaseLayout>

<style is:global>
.learning-growth {
  --lg-accent: #e8c58e;
  width: min(1080px, calc(100% - 40px));
  margin-inline: auto;
  padding: 36px 0 84px;
  overflow-wrap: anywhere;
}
.learning-growth :is(h1, h2, h3, h4, p) { margin: 0; }
.learning-growth :is(section[id], article[id]), .learning-growth[id] { scroll-margin-top: 155px; }
.learning-growth a { border-radius: 5px; }
.learning-growth a:focus-visible { outline: 3px solid #6ad9e8; outline-offset: 5px; }
.lg-back { display: inline-flex; align-items: center; min-height: 44px; color: #a8b7c3; font-size: .875rem; }
.lg-back:hover, .lg-text-link:hover { color: #fff; text-decoration: underline; text-underline-offset: 5px; }
.lg-hero { padding: 66px 0 42px; border-bottom: 1px solid var(--line); }
.learning-growth .lg-kicker { color: var(--lg-accent); font: 700 .75rem/1.6 ui-monospace, monospace; letter-spacing: .12em; }
.learning-growth h1 { margin: 16px 0 30px; color: #f2f7fa; font-size: clamp(2.9rem, 7vw, 5.6rem); line-height: 1.08; letter-spacing: -.055em; }
.learning-growth .lg-hero-title { max-width: 800px; color: #e5eaf3; font-size: clamp(1.2rem, 2.8vw, 1.6rem); line-height: 1.75; font-weight: 650; }
.learning-growth .lg-intro { max-width: 740px; margin-top: 18px; color: #b5c3d0; font-size: 1rem; line-height: 1.95; }
.lg-meta { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 25px; color: #9bafbf; font-size: .8125rem; }
.lg-tabs { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.lg-tabs a { display: inline-flex; align-items: center; gap: 18px; min-height: 46px; padding: 10px 18px; border: 1px solid rgba(216,176,114,.35); border-radius: 10px; background: rgba(216,176,114,.055); font-size: .95rem; }
.lg-tabs a:hover { border-color: var(--lg-accent); background: rgba(216,176,114,.12); }
.lg-tabs span { color: var(--lg-accent); font: 600 .75rem/1 ui-monospace, monospace; }
.lg-section { margin-top: 58px; }
.lg-section-heading { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 25px; }
.lg-section-heading h2 { margin-top: 6px; font-size: 2rem; line-height: 1.3; letter-spacing: -.025em; }
.lg-section-heading > p { max-width: 420px; color: #a8b7c3; font-size: .9375rem; line-height: 1.8; }
.lg-essay-index, .lg-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.learning-growth .lg-essay-card { display: flex; flex-direction: column; padding: 28px; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(145deg, rgba(23,33,51,.95), rgba(11,21,31,.9)); }
.lg-essay-card:hover { border-color: rgba(192,177,245,.65); background: #172333; }
.lg-card-number { color: var(--lg-accent); font: 700 .75rem/1.5 ui-monospace, monospace; letter-spacing: .1em; }
.lg-essay-card h3 { margin-top: 20px; font-size: 1.25rem; line-height: 1.65; }
.lg-essay-card p { margin: 14px 0 26px; color: #b5c3d0; font-size: .9375rem; line-height: 1.9; }
.lg-read { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; color: var(--lg-accent); font-size: .875rem; }
.lg-essay { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.8fr); gap: 44px; margin-top: 62px; padding: 46px 0 16px; border-top: 1px solid var(--line); }
.lg-essay-heading h3 { margin-top: 16px; font-size: clamp(1.35rem, 2.2vw, 1.7rem); line-height: 1.65; letter-spacing: .01em; }
.learning-growth .lg-summary { margin-top: 20px; color: #9fb1c2; font-size: .9375rem; line-height: 1.95; }
.lg-essay-body { min-width: 0; }
.lg-chapter + .lg-chapter { margin-top: 38px; }
.lg-chapter h4 { padding-left: 14px; border-left: 2px solid var(--lg-accent); color: #eaf1f8; font-size: 1.1rem; line-height: 1.85; font-weight: 650; }
.lg-chapter p { margin-top: 18px; color: #c1ccd6; font-size: 1rem; line-height: 2.05; letter-spacing: .025em; }
.lg-text-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--lg-accent); font-size: .875rem; line-height: 1.6; }
.lg-essay-body > .lg-text-link { margin-top: 26px; }
.lg-note { min-width: 0; padding: 26px; border: 1px solid var(--line); border-radius: 14px; background: rgba(18,29,41,.75); }
.lg-note h3 { margin: 14px 0; color: #e6edf6; font-size: 1.0625rem; line-height: 1.8; }
.lg-note > p:last-child { color: #b5c3d0; font-size: .9375rem; line-height: 1.95; }
.lg-page-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-top: 52px; padding-top: 24px; border-top: 1px solid var(--line); }
.lg-page-footer p { max-width: 690px; color: #9bafbf; font-size: .8125rem; line-height: 1.85; }
@media (max-width: 760px) {
  .learning-growth { width: calc(100% - 36px); padding-top: 22px; }
  .lg-hero { padding-top: 42px; }
  .lg-essay-index, .lg-notes, .lg-essay { grid-template-columns: minmax(0, 1fr); }
  .lg-essay { gap: 32px; margin-top: 46px; padding-top: 32px; }
  .lg-essay-card, .lg-note { padding: 24px; }
  .lg-section { margin-top: 44px; }
  .lg-essay-heading { max-width: 600px; }
  .learning-growth :is(section[id], article[id]), .learning-growth[id] { scroll-margin-top: 175px; }
}
@media (prefers-reduced-motion: reduce) { html:has(.learning-growth) { scroll-behavior: auto; } }


.learning-growth { --lg-accent:#e8c58e; }
.learning-growth .lg-mobile-break { display:none; }
.learning-growth .lg-hero h1 { font-size:clamp(2.6rem,7vw,5.2rem); line-height:1.18; }
.learning-growth .lg-feature { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(0,.7fr); border:1px solid #6c5940; border-radius:17px; overflow:hidden; text-decoration:none; background:linear-gradient(135deg,#21252a,#111d29); }
.learning-growth .lg-feature:hover { border-color:var(--lg-accent); background:#222931; }
.learning-growth .lg-feature-copy { padding:32px; }
.learning-growth .lg-feature-meta { display:flex; flex-wrap:wrap; gap:12px 20px; justify-content:space-between; color:#cbb798; font:.66rem/1.8 ui-monospace,monospace; letter-spacing:.05em; }
.learning-growth .lg-feature h3 { margin-top:22px; color:#f1e9dc; font-size:clamp(1.55rem,3.5vw,2rem); line-height:1.65; }
.learning-growth .lg-feature-subtitle { margin-top:12px; color:#e0cfb4; font-size:1.08rem; line-height:1.8; }
.learning-growth .lg-feature #thinking-card-description { margin-top:15px; color:#b7c7d3; font-size:.96rem; line-height:1.95; }
.learning-growth .lg-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:21px; }
.learning-growth .lg-tags span { padding:6px 9px; border:1px solid #544c40; border-radius:6px; color:#d1c1a8; font-size:.73rem; line-height:1.7; }
.learning-growth .lg-feature-read { display:flex; justify-content:space-between; margin-top:26px; color:var(--lg-accent); font-size:.9rem; }
.learning-growth .lg-feature-mark { display:flex; flex-direction:column; justify-content:center; align-items:flex-start; padding:30px; border-left:1px solid #61523f; background:radial-gradient(ellipse at 15% 20%,#80633326,transparent 80%); }
.learning-growth .lg-feature-mark>span { display:block; color:#dbbd8f; font-size:clamp(2rem,4.6vw,3.1rem); line-height:1.13; letter-spacing:-.055em; font-weight:750; }
.learning-growth .lg-feature-mark small { color:#aeb4b3; margin-top:27px; font:.61rem/1.9 ui-monospace,monospace; letter-spacing:.055em; }
.learning-growth .lg-essay { margin-top:0; padding-top:30px; }
.learning-growth .lg-bridge { margin-top:25px; color:#c7b393; font:500 1.2rem/1.6 ui-monospace,monospace; letter-spacing:-.03em; }
.learning-growth .lg-connection { margin-top:50px; padding:26px; border:1px solid #575249; border-radius:12px; background:#141f2a; }
.learning-growth .lg-connection h2 { margin-top:12px; font-size:1.3rem; line-height:1.75; color:#e6e6e2; }
.learning-growth .lg-connection>p:not(.lg-kicker) { margin-top:15px; color:#b5c6d1; line-height:1.95; }
.learning-growth .lg-connection>a { margin-top:16px; }
@media(max-width:760px) { .learning-growth .lg-feature { grid-template-columns:minmax(0,1fr); } .learning-growth .lg-feature-copy { padding:24px; } .learning-growth .lg-feature-mark { display:none; } .learning-growth .lg-hero h1 { font-size:clamp(2.6rem,9.3vw,4.4rem); } }
@media(max-width:500px) { .learning-growth .lg-mobile-break { display:block; } .learning-growth .lg-hero h1 { line-height:1.22; } }

</style>
