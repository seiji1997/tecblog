<script is:inline>
(() => {
  const KEY = '__seijiIssueThinkingV1';
  if (window[KEY]) { window[KEY].init(); return; }
  let cleanups = [];
  function dispose() { cleanups.splice(0).forEach((fn) => fn()); }
  function init() {
    dispose();
    const root = document.querySelector('[data-thinking-page]');
    if (!root) return;
    const status = root.querySelector('#thinking-status');
    let timer;
    const report = (text) => { clearTimeout(timer); status.textContent = text; timer = setTimeout(() => { status.textContent = ''; }, 7000); };
    const selectText = (node) => { const r = document.createRange(); r.selectNodeContents(node); const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(r); node.focus({preventScroll:true}); };
    root.querySelectorAll('[data-thinking-js]').forEach((el) => { el.hidden = false; });
    const onClick = async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target && target.closest('[data-thinking-copy]');
      if (button) {
        const node = document.getElementById(button.dataset.thinkingCopy);
        if (!node) return;
        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(node.textContent || '');
          report('コピーしました。ご自身の管理環境で使ってください。');
        } catch (_) {
          selectText(node);
          report('自動コピーできませんでした。選択したテキストを Ctrl+C / ⌘C でコピーしてください。');
        }
      }
      const anchor = target && target.closest('a[href^="#"]');
      if (anchor) {
        const href = anchor.getAttribute('href');
        if (href && href === window.location.hash) revealHash(true);
      }
    };
    function revealHash(focus = false) {
      let id; try { id = decodeURIComponent(window.location.hash.slice(1)); } catch (_) { return; }
      if (!id) return;
      const node = document.getElementById(id);
      if (!node || !root.contains(node)) return;
      let p = node;
      while (p && p !== root) { if (p instanceof HTMLDetailsElement) p.open = true; p = p.parentElement; }
      requestAnimationFrame(() => {
        node.scrollIntoView({block:'start',behavior:'instant'});
        if (focus) {
          const el = node instanceof HTMLDetailsElement ? node.querySelector('summary') : node;
          if (el) { if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex','-1'); el.focus({preventScroll:true}); }
        }
      });
    }
    const onHash = () => revealHash(true);
    root.addEventListener('click',onClick);
    window.addEventListener('hashchange',onHash);
    const links = Array.from(root.querySelectorAll('[data-thinking-toc]'));
    let observer;
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a,b) => a.boundingClientRect.top-b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((link) => { if (link.hash === '#' + visible.target.id) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
      }, {rootMargin:'-130px 0px -55% 0px',threshold:0});
      root.querySelectorAll('.ih-chapter[id]').forEach((s) => observer.observe(s));
    }
    revealHash();
    cleanups.push(() => { clearTimeout(timer); root.removeEventListener('click',onClick); window.removeEventListener('hashchange',onHash); if(observer) observer.disconnect(); });
  }
  window[KEY] = {init,dispose};
  document.addEventListener('astro:page-load',init);
  document.addEventListener('astro:before-swap',dispose);
  init();
})();
</script>
