  .reading{height:min(76vh,920px);min-height:610px;overflow-y:auto;overscroll-behavior:contain;scrollbar-color:#53717b #17252e;border:1px solid #40515a;border-radius:19px;background:radial-gradient(circle at 87% 5%,rgba(236,164,112,.08),transparent 36%),#14212a}.panel{display:none;padding:clamp(26px,4.3vw,65px)}.tab-input[id="select-logic-and-people"]:checked ~ .reading #panel-logic-and-people,.tab-input[id="select-inherited-stories"]:checked ~ .reading #panel-inherited-stories,.tab-input[id="select-contemporary-art"]:checked ~ .reading #panel-contemporary-art,.tab-input[id="select-beauty-and-use"]:checked ~ .reading #panel-beauty-and-use,.tab-input[id="select-deep-work"]:checked ~ .reading #panel-deep-work{display:block}.panel-meta{display:flex;justify-content:space-between;gap:12px;color:#efae83;font:700 .68rem ui-monospace,monospace;letter-spacing:.13em}.panel-meta span{color:#678d9c}.panel h2{margin:27px 0 24px;color:#f2f7f7;font-size:clamp(2rem,3.8vw,3.35rem);line-height:1.23;letter-spacing:-.055em}.panel .lead{color:#e2e7e7;font-size:1.13rem;line-height:1.9}.panel p{margin:25px 0;color:#b9c8cd;font-size:.97rem;line-height:2.08}.panel strong{color:#f2eee9}.callout{display:grid;gap:10px;margin:34px 0;padding:23px 27px;border-left:3px solid #eca879;background:#273038}.callout span{color:#e5a97f;font:700 .65rem ui-monospace,monospace;letter-spacing:.13em}.callout strong{font-size:1.1rem;line-height:1.6}.ending{margin-top:46px;padding-top:23px;border-top:1px solid #49606a;color:#f0bb99;font-size:1.1rem;font-weight:700;line-height:1.8}
