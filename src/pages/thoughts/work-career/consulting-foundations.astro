.wcf-page h1 { margin:24px 0 28px; color:#f2f7fa; font-size:clamp(3rem,6.4vw,5.2rem); line-height:1.04; letter-spacing:-.065em; font-weight:780; }
.wcf-page h1 em { font-style:normal; color:var(--wcf-accent); -webkit-text-stroke:0; }
.wcf-page .wcf-subtitle { font-size:clamp(1.14rem,2vw,1.5rem); font-weight:650; line-height:1.8; color:#e0eaf1; }
.wcf-page .wcf-lead { margin-top:17px; color:#bdcad6; font-size:1rem; line-height:1.95; }
.wcf-meta { display:flex; flex-wrap:wrap; gap:8px 16px; margin-top:24px; color:#9dafbf; font-size:.72rem; line-height:1.7; }
.wcf-meta span:last-child { font-family:ui-monospace,monospace; letter-spacing:.04em; }
.wcf-hero-links { display:flex; flex-wrap:wrap; gap:8px 19px; margin-top:25px; }
.wcf-hero-links a { display:inline-flex; min-height:44px; align-items:center; gap:15px; text-decoration:none; font-size:.86rem; font-weight:650; }
.wcf-hero-links a:hover { text-decoration:underline; }
.wcf-hero-note { border:1px solid rgba(158,219,234,.31); padding:31px; border-radius:18px; background:radial-gradient(ellipse at 95% 0,rgba(121,185,221,.15),transparent 70%),linear-gradient(140deg,#162638,#101c29); }
.wcf-page .wcf-hero-note > p { margin-top:24px; color:#c0cedb; font-size:clamp(.95rem,1.8vw,1.12rem); line-height:2; }
.wcf-hero-note p strong { display:block; margin-top:13px; color:#e7f4f8; font-size:clamp(1.3rem,2.3vw,1.6rem); font-weight:650; line-height:1.9; }
.wcf-note-words { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:24px; padding-top:21px; border-top:1px solid var(--wcf-line); }
.wcf-note-words > span { font:700 .92rem/1.6 ui-monospace,monospace; color:#aee1ed; }
.wcf-note-words small { display:block; margin-top:6px; font:400 .74rem/1.7 system-ui,sans-serif; color:#b2c1cf; }
.wcf-note-caption { display:block; margin-top:20px; color:#9eafbf; font-size:.69rem; line-height:1.8; }
.wcf-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:22px 0; border-block:1px solid var(--wcf-line); }
.wcf-stats > div { display:flex; align-items:baseline; gap:13px; padding:5px 24px; border-left:1px solid var(--wcf-line); }
.wcf-stats > div:first-child { padding-left:0; border:0; }
.wcf-stats strong { color:#e7f2f7; font:500 2rem/1.3 ui-monospace,monospace; letter-spacing:-.05em; }
.wcf-stats span { color:#b4c4d0; font-size:.78rem; line-height:1.8; }
.wcf-scope { margin-top:28px; padding:23px 26px; border-left:2px solid var(--wcf-lavender); background:rgba(166,149,229,.055); border-radius:0 10px 10px 0; }
.wcf-scope strong { color:#e2dcf6; font-size:.94rem; line-height:1.9; }
.wcf-page .wcf-scope p { color:#b6c3d0; font-size:.86rem; line-height:1.95; margin-top:8px; }
.wcf-scope a { display:inline-flex; align-items:center; min-height:38px; font-size:.8rem; color:#cfc3f7; }
.wcf-reading-layout { display:grid; grid-template-columns:206px minmax(0,1fr); gap:48px; margin-top:58px; align-items:start; }
.wcf-sidebar { position:sticky; top:146px; min-width:0; }
.wcf-toc { border:1px solid var(--wcf-line); border-radius:12px; background:#101c28; }
.wcf-toc > summary { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:15px; color:#d1ddea; font:700 .69rem/1.7 ui-monospace,monospace; letter-spacing:.06em; }
.wcf-toc > summary span { color:#a1b4c2; font:400 .69rem/1.6 system-ui,sans-serif; }
.wcf-toc nav { max-height:calc(100vh - 280px); overflow:auto; padding:3px 9px 12px; scrollbar-width:thin; }
.wcf-toc nav a { display:flex; align-items:center; gap:10px; min-height:37px; padding:7px 7px; border-radius:5px; color:#aebfcd; text-decoration:none; font-size:.76rem; line-height:1.65; }
.wcf-toc nav a > span { color:#839cb1; font:.65rem/1.5 ui-monospace,monospace; }
.wcf-toc nav a:hover,.wcf-toc nav a[aria-current="location"] { color:#ddf3f8; background:rgba(139,207,225,.095); }
.wcf-sidebar-back { display:inline-flex; align-items:center; min-height:44px; margin-top:13px; font-size:.76rem; }
.wcf-content { min-width:0; }
.wcf-introduction { padding:0 0 34px; }
.wcf-chapter { margin-top:60px; padding-top:34px; border-top:1px solid var(--wcf-line); min-width:0; }
.wcf-chapter:first-of-type { margin-top:10px; }
.wcf-chapter-heading { margin-bottom:26px; }
.wcf-chapter-heading h2, .wcf-closing h2 { margin-top:10px; color:#e9f2f7; font-size:clamp(1.45rem,2.5vw,1.85rem); line-height:1.7; letter-spacing:-.025em; }
.wcf-chapter-heading > p { margin-top:12px; color:#aebdcc; font-size:.92rem; line-height:1.9; }
.wcf-prose { color:#c1cdd8; font-size:1rem; line-height:2.03; letter-spacing:.012em; }
.wcf-prose p + p, .wcf-prose div + p, .wcf-prose table + p { margin-top:20px; }
.wcf-prose strong { color:#e3edf4; font-weight:650; }
.wcf-prose h3 { margin:35px 0 16px; padding-left:14px; border-left:2px solid var(--wcf-accent); color:#e4eff7; font-size:1.13rem; line-height:1.85; font-weight:650; }
.wcf-prose h3:first-child { margin-top:0; }
.wcf-prose blockquote { margin:22px 0; padding:17px 21px; border-left:2px solid var(--wcf-lavender); background:rgba(167,145,217,.06); color:#ddd8ec; border-radius:0 9px 9px 0; }
.wcf-prose ul, .wcf-prose ol { padding-left:1.5em; }
.wcf-prose li { padding-block:3px; }
.wcf-prose code { font-size:.86em; background:rgba(151,178,204,.09); padding:2px 6px; border-radius:4px; white-space:normal; overflow-wrap:anywhere; }
.wcf-prose hr { border:0; border-top:1px solid var(--wcf-line); margin:28px 0; }
.wcf-citation { display:inline; font-size:.74rem; letter-spacing:0; text-decoration:none; color:#99d0e0 !important; margin-inline:2px; }
.wcf-citation:hover { text-decoration:underline; }
.wcf-table-wrap { max-width:100%; overflow-x:auto; margin:22px 0; border:1px solid var(--wcf-line); border-radius:10px; scrollbar-width:thin; background:#0f1b28; }
.wcf-table-wrap table { border-collapse:collapse; width:100%; min-width:630px; margin:0; text-align:left; table-layout:auto; }
.wcf-table-wrap caption { position:absolute; clip-path:inset(50%); width:1px; height:1px; overflow:hidden; }
.wcf-table-wrap th, .wcf-table-wrap td { padding:14px 17px; border-bottom:1px solid var(--wcf-line); font-size:.85rem; font-weight:400; line-height:1.9; vertical-align:top; color:#bbcbd7; }
.wcf-table-wrap thead th { color:#d9eaf3; background:rgba(125,185,214,.095); font-size:.78rem; font-weight:650; }
.wcf-table-wrap tbody th { min-width:132px; color:#dae7ef; font-weight:600; background:rgba(140,184,211,.025); }
.wcf-table-wrap tr:last-child > * { border-bottom:0; }
.wcf-table-wrap th:first-child { width:21%; }
.wcf-capability-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:13px; margin:24px 0; }
.wcf-capability { min-width:0; padding:19px; border:1px solid var(--wcf-line); border-radius:12px; background:linear-gradient(140deg,#132332,#0f1c28); }
.wcf-cap-number { color:var(--wcf-accent); font:600 .77rem/1.7 ui-monospace,monospace; }
.wcf-prose .wcf-capability h3 { border:0; padding:0; margin:14px 0 12px; color:#e2edf4; font-size:1rem; line-height:1.75; }
.wcf-capability > p { color:#b9c8d4; font-size:.85rem; line-height:1.9; }
.wcf-capability dl { border-top:1px solid var(--wcf-line); margin-top:16px; padding-top:12px; }
.wcf-capability dt { color:#8ed0e1; font-size:.69rem; line-height:1.9; margin-top:8px; }
.wcf-capability dd { margin-top:5px; color:#b8c9d5; font-size:.8rem; line-height:1.95; }
.wcf-template { position:relative; margin:20px 0 26px; padding:14px; background:#0b1622; border:1px solid var(--wcf-line); border-radius:12px; }
.wcf-template pre { margin:0; padding:14px 8px; overflow:auto; color:#d6e7ef; font:400 .83rem/2 ui-monospace,monospace; white-space:pre-wrap; overflow-wrap:anywhere; }
.wcf-template pre code { padding:0; background:none; font:inherit; white-space:pre-wrap; }
.wcf-copy, .wcf-link-copy { display:block; border:1px solid rgba(143,210,228,.32); background:rgba(105,177,198,.09); color:#b7e4ed; border-radius:7px; padding:10px 13px; min-height:42px; font-size:.77rem !important; text-align:left; }
.wcf-copy { margin-left:auto; }
.wcf-copy:hover, .wcf-link-copy:hover { background:rgba(105,177,198,.18); }
.wcf-closing { margin-top:55px; padding:29px; border:1px solid rgba(164,205,190,.3); border-radius:15px; background:linear-gradient(130deg,#18282d,#111e29); }
.wcf-closing .wcf-eyebrow { color:#b4d8c8; }
.wcf-closing h2 { margin:14px 0 22px; font-size:1.45rem; }
.wcf-closing .wcf-prose { font-size:.95rem; }
.wcf-category-map { margin:24px 0; border:1px solid var(--wcf-line); border-radius:10px; }
.wcf-category-map > summary { min-height:50px; padding:14px 17px; display:flex; justify-content:space-between; gap:14px; font-size:.85rem; color:#c7dce6; }
.wcf-category-map nav { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; padding:0 13px 15px; }
.wcf-category-map nav a { display:flex; align-items:center; gap:10px; padding:10px; min-height:45px; font-size:.77rem; line-height:1.7; text-decoration:none; color:#bed1dd; background:#11202d; border-radius:6px; }
.wcf-category-map nav a > span { color:var(--wcf-accent); font:600 .82rem/1 ui-monospace,monospace; }
.wcf-category-map nav small { margin-left:auto; color:#94aebf; }
.wcf-search-tools { margin:26px 0 21px; padding:22px; border:1px solid rgba(145,211,230,.32); background:#12212f; border-radius:13px; }
.wcf-search-row { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); gap:14px; }
.wcf-search-tools label { display:block; min-width:0; font-size:.76rem; line-height:1.7; color:#b8ccd9; }
.wcf-search-tools input, .wcf-search-tools select { display:block; width:100%; min-height:47px; margin-top:8px; padding:11px 12px; border:1px solid #4e697d; border-radius:7px; background:#0a1723; color:#e5edf5; font-size:.87rem; color-scheme:dark; }
.wcf-search-tools input::placeholder { color:#91a5b7; }
.wcf-search-tools #wcf-search-help { color:#9eb5c5; font-size:.72rem; margin-top:12px; line-height:1.8; }
.wcf-filter-row { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; margin-top:17px; }
.wcf-mode { display:flex; flex-wrap:wrap; gap:7px; }
.wcf-mode button, .wcf-reset, .wcf-empty button { min-height:42px; border:1px solid #445e72; border-radius:6px; padding:9px 13px; background:#152737; color:#c3d9e5; font-size:.79rem !important; }
.wcf-mode button[aria-pressed="true"] { background:#245265; border-color:#83c8db; color:#eefaff; }
.wcf-mode button:hover, .wcf-reset:hover, .wcf-empty button:hover { border-color:#8bd0e0; }
.wcf-reset { border-color:transparent; background:transparent; color:#aac5d4; text-decoration:underline; text-underline-offset:4px; }
.wcf-result-row { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px; margin-top:18px; padding-top:14px; border-top:1px solid var(--wcf-line); }
.wcf-result-row > p { color:#c1deea; font-size:.8rem; font-variant-numeric:tabular-nums; }
.wcf-expand-actions { display:flex; flex-wrap:wrap; gap:10px; }
.wcf-expand-actions button { background:transparent; border:0; min-height:36px; padding:6px 0; color:#b9c8db; text-decoration:underline; text-underline-offset:4px; font-size:.73rem !important; }
.wcf-nojs, .wcf-empty { padding:20px; background:#152331; border-radius:10px; margin-block:20px; font-size:.87rem; line-height:1.95; }
.wcf-empty p { margin:9px 0 16px; color:#b6c8d6; }
.wcf-category { margin:14px 0; border:1px solid var(--wcf-line); border-radius:12px; background:#101c28; }
.wcf-category > summary { padding:19px; display:flex; align-items:center; gap:15px; }
.wcf-category-id { color:var(--wcf-accent); font:500 1.65rem/1.2 ui-monospace,monospace; }
.wcf-category > summary > span:nth-child(2) { flex:1; min-width:0; }
.wcf-category > summary strong { font-size:1rem; line-height:1.8; color:#e1edf5; }
.wcf-category > summary small { display:block; margin-top:5px; color:#a0b6c7; font-size:.76rem; line-height:1.8; }
.wcf-category-count { min-width:29px; color:#bfd9e7; font:500 .84rem/1.5 ui-monospace,monospace; text-align:right; }
.wcf-plus { color:#91c6d7; font:400 1.45rem/1 ui-monospace,monospace; flex-shrink:0; align-self:center; }
.wcf-page details[open] > summary > .wcf-plus { transform:rotate(45deg); }
.wcf-category-body { border-top:1px solid var(--wcf-line); padding:15px; }
.wcf-page .wcf-category-refs { color:#99adbe; font-size:.7rem; line-height:1.9; margin:0 3px 14px; }
.wcf-terms { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); align-items:start; gap:11px; }
.wcf-term { min-width:0; border:1px solid rgba(154,188,213,.19); border-radius:9px; background:#132333; }
.wcf-term > summary { display:flex; align-items:start; gap:15px; padding:17px; }
.wcf-term-heading { display:block; flex:1; min-width:0; }
.wcf-term-meta { display:flex; align-items:center; flex-wrap:wrap; gap:6px 10px; margin-bottom:10px; color:#94aec2; font:500 .66rem/1.8 ui-monospace,monospace; }
.wcf-starter-badge { padding:1px 6px; color:#d2c6f5; border:1px solid rgba(184,162,230,.33); border-radius:4px; font:500 .64rem/1.8 system-ui,sans-serif; }
.wcf-term summary strong { display:block; color:#e5f0f5; font-size:.98rem; line-height:1.75; }
.wcf-term-en { display:block; margin-top:4px; color:#9ecadc; font-size:.76rem; line-height:1.75; }
.wcf-term-preview { display:block; margin-top:12px; color:#b9c9d5; font-size:.81rem; line-height:1.95; }
.wcf-term[open] { border-color:rgba(144,211,230,.48); background:#132635; }
.wcf-term[open] .wcf-term-preview { display:none; }
.wcf-term-body { padding:0 17px 18px; }
.wcf-term-body dl { padding-top:15px; border-top:1px solid var(--wcf-line); }
.wcf-term-body dt { margin-top:16px; color:#9bd5e5; font-size:.72rem; line-height:1.7; font-weight:650; }
.wcf-term-body dt:first-child { margin-top:0; }
.wcf-term-body dd { margin-top:7px; color:#c1d1dc; font-size:.85rem; line-height:1.95; }
.wcf-term-body .wcf-pitfall { color:#dbc9b2; padding:9px 11px; border-left:2px solid #ad9064; background:rgba(148,117,71,.075); }
.wcf-aliases { margin-top:19px; color:#aabccd; font-size:.73rem; line-height:1.8; }
.wcf-aliases > span { display:block; color:#91bfce; font-size:.68rem; margin-bottom:5px; }
.wcf-aliases small { display:block; color:#91a8ba; font-size:.66rem; margin-top:5px; }
.wcf-related, .wcf-term-reference { border-top:1px solid var(--wcf-line); margin-top:18px; padding-top:14px; }
.wcf-related h5, .wcf-term-reference h5 { font-size:.7rem; color:#b8cddb; font-weight:600; line-height:1.8; }
.wcf-related > div { display:flex; flex-wrap:wrap; gap:5px 11px; margin-top:8px; }
.wcf-related a { display:inline-flex; align-items:center; min-height:32px; font-size:.75rem; line-height:1.7; }
.wcf-reference-links { display:flex; flex-wrap:wrap; gap:5px 8px; margin-top:9px; }
.wcf-reference-links .wcf-citation { font-size:.69rem; line-height:1.9; }
.wcf-term-reference p { margin-top:9px; color:#9ab0c1; font-size:.72rem; line-height:1.9; }
.wcf-term-reference .wcf-source-context { color:#94aabd; font-size:.66rem; }
.wcf-link-copy { margin-top:17px; font-size:.69rem !important; min-height:40px; width:100%; }
.wcf-glossary-footnote { color:#9db2c3; font-size:.76rem; line-height:1.95; margin-top:22px !important; }
.wcf-source-list { display:grid; gap:10px; margin-top:26px; }
.wcf-source { border:1px solid var(--wcf-line); border-radius:10px; background:#101e2a; }
.wcf-source > summary { display:flex; align-items:center; gap:14px; padding:17px; }
.wcf-source > summary > span:nth-child(2) { min-width:0; flex:1; }
.wcf-source > summary strong { display:block; color:#ccdde8; font-size:.88rem; line-height:1.8; font-weight:550; }
.wcf-source > summary small { display:block; margin-top:7px; color:#92adbf; font-size:.71rem; line-height:1.8; }
.wcf-source-id { color:#96cbdf; font:600 .72rem/1.6 ui-monospace,monospace; }
.wcf-source-body { padding:0 19px 19px; }
.wcf-source-body dl { border-top:1px solid var(--wcf-line); padding-top:17px; display:grid; grid-template-columns:115px minmax(0,1fr); gap:11px 17px; }
.wcf-source-body dt { color:#95becf; font-size:.73rem; line-height:1.9; }
.wcf-source-body dd { color:#bfceda; font-size:.83rem; line-height:1.95; }
.wcf-source-link { display:inline-flex; align-items:center; min-height:44px; margin-top:15px; font-size:.81rem; gap:18px; }
.wcf-muted { color:#8da8bb; font-size:.72rem; }
.wcf-page :is(.wcf-term,.wcf-source,.wcf-category):target { outline:2px solid var(--wcf-accent); outline-offset:4px; }
.wcf-footer { margin-top:58px; padding-top:27px; border-top:1px solid var(--wcf-line); }
.wcf-footer p { color:#a8bdcc; font-size:.83rem; line-height:1.95; }
.wcf-footer nav { display:flex; flex-wrap:wrap; gap:7px 23px; margin-top:20px; }
.wcf-footer a { display:inline-flex; min-height:44px; align-items:center; font-size:.78rem; }
.wcf-announcement { position:fixed; bottom:22px; left:50%; transform:translateX(-50%); z-index:200; max-width:calc(100% - 32px); border-radius:9px; background:#203a4b; color:#edf8ff; box-shadow:0 8px 35px #0008; font-size:.86rem; line-height:1.8; }
.wcf-announcement:not(:empty) { padding:12px 20px; border:1px solid #77b4ca; }
@media (max-width:1050px) { .wcf-hero { gap:26px; } .wcf-hero-note { padding:24px; } .wcf-reading-layout { grid-template-columns:183px minmax(0,1fr); gap:30px; } .wcf-capability-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .wcf-stats > div { padding:5px 14px; } .wcf-stats strong { font-size:1.7rem; } .wcf-terms { grid-template-columns:minmax(0,1fr); } }
@media (max-width:780px) { .wcf-page { width:calc(100% - 36px); padding-top:22px; } .wcf-hero { grid-template-columns:minmax(0,1fr); padding:39px 0 30px; gap:27px; } .wcf-page h1 { font-size:clamp(3.1rem,9vw,4.5rem); } .wcf-hero-note { max-width:620px; } .wcf-hero-note p br { display:none; } .wcf-hero-note p strong { display:block; } .wcf-hero-note p strong br { display:inline; } .wcf-stats { grid-template-columns:repeat(2,minmax(0,1fr)); gap:15px 0; } .wcf-stats > div { padding:5px 16px; } .wcf-stats > div:nth-child(3) { padding-left:0; border:0; } .wcf-reading-layout { display:block; margin-top:35px; } .wcf-sidebar { position:static; margin-bottom:35px; } .wcf-toc nav { max-height:none; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3px; } .wcf-sidebar-back { display:none; } .wcf-toc nav a { min-height:42px; } .wcf-search-row { grid-template-columns:minmax(0,1fr); } .wcf-category-map nav { grid-template-columns:minmax(0,1fr); } .wcf-terms { grid-template-columns:repeat(2,minmax(0,1fr)); } .wcf-chapter { margin-top:46px; padding-top:27px; } }
