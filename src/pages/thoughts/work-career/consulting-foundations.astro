.wcf-category[data-visible-count="1"] .wcf-terms { grid-template-columns:minmax(0,1fr); }

</style>

<script is:inline>
(() => {
  const initialize = () => {
    const root = document.querySelector('[data-wcf-root]');
    if (!root || root.dataset.wcfReady) return;
    root.dataset.wcfReady = 'true';
    const abort = new AbortController();
    const signal = abort.signal;
    const input = root.querySelector('#wcf-search');
    const category = root.querySelector('#wcf-category');
    const results = root.querySelector('#wcf-results');
    const empty = root.querySelector('#wcf-empty');
    const announcement = root.querySelector('#wcf-announcement');
    const terms = [...root.querySelectorAll('[data-wcf-term]')];
    const groups = [...root.querySelectorAll('[data-wcf-category]')];
    const modes = [...root.querySelectorAll('[data-wcf-mode]')];
    const normalize = (text) => String(text).normalize('NFKC').toLowerCase()
      .replace(/[\u30a1-\u30f6]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60))
      .replace(/\s+/g, ' ').trim();
    const searchText = new Map(terms.map((term) => [term, normalize(term.dataset.search || '')]));
    let mode = 'starter';
    let announceTimer;
    const say = (message) => {
      clearTimeout(announceTimer);
      announcement.textContent = message;
      announceTimer = setTimeout(() => { announcement.textContent = ''; }, 4200);
    };
    const filter = (openGroups = true) => {
      const words = normalize(input.value).split(' ').filter(Boolean);
      let count = 0;
      for (const term of terms) {
        const visible = (mode === 'all' || term.dataset.priority === 'starter')
          && (!category.value || term.dataset.category === category.value)
          && words.every((word) => searchText.get(term).includes(word));
        term.hidden = !visible;
        if (visible) count += 1;
      }
      for (const group of groups) {
        const visibleTerms = [...group.querySelectorAll('[data-wcf-term]')].filter((term) => !term.hidden);
        group.hidden = visibleTerms.length === 0;
        group.dataset.visibleCount = String(visibleTerms.length);
        group.querySelector('[data-wcf-category-count]').textContent = String(visibleTerms.length);
        if (openGroups && visibleTerms.length) group.open = true;
      }
      for (const button of modes) button.setAttribute('aria-pressed', String(button.dataset.wcfMode === mode));
      results.textContent = `${count} / ${terms.length}項目${mode === 'starter' ? ' · 最初の24語' : ' · 全項目から表示'}`;
      empty.hidden = count !== 0;
    };
    const reset = (nextMode = 'starter') => {
      input.value = '';
      category.value = '';
      mode = nextMode;
      filter();
    };
    const revealHash = (focus = false) => {
      let id;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (!id) return;
      const target = document.getElementById(id);
      if (!target || !root.contains(target)) return;
      if (target.matches('[data-wcf-term]')) reset('all');
      if (target.matches('[data-wcf-category]')) {
        input.value = ''; category.value = target.dataset.wcfCategory; mode = 'all'; filter();
      }
      let current = target;
      while (current && root.contains(current)) {
        if (current instanceof HTMLDetailsElement) current.open = true;
        current = current.parentElement;
      }
      requestAnimationFrame(() => {
        target.scrollIntoView({ block: 'start', behavior: 'auto' });
        if (focus) {
          const focusTarget = target instanceof HTMLDetailsElement ? target.querySelector('summary') : target;
          if (focusTarget) {
            if (!focusTarget.matches('a,button,input,select,textarea,summary')) focusTarget.setAttribute('tabindex', '-1');
            focusTarget.focus({ preventScroll: true });
          }
        }
      });
    };
    const copy = async (value) => {
      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(value); return true; } catch { /* Use selection fallback. */ }
      }
      const area = document.createElement('textarea');
      area.value = value; area.readOnly = true;
      area.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
      document.body.append(area);
      const active = document.activeElement;
      area.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      area.remove();
      if (active instanceof HTMLElement) active.focus({ preventScroll: true });
      return ok;
    };
    root.querySelectorAll('[data-wcf-js]').forEach((el) => { el.hidden = false; });
    input.addEventListener('input', () => {
      if (normalize(input.value)) mode = 'all';
      filter();
    }, { signal });
    category.addEventListener('change', () => { if (category.value) mode = 'all'; filter(); }, { signal });
    root.addEventListener('click', async (event) => {
      const clicked = event.target instanceof Element ? event.target : null;
      if (!clicked) return;
      const button = clicked.closest('button');
      if (button && root.contains(button)) {
        if (button.dataset.wcfMode) { mode = button.dataset.wcfMode; filter(); return; }
        if (button.hasAttribute('data-wcf-reset')) { reset(); input.focus({ preventScroll: true }); return; }
        if (button.hasAttribute('data-wcf-expand')) {
          const open = button.dataset.wcfExpand === 'true';
          terms.filter((term) => !term.hidden).forEach((term) => { term.open = open; });
          return;
        }
        if (button.dataset.wcfCopy) {
          const target = root.querySelector(`#${button.dataset.wcfCopy}`);
          const ok = target && await copy(target.textContent || '');
          say(ok ? 'テンプレートをコピーしました。' : 'コピーできませんでした。本文を選択してコピーしてください。');
          return;
        }
        if (button.dataset.wcfCopyLink) {
          const url = new URL(location.href); url.hash = button.dataset.wcfCopyLink;
          const ok = await copy(url.href);
          say(ok ? '用語へのリンクをコピーしました。' : 'コピーできませんでした。用語を開いた状態のURLをご利用ください。');
          return;
        }
      }
      const link = clicked.closest('a[href^="#"]');
      if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const href = link.getAttribute('href');
      if (!href || href === '#' || !document.getElementById(href.slice(1))) return;
      event.preventDefault();
      if (location.hash !== href) history.pushState(null, '', href);
      revealHash(true);
    }, { signal });
    window.addEventListener('hashchange', () => revealHash(), { signal });
    filter();
    if (location.hash) revealHash();
    let observer;
    if ('IntersectionObserver' in window) {
      const tocLinks = [...root.querySelectorAll('[data-wcf-toc]')];
      const sections = tocLinks.map((link) => document.getElementById(link.getAttribute('href').slice(1))).filter(Boolean);
      observer = new IntersectionObserver((entries) => {
        const entry = entries.filter((e) => e.isIntersecting).sort((a,b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!entry) return;
        for (const link of tocLinks) {
          if (link.getAttribute('href') === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      }, { rootMargin: '-145px 0px -55% 0px', threshold: 0 });
      sections.forEach((section) => observer.observe(section));
    }
    document.addEventListener('astro:before-swap', () => {
      abort.abort(); clearTimeout(announceTimer); if (observer) observer.disconnect();
    }, { once: true });
  };
  // Static loads and Astro client-side navigations use the same initializer.
  if (!window.__seijiConsultingInitRegistered) {
    document.addEventListener('astro:page-load', initialize);
    window.__seijiConsultingInitRegistered = true;
  }
  initialize();
})();

</script>
