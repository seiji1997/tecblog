<script is:inline>
(() => {
  const initialize = () => {
    const root = document.querySelector('[data-fde-root]');
    if (!root || root.dataset.fdeInitialized === 'true') return;
    root.dataset.fdeInitialized = 'true';
    const abort = new AbortController();
    const signal = abort.signal;
    const form = root.querySelector('#fde-inventory-form');
    const status = root.querySelector('#fde-status');
    let timer = 0;
    let frame = 0;
    let printState = [];
    const say = (message) => {
      clearTimeout(timer);
      status.textContent = message;
      timer = window.setTimeout(() => { status.textContent = ''; }, 5500);
    };
    const copy = async (text) => {
      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(text); return true; } catch { /* Try selection fallback. */ }
      }
      const area = document.createElement('textarea');
      area.value = text; area.readOnly = true;
      area.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
      document.body.append(area);
      const active = document.activeElement;
      area.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      area.remove();
      if (active instanceof HTMLElement) active.focus({ preventScroll:true });
      return ok;
    };
    const revealHash = (focus = false) => {
      let id;
      try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (!id) return;
      const target = document.getElementById(id);
      if (!target || !root.contains(target)) return;
      let el = target;
      while (el && root.contains(el)) {
        if (el instanceof HTMLDetailsElement) el.open = true;
        el = el.parentElement;
      }
      requestAnimationFrame(() => {
        target.scrollIntoView({ block:'start', behavior:'instant' });
        if (focus) {
          const destination = target instanceof HTMLDetailsElement ? target.querySelector('summary') : target;
          if (destination instanceof HTMLElement) {
            if (!destination.matches('a,button,input,textarea,summary')) destination.setAttribute('tabindex', '-1');
            destination.focus({ preventScroll:true });
          }
        }
        updateToc();
      });
    };
    const makeInventory = () => {
      const lines = [
        '# FDE型の経験の棚卸し', '',
        `記入日：${new Date().toLocaleDateString('sv-SE')}`, '',
        '学習用の自己記録。企業の合否基準・採用可能性の評価ではありません。',
        '未選択は未確認を含みます。本番実績と学習デモは分けて記載してください。', ''
      ];
      root.querySelectorAll('[data-fde-inventory]').forEach((row) => {
        lines.push(`## ${row.dataset.capability}`, '');
        row.querySelectorAll('input[type="checkbox"]').forEach((input) => {
          lines.push(`- [${input.checked ? 'x' : ' '}] ${input.value}`);
        });
        lines.push('', '### 示せる証拠・自分の担当', '', row.querySelector('[data-fde-evidence]').value.trim() || '未記入', '',
          '### 次につくる証拠', '', row.querySelector('[data-fde-next]').value.trim() || '未記入', '');
      });
      return lines.join('\n');
    };
    const exportInventory = () => {
      const blob = new Blob([makeInventory()], { type:'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url; link.download = 'fde-experience-inventory.md';
      document.body.append(link); link.click(); link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      say('経験の棚卸しをMarkdownファイルに書き出しました。');
    };
    const tocLinks = [...root.querySelectorAll('[data-fde-toc]')];
    const tocTargets = tocLinks.map((a) => document.getElementById(a.hash.slice(1)));
    const updateToc = () => {
      let chosen = -1;
      tocTargets.forEach((el, i) => { if (el && el.getBoundingClientRect().top <= 205) chosen = i; });
      tocLinks.forEach((a, i) => {
        if (i === chosen) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; updateToc(); });
    };
    root.querySelectorAll('[data-fde-js]').forEach((el) => { el.hidden = false; });
    form.addEventListener('submit', (event) => event.preventDefault(), { signal });
    root.addEventListener('click', async (event) => {
      const clicked = event.target instanceof Element ? event.target : null;
      if (!clicked) return;
      const button = clicked.closest('button');
      if (button && root.contains(button)) {
        if (button.dataset.fdeCopy) {
          const text = document.getElementById(button.dataset.fdeCopy);
          if (!text) return;
          const success = await copy(text.value || text.textContent || '');
          say(success ? 'テンプレートのMarkdownをコピーしました。' : 'コピーできませんでした。表示された本文を選択してコピーしてください。');
          return;
        }
        if (button.hasAttribute('data-fde-export')) { exportInventory(); return; }
        if (button.hasAttribute('data-fde-reset')) {
          const populated = [...form.querySelectorAll('input')].some((el) => el.checked) || [...form.querySelectorAll('textarea')].some((el) => el.value.trim());
          if (!populated) { say('リセットする記入内容はありません。'); return; }
          if (window.confirm('記入内容を消去します。必要な内容を先に書き出しましたか？')) { form.reset(); say('記入内容をリセットしました。'); }
          return;
        }
      }
      const link = clicked.closest('a[href^="#"]');
      if (!link || event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      let id;
      try { id = decodeURIComponent(href.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target || !root.contains(target)) return;
      event.preventDefault();
      if (location.hash !== href) history.pushState(null, '', href);
      revealHash(true);
    }, { signal });
    window.addEventListener('hashchange', () => revealHash(), { signal });
    window.addEventListener('popstate', () => { if (location.hash) revealHash(); }, { signal });
    window.addEventListener('scroll', onScroll, { passive:true, signal });
    window.addEventListener('resize', onScroll, { passive:true, signal });
    window.addEventListener('beforeprint', () => {
      printState = [...root.querySelectorAll('details:not(.fde-toc)')].map((el) => [el, el.open]);
      printState.forEach(([el]) => { el.open = true; });
    }, { signal });
    window.addEventListener('afterprint', () => {
      printState.forEach(([el, open]) => { el.open = open; }); printState = [];
    }, { signal });
    updateToc();
    if (location.hash) revealHash();
    document.addEventListener('astro:before-swap', () => {
      abort.abort(); clearTimeout(timer); cancelAnimationFrame(frame);
      delete root.dataset.fdeInitialized;
    }, { once:true });
  };
  // Idempotent on both full page loads and Astro ClientRouter navigations.
  if (!window.__seijiFdeInitRegistered) {
    document.addEventListener('astro:page-load', initialize);
    window.__seijiFdeInitRegistered = true;
  }
  initialize();
})();

</script>
