</style>


<script>
  // Native <details> and normal anchors remain usable without JavaScript.
  // Reinitialise on Astro navigation without accumulating event listeners.
  let disposeReading = () => {};

  function initializeReading() {
    disposeReading();
    const foundPage = document.querySelector('[data-wco-page]');
    if (!(foundPage instanceof HTMLElement)) return;
    const page = foundPage;

    const controller = new AbortController();
    const { signal } = controller;
    const periods = Array.from(page.querySelectorAll('.wco-period'))
      .filter((item) => item instanceof HTMLDetailsElement);
    const chapters = Array.from(page.querySelectorAll('.wco-chapter'))
      .filter((item) => item instanceof HTMLElement);
    const tocLinks = Array.from(page.querySelectorAll('[data-wco-toc]'))
      .filter((item) => item instanceof HTMLAnchorElement);
    const article = page.querySelector('.wco-article');
    const progress = page.querySelector('progress');
    let frame = 0;
    let cancelled = false;
    let printing = false;
    const printState = new Map();

    function updateReading() {
      frame = 0;
      if (cancelled || printing || !page.isConnected) return;
      let active = chapters[0];
      for (const chapter of chapters) {
        if (chapter.getBoundingClientRect().top <= 210) active = chapter;
      }
      for (const link of tocLinks) {
        if (active && link.hash === `#${active.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
      if (article instanceof HTMLElement && progress instanceof HTMLProgressElement) {
        const rect = article.getBoundingClientRect();
        const total = Math.max(1, rect.height - window.innerHeight + 180);
        progress.value = Math.max(0, Math.min(100, ((180 - rect.top) / total) * 100));
      }
    }

    function scheduleUpdate() {
      if (!cancelled && !frame) frame = window.requestAnimationFrame(updateReading);
    }

    function revealHash() {
      if (!window.location.hash) return;
      let id;
      try { id = decodeURIComponent(window.location.hash.slice(1)); }
      catch { return; }
      const target = document.getElementById(id);
      if (!target || !page.contains(target)) return;
      if (target instanceof HTMLDetailsElement) target.open = true;
      let ancestor = target.parentElement;
      while (ancestor && ancestor !== page) {
        if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
        ancestor = ancestor.parentElement;
      }
      window.requestAnimationFrame(() => {
        if (cancelled || !target.isConnected) return;
        target.scrollIntoView({ block: 'start', behavior: 'auto' });
        scheduleUpdate();
      });
    }

    page.querySelector('[data-wco-expand]')?.addEventListener('click', () => {
      periods.forEach((item) => { item.open = true; });
      scheduleUpdate();
    }, { signal });
    page.querySelector('[data-wco-collapse]')?.addEventListener('click', () => {
      periods.forEach((item) => { item.open = false; });
      scheduleUpdate();
    }, { signal });
    periods.forEach((item) => item.addEventListener('toggle', scheduleUpdate, { signal }));
    page.querySelector('.wco-source-details')?.addEventListener('toggle', scheduleUpdate, { signal });
    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal });
    window.addEventListener('resize', scheduleUpdate, { passive: true, signal });
    window.addEventListener('hashchange', revealHash, { signal });

    window.addEventListener('beforeprint', () => {
      printing = true;
      printState.clear();
      page.querySelectorAll('details').forEach((item) => {
        printState.set(item, item.open);
        item.open = true;
      });
    }, { signal });
    window.addEventListener('afterprint', () => {
      printState.forEach((open, item) => { item.open = open; });
      printState.clear();
      printing = false;
      scheduleUpdate();
    }, { signal });

    page.querySelector('.wco-expand-controls')?.removeAttribute('hidden');
    page.querySelector('.wco-reading-status')?.removeAttribute('hidden');
    revealHash();
    scheduleUpdate();

    disposeReading = () => {
      cancelled = true;
      controller.abort();
      if (frame) window.cancelAnimationFrame(frame);
    };
  }

  initializeReading();
  document.addEventListener('astro:page-load', initializeReading);
  document.addEventListener('astro:before-swap', () => disposeReading());
</script>

