---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'ai-ml' } },
    { params: { slug: 'data-engineering' } },
    { params: { slug: 'cloud' } },
    { params: { slug: 'snowflake' } },
    { params: { slug: 'engineering' } },
  ];
}

const { slug } = Astro.params;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

const domains = {
  'ai-ml': {
    kicker: 'LEARN / AI & MACHINE LEARNING',
    title: 'AI / Machine Learning',
    code: 'AI',
    accent: '#a78bfa',
    description: 'Generative AIから従来のMachine Learningまで。概念、実験、実装、評価を再利用できる知識単位に整理していきます。',
    sections: ['Generative AI & LLMs', 'Machine Learning', 'Applied AI', 'Experiments', 'Evaluation', 'AI Engineering'],
  },
  'data-engineering': {
    kicker: 'LEARN / DATA ENGINEERING',
    title: 'Data Engineering',
    code: 'DE',
    accent: '#34d399',
    description: 'データを集め、整え、届け、使える状態に保つための設計と実装を体系化していきます。',
    sections: ['DWH & Modeling', 'Pipelines & Ingestion', 'SQL & Transformation', 'Data Quality', 'BI & Analytics', 'Operations'],
  },
  cloud: {
    kicker: 'LEARN / GOOGLE CLOUD',
    title: 'Google Cloud',
    code: 'GC',
    accent: '#fbbf24',
    description: 'Architecture、Data、AI / ML、Security、Certificationで得た知識を整理していきます。',
    sections: ['Architecture', 'Data & BigQuery', 'AI / Machine Learning', 'Security & IAM', 'Compute & Storage', 'Certification'],
  },
  engineering: {
    kicker: 'LEARN / ENGINEERING TOOLS',
    title: 'Engineering Tools',
    code: 'ET',
    accent: '#60a5fa',
    description: '日々の実装・検証・自動化・開発効率を支えるLanguages、Tools、Workflowをまとめていきます。',
    sections: ['Programming Languages', 'Git & GitHub', 'Linux & Docker', 'Web Development', 'Excel & VBA', 'Automation & Workflow'],
  },
};

const snowflakeCerts = [
  {
    title: 'SnowPro Core', code: 'COF-C03', status: 'STUDYING', href: route('topics/snowflake/core/'),
    official: 'https://learn.snowflake.com/en/certifications/snowpro-core-jpn-C03/'
  },
  {
    title: 'Advanced Data Engineer', code: 'DEA-C02', status: 'PLANNED', href: route('topics/snowflake/data-engineer/'),
    official: 'https://learn.snowflake.com/en/certifications/snowpro-adv-dea-jpn-C02/'
  },
  {
    title: 'Advanced Architect', code: 'ARA-C01', status: 'PLANNED', href: route('topics/snowflake/architect/'),
    official: 'https://learn.snowflake.com/en/certifications/snowpro-adv-ara-jpn/'
  },
];

const snowflakeCapabilities = [
  ['Architecture', route('topics/snowflake/architecture/')],
  ['Data Engineering', route('topics/snowflake/data-engineering/')],
  ['Storage & Data', route('topics/snowflake/storage-data/')],
  ['Performance & Cost', route('topics/snowflake/performance-cost/')],
  ['Security & Governance', route('topics/snowflake/security-governance/')],
  ['Sharing & Integration', route('topics/snowflake/sharing-integration/')],
  ['Apps & Development', route('topics/snowflake/apps-development/')],
];

const isSnowflake = slug === 'snowflake';
const domain = domains[slug as keyof typeof domains];
---

<BaseLayout title={`${isSnowflake ? 'Snowflake' : domain?.title ?? 'Knowledge'} | Seiji Tech Atlas`}>
  <main class="domain-page" style={`--domain-accent:${isSnowflake ? '#68d4f8' : domain?.accent ?? '#68d4f8'}`}>
    <a href={route('')} class="back-link">← Back to Atlas</a>

    <section class="domain-hero">
      <div>
        <p class="domain-kicker">{isSnowflake ? 'LEARN / SNOWFLAKE' : domain?.kicker}</p>
        <h1>{isSnowflake ? 'Snowflake' : domain?.title}</h1>
        <p class="domain-description">
          {isSnowflake
            ? 'Certification study、Architecture、Data Engineering、Security、PerformanceをひとつのKnowledge Baseとして育てていきます。'
            : domain?.description}
        </p>

        <div class="status-pill">
          <span></span>
          {isSnowflake ? 'CONTENT GROWING' : 'UI READY · CONTENT TBD'}
        </div>
      </div>

      <div class="hero-symbol">
        <small>{isSnowflake ? 'PRIMARY FOCUS' : 'KNOWLEDGE DOMAIN'}</small>
        <strong>{isSnowflake ? 'SF' : domain?.code}</strong>
        <span>{isSnowflake ? 'Study · Structure · Reuse' : 'Frame ready. Details coming next.'}</span>
      </div>
    </section>

    {
      isSnowflake ? (
        <>
          <section class="domain-section">
            <div class="section-title">
              <span>01</span>
              <h2>Certification</h2>
            </div>

            <div class="cert-grid">
              {snowflakeCerts.map((cert) => (
                <article class="cert-card">
                  <small>{cert.status}</small>
                  <h3>{cert.title}</h3>
                  <code>{cert.code}</code>
                  <div class="cert-actions">
                    <a href={cert.href}>{cert.title === 'SnowPro Core' ? 'Open Atlas →' : 'Open notes →'}</a>
                    <a href={cert.official} target="_blank" rel="noreferrer">公式 ↗</a>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="domain-section">
            <div class="section-title">
              <span>02</span>
              <h2>Explore Snowflake</h2>
            </div>

            <div class="domain-grid">
              {snowflakeCapabilities.map(([title, href], i) => (
                <a class="domain-card clickable" href={href}>
                  <div class="card-index">{String(i + 1).padStart(2, '0')}</div>
                  <h3>{title}</h3>
                  <p>Structure ready. Detailed notes will be added here.</p>
                  <div class="card-status">TBD · CONTENT COMING</div>
                </a>
              ))}
            </div>
          </section>
        </>
      ) : (
        <section class="domain-section">
          <div class="section-title">
            <span>01</span>
            <h2>Knowledge map</h2>
          </div>

          <div class="domain-grid">
            {domain?.sections.map((title, i) => (
              <article class="domain-card">
                <div class="card-index">{String(i + 1).padStart(2, '0')}</div>
                <h3>{title}</h3>
                <p>Page structure is ready. Notes, references, examples, and learnings will be added next.</p>
                <div class="card-status">TBD · CONTENT COMING</div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="closing-panel">
      <small>NEXT</small>
      <h2>Structure first. Content next.</h2>
      <div class="closing-line"></div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 76% 10%, color-mix(in srgb, var(--domain-accent) 15%, transparent), transparent 30%),
      #0a1119;
  }

  .domain-page {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 38px 0 100px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 34px;
    color: #8fa4b0;
    font-size: .82rem;
  }

  .back-link:hover {
    color: #eef7fb;
  }

  .domain-hero {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 64px;
    align-items: center;
    min-height: 390px;
    padding: 32px 0 64px;
    border-bottom: 1px solid rgba(190, 220, 240, .18);
  }

  .domain-kicker {
    color: var(--domain-accent);
    font: 800 .68rem/1 ui-monospace, monospace;
    letter-spacing: .17em;
  }

  .domain-hero h1 {
    margin: 14px 0 20px;
    color: #f2f7fa;
    font-size: clamp(3.2rem, 8vw, 6.6rem);
    line-height: .9;
    letter-spacing: -.065em;
  }

  .domain-description {
    max-width: 650px;
    color: #a7b7c1;
    font-size: 1rem;
    line-height: 1.75;
  }

  .status-pill {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 9px;
    margin-top: 26px;
    padding: 8px 12px;
    border: 1px solid color-mix(in srgb, var(--domain-accent) 42%, rgba(190,220,240,.2));
    border-radius: 999px;
    color: #bdd0da;
    font: 700 .64rem/1 ui-monospace, monospace;
    letter-spacing: .08em;
  }

  .status-pill span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--domain-accent);
    box-shadow: 0 0 12px var(--domain-accent);
  }

  .hero-symbol {
    min-height: 270px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px;
    border: 1px solid rgba(190, 220, 240, .18);
    border-radius: 24px;
    background:
      radial-gradient(circle at 50% 35%, color-mix(in srgb, var(--domain-accent) 18%, transparent), transparent 42%),
      linear-gradient(145deg, rgba(18, 31, 44, .96), rgba(10, 20, 30, .92));
  }

  .hero-symbol small {
    color: #7a8f9c;
    font: 800 .62rem/1 ui-monospace, monospace;
    letter-spacing: .16em;
  }

  .hero-symbol strong {
    display: block;
    margin: 16px 0 10px;
    color: var(--domain-accent);
    font-size: 5rem;
    line-height: 1;
    letter-spacing: -.08em;
  }

  .hero-symbol span {
    color: #8fa3af;
    font-size: .78rem;
  }

  .domain-section {
    margin-top: 76px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }

  .section-title span {
    color: #587383;
    font: 700 .7rem/1 ui-monospace, monospace;
  }

  .section-title h2 {
    margin: 0;
    color: #eef6f9;
    font-size: 2rem;
    letter-spacing: -.04em;
  }

  .domain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px;
  }

  .domain-card,
  .cert-card {
    border: 1px solid rgba(190, 220, 240, .19);
    border-radius: 16px;
    background:
      linear-gradient(145deg, rgba(18, 31, 44, .95), rgba(11, 21, 31, .95));
  }

  .domain-card {
    min-height: 205px;
    padding: 24px;
  }

  .clickable {
    transition: transform .18s ease, border-color .18s ease;
  }

  .clickable:hover,
  .cert-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--domain-accent) 54%, rgba(190,220,240,.2));
  }

  .card-index {
    color: #526b7b;
    font: 700 .68rem/1 ui-monospace, monospace;
  }

  .domain-card h3,
  .cert-card h3 {
    margin: 28px 0 8px;
    color: #f0f6f9;
    font-size: 1.2rem;
    letter-spacing: -.025em;
  }

  .domain-card p {
    color: #8fa3ae;
    font-size: .82rem;
    line-height: 1.65;
  }

  .card-status {
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid rgba(190, 220, 240, .12);
    color: var(--domain-accent);
    font: 700 .62rem/1 ui-monospace, monospace;
    letter-spacing: .06em;
  }

  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 13px;
  }

  .cert-card {
    min-height: 205px;
    padding: 22px;
    transition: transform .18s ease, border-color .18s ease;
  }

  .cert-card small {
    color: var(--domain-accent);
    font: 700 .66rem/1 ui-monospace, monospace;
  }

  .cert-card code {
    color: #758b98;
    font-size: .72rem;
  }

  .cert-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .cert-actions a {
    padding: 8px 10px;
    border: 1px solid rgba(104, 212, 248, .22);
    border-radius: 8px;
    color: var(--domain-accent);
    background: rgba(14, 27, 38, .68);
    font-size: .7rem;
  }

  .closing-panel {
    margin-top: 78px;
    padding: 30px 0;
    border-top: 1px solid rgba(190, 220, 240, .18);
    border-bottom: 1px solid rgba(190, 220, 240, .18);
  }

  .closing-panel small {
    color: var(--domain-accent);
    font: 800 .62rem/1 ui-monospace, monospace;
    letter-spacing: .16em;
  }

  .closing-panel h2 {
    margin: 8px 0 16px;
    color: #edf5f9;
    font-size: 1.65rem;
  }

  .closing-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--domain-accent), transparent 65%);
    opacity: .5;
  }

  @media (max-width: 760px) {
    .domain-hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .domain-grid,
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
