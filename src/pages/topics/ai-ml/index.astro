<script>
/** A self-contained custom element. Re-initializes after Astro client-side navigation. */
class AtlasAiGlossary extends HTMLElement {
  private cleanup?: AbortController;

  connectedCallback() {
    // An already-registered element may connect before its children are parsed.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => this.initialize(), { once: true });
    } else {
      this.initialize();
    }
  }

  private initialize() {
    if (!this.isConnected || this.cleanup) return;
    const cleanup = new AbortController();
    this.cleanup = cleanup;
    const options = { signal: cleanup.signal };
    const input = this.querySelector<HTMLInputElement>('[data-search-input]');
    const onlyFeatured = this.querySelector<HTMLInputElement>('[data-featured-only]');
    const shell = this.querySelector<HTMLDetailsElement>('.ai-glossary');
    const result = this.querySelector<HTMLElement>('[data-result-count]');
    const empty = this.querySelector<HTMLElement>('[data-empty]');
    if (!input || !onlyFeatured || !shell || !result || !empty) {
      cleanup.abort();
      this.cleanup = undefined;
      return;
    }
    const groups = Array.from(this.querySelectorAll<HTMLDetailsElement>('[data-group]'));
    const terms = Array.from(this.querySelectorAll<HTMLDetailsElement>('[data-term]'));
    const categoryButtons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-category]'));
    const normalize = (text: string) => text.normalize('NFKC').toLowerCase().replace(/[‐‑‒–—-]/g, ' ').replace(/\s+/g, ' ').trim();
    const searchable = new Map(terms.map((term) => [term, normalize(term.dataset.index || '')]));
    const groupedTerms = new Map(groups.map((group) => [group, terms.filter((term) => group.contains(term))]));
    let category = 'all';
    let filtering = false;
    let previouslyOpen = new Set<HTMLDetailsElement>();

    const matchesKeyword = (text: string, keyword: string) => {
      // Short Latin abbreviations must match a word, so "RL" does not match "world".
      if (/^[a-z0-9]{1,4}$/.test(keyword)) {
        const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return new RegExp(`(^|[^a-z0-9])${escaped}($|[^a-z0-9])`, 'i').test(text);
      }
      return text.includes(keyword);
    };

    const applyFilters = () => {
      const words = normalize(input.value).split(/[\s,、]+/).filter(Boolean);
      const isFiltered = words.length > 0 || category !== 'all' || onlyFeatured.checked;
      if (isFiltered && !filtering) previouslyOpen = new Set([...groups, ...terms].filter((item) => item.open));
      if (!isFiltered && filtering) [...groups, ...terms].forEach((item) => { item.open = previouslyOpen.has(item); });
      filtering = isFiltered;
      let total = 0;
      groups.forEach((group) => {
        let count = 0;
        (groupedTerms.get(group) || []).forEach((term) => {
          const show = (category === 'all' || category === group.dataset.group)
            && (!onlyFeatured.checked || term.dataset.featured === 'true')
            && words.every((word) => matchesKeyword(searchable.get(term) || '', word));
          term.hidden = !show;
          if (show) {
            count += 1;
            if (words.length > 0) term.open = true;
          }
        });
        group.hidden = count === 0;
        if (isFiltered && count > 0) group.open = true;
        const label = group.querySelector<HTMLElement>('[data-group-count]');
        if (label) label.textContent = `${count} 語`;
        total += count;
      });
      categoryButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === category)));
      result.textContent = `${total} / ${terms.length} 語を表示`;
      empty.hidden = total !== 0;
    };

    const reset = (focus = false) => {
      input.value = '';
      category = 'all';
      onlyFeatured.checked = false;
      applyFilters();
      if (focus) input.focus();
    };

    const reveal = (hash: string, scroll = true, focus = false): boolean => {
      let id: string;
      try { id = decodeURIComponent(hash.replace(/^#/, '')); } catch { return false; }
      if (id !== 'ai-glossary' && !id.startsWith('term-') && !id.startsWith('glossary-group-')) return false;
      const target = document.getElementById(id);
      if (!(target instanceof HTMLElement) || !this.contains(target)) return false;
      // A permalink must work even when a previous search has hidden the target.
      reset();
      shell.open = true;
      let current: HTMLElement | null = target;
      while (current && current !== this) {
        if (current instanceof HTMLDetailsElement) current.open = true;
        current = current.parentElement;
      }
      requestAnimationFrame(() => {
        if (!this.isConnected) return;
        if (scroll) target.scrollIntoView({ block: 'start', behavior: 'auto' });
        if (focus) target.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
      });
      return true;
    };

    let composing = false;
    input.addEventListener('compositionstart', () => { composing = true; }, options);
    input.addEventListener('compositionend', () => { composing = false; applyFilters(); }, options);
    input.addEventListener('input', () => { if (!composing) applyFilters(); }, options);
    input.addEventListener('search', applyFilters, options);
    onlyFeatured.addEventListener('change', applyFilters, options);
    this.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => reset(true), options);
    categoryButtons.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.category || 'all';
      applyFilters();
    }, options));
    this.querySelector<HTMLButtonElement>('[data-expand]')?.addEventListener('click', () => {
      [...groups, ...terms].forEach((item) => { if (!item.hidden) item.open = true; });
    }, options);
    this.querySelector<HTMLButtonElement>('[data-collapse]')?.addEventListener('click', () => {
      [...groups, ...terms].forEach((item) => { if (!item.hidden) item.open = false; });
    }, options);
    // Delegate at document level so the hero's glossary link works even if it is already the current hash.
    document.addEventListener('click', (event) => {
      if (!(event instanceof MouseEvent) || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const anchor = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
      const hash = anchor?.getAttribute('href');
      if (!anchor || !hash || anchor.target === '_blank') return;
      if (reveal(hash, true, true)) {
        event.preventDefault();
        if (window.location.hash !== hash) history.pushState(null, '', hash);
      }
    }, options);
    window.addEventListener('hashchange', () => reveal(window.location.hash), options);
    this.querySelector<HTMLElement>('[data-controls]')?.removeAttribute('hidden');
    applyFilters();
    if (window.location.hash) reveal(window.location.hash);
  }

  disconnectedCallback() {
    this.cleanup?.abort();
    this.cleanup = undefined;
  }
}

if (!customElements.get('atlas-ai-glossary')) {
  customElements.define('atlas-ai-glossary', AtlasAiGlossary);
}
