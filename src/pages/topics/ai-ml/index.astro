          <summary class="glossary-cover">
            <span class="glossary-cover-copy"><span class="glossary-kicker">02.1 / THE AI VOCABULARY</span><span class="glossary-cover-title">AI用語集<span class="glossary-cover-en">A field guide to modern AI.</span></span></span>
            <span class="glossary-cover-meta"><span>{allTerms.length} TERMS / {glossaryGroups.length} FIELDS</span><span class="glossary-chevron" aria-hidden="true">⌄</span></span>
          </summary>
