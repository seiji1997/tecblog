---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

const pillars = [
  { id: 'modern-ai', number: '01', title: 'Modern AI', description: '基盤モデル・生成AI・LLMを、入力から出力までの仕組みで捉える。', tags: ['Foundation Models', 'Transformer', 'Multimodal'] },
  { id: 'ai-systems', number: '02', title: 'AI Systems', description: 'モデルに検索やツールを接続し、実際の仕事に使えるシステムにする。', tags: ['RAG', 'Tool Use', 'Agents'] },
  { id: 'classical-ml', number: '03', title: 'Machine Learning', description: '問題設定から前処理、モデル選択、検証までを再現可能な形にする。', tags: ['Regression', 'Classification', 'Clustering'] },
  { id: 'evaluation', number: '04', title: 'Evaluation & Operations', description: '精度だけでなく、誤り・安全性・遅延・コストを測り続ける。', tags: ['Metrics', 'Evals', 'Monitoring'] },
];

const modernConcepts = [
  { key: '01', title: 'Foundation model', description: '大量のデータで事前学習され、多様な下流タスクへ適応できるモデルの総称。LLMはそのうち言語を中心に扱うもの。', example: '文章生成、要約、コード、画像理解' },
  { key: '02', title: 'Tokens & prediction', description: 'テキストはトークン列として扱われ、生成時は文脈に続くトークンの分布から出力を選ぶ。学習や推論の詳細はモデルごとに異なる。', example: '入力文脈 → トークン列 → 応答' },
  { key: '03', title: 'Transformer & attention', description: 'Transformerはattentionを中心に構成されたモデル群。各トークンが文脈中のどの情報を使うかを計算する。', example: '文脈に応じた表現の計算' },
  { key: '04', title: 'Multimodal AI', description: 'テキストに加え、画像・音声・動画などを入出力に扱う。対応する形式と推論能力はモデルによって異なる。', example: '画像を読んで説明、音声で対話' },
];

const systems = [
  { title: 'Prompt & context', summary: '指示、制約、例、参照情報を渡す。', caution: '長い入力でも重要な情報が必ず使われるとは限らない。' },
  { title: 'RAG', summary: '関連資料を検索して、取得した情報を生成時の文脈に加える。', caution: '検索漏れや誤った資料は回答品質に直結する。' },
  { title: 'Tool use & agents', summary: 'モデルがツール呼び出しを提案し、アプリ側で実行・結果を返す。複数段階の処理を組み立てられる。', caution: '権限、実行条件、承認、失敗時の停止を設計する。' },
  { title: 'Adaptation', summary: 'プロンプト、検索、ファインチューニングを目的に応じて選ぶ。', caution: '知識更新だけなら検索で足りる場合がある。' },
];

const mlAreas = [
  { number: '00', title: '前処理', aim: '欠損、カテゴリ変数、スケーリング、分割を整える。', methods: 'Imputer / Encoder / Scaling / Pipeline', note: '学習データだけで前処理を学習し、検証データへの漏洩を防ぐ。' },
  { number: '01', title: '回帰', aim: '売上や需要など、連続した数値を予測する。', methods: '線形回帰 / Ridge / Random Forest / LightGBM', note: 'MAE・RMSEなどを目的と誤差の許容範囲で選ぶ。' },
  { number: '02', title: '分類', aim: '離反、異常、カテゴリなどのラベルを予測する。', methods: 'ロジスティック回帰 / SVM / 決定木 / LightGBM', note: '不均衡データではaccuracyだけで判断しない。' },
  { number: '03', title: 'クラスタリング', aim: '正解ラベルのないデータから似た集団を見つける。', methods: 'k-means / DBSCAN / 階層クラスタリング', note: '距離尺度と、クラスタが業務上意味を持つかを確認する。' },
  { number: '04', title: '自然言語処理', aim: 'テキストを分類、検索、抽出、生成に使う。', methods: 'TF-IDF / 埋め込み / Transformer', note: '従来の特徴量ベースと現代の基盤モデルを目的別に選ぶ。' },
  { number: '05', title: '深層学習', aim: '多層のニューラルネットワークで表現を学習する。', methods: 'MLP / CNN / Transformer', note: 'データ量、計算資源、過学習、推論コストを考慮する。' },
  { number: '06', title: '次元削減', aim: '変数を圧縮し、可視化やノイズ低減に使う。', methods: 'PCA / UMAP / t-SNE', note: '可視化上の距離を元データの距離として過信しない。' },
  { number: '07', title: 'アンサンブル学習', aim: '複数モデルを組み合わせて予測を改善する。', methods: 'Bagging / Boosting / Stacking', note: 'スタッキングの学習ではout-of-fold予測を使い、漏洩を避ける。' },
];

const learningFlow = [
  { step: 'DEFINE', title: '問題を決める', detail: '予測対象、利用時点、成功指標を定義' },
  { step: 'PREPARE', title: 'データを整える', detail: '分割、欠損、特徴量、リーク確認' },
  { step: 'MODEL', title: '基準と比較する', detail: '単純なベースラインから改善' },
  { step: 'EVALUATE', title: '失敗を調べる', detail: '指標、セグメント、誤分類を確認' },
  { step: 'OPERATE', title: '運用で測る', detail: '品質、変化、費用を監視' },
];

