---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;

const areas = [
  { id: 'foundation', number: '01', title: 'Foundations & Modeling', description: 'OLTPとOLAP、DWHとレイク、データモデリングを整理する。', tags: ['OLTP / OLAP', 'Dimensional Modeling', 'Lakehouse'] },
  { id: 'storage', number: '02', title: 'Storage & Table Formats', description: 'Parquetなどのファイル形式と、Iceberg・Delta Lake・Hudiのテーブル形式を区別する。', tags: ['Parquet', 'Apache Iceberg', 'Delta Lake', 'Apache Hudi'] },
  { id: 'ingestion', number: '03', title: 'Ingestion & Streaming', description: 'バッチ、CDC、イベントストリームをどのように取り込むかを考える。', tags: ['Batch', 'CDC', 'Kafka', 'Flink'] },
  { id: 'transform', number: '04', title: 'Processing & Transformation', description: 'データを変換し、分析用のモデルとして提供する。', tags: ['SQL', 'Spark', 'dbt', 'ETL / ELT'] },
  { id: 'orchestration', number: '05', title: 'Orchestration & Operations', description: '依存関係、再実行、監視、コストを含めてパイプラインを運用する。', tags: ['Airflow', 'Scheduling', 'Observability', 'Cost'] },
  { id: 'quality', number: '06', title: 'Quality & Governance', description: 'データの検証、来歴、権限、契約を運用に組み込む。', tags: ['Data Quality', 'Lineage', 'Catalog', 'Access Control'] },
];

const icebergFeatures = [
  { title: 'Snapshots', description: '各時点のテーブル状態をメタデータで記録し、対応する過去の状態を参照できる。保持期間やクエリエンジンの対応に注意。' },
  { title: 'Schema evolution', description: '列の追加・改名などの変更を管理する。具体的に許される操作は利用するエンジンに依存する。' },
  { title: 'Partition evolution', description: 'テーブル全体を書き直さずに、新しく書き込むデータのパーティション設計を変えられる。' },
  { title: 'Engine interoperability', description: '対応するカタログとストレージを介して、複数の処理エンジンから同じテーブル定義を利用できる。' },
];
---

<BaseLayout title="Data Engineering | Seiji Tech Atlas" description="データ基盤の学習マップとApache Icebergの基礎。">
  <main class="de-page">
    <a class="back" href={route('')}>← Back to Atlas</a>

    <header class="hero">
      <div>
        <p class="eyebrow">LEARN / DATA ENGINEERING</p>
        <h1>Data<br /><span>Engineering.</span></h1>
        <p class="lead">データを集め、整え、届け、使える状態に保つための設計と実装。基礎から技術選定まで、つながりが見える形で整理します。</p>
        <a class="hero-link" href="#knowledge-map">Explore the map <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-mark" aria-hidden="true"><small>FOUNDATION / 02</small><strong>DE</strong><span>Collect · Model · Serve</span></div>
    </header>

    <section id="knowledge-map" class="section" aria-labelledby="map-title">
      <div class="section-heading"><span>01 / KNOWLEDGE MAP</span><h2 id="map-title">Explore the field</h2><p>ツール名を覚える前に、それぞれがデータの流れのどこを担うかを押さえる。</p></div>
      <div class="area-grid">
        {areas.map((area) => (
          <article class="area-card" id={area.id}>
            <span class="number">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <div class="tags" aria-label="主なトピック">{area.tags.map((tag) => <span>{tag}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="flow-title">
      <div class="section-heading"><span>02 / MENTAL MODEL</span><h2 id="flow-title">Where each piece fits</h2><p>一般的な構成例。要件に応じてサービスと処理順序は変わります。</p></div>
      <ol class="flow">
        <li><small>01 / SOURCE</small><strong>業務システム・API</strong><span>元データ</span></li>
        <li><small>02 / INGEST</small><strong>Batch・CDC・Kafka</strong><span>取り込み</span></li>
        <li><small>03 / STORE</small><strong>Parquet + Iceberg</strong><span>保存・テーブル管理</span></li>
        <li><small>04 / PROCESS</small><strong>Spark・SQL・dbt</strong><span>加工・モデリング</span></li>
        <li><small>05 / SERVE</small><strong>DWH・BI・ML</strong><span>分析・活用</span></li>
      </ol>
      <p class="flow-note">Airflowなどのオーケストレーション、品質管理、権限管理は複数の段階にまたがります。</p>
    </section>

    <section id="apache-iceberg" class="section" aria-labelledby="iceberg-title">
      <div class="section-heading"><span>03 / TECHNOLOGY NOTE</span><h2 id="iceberg-title">Apache Iceberg</h2><p>オブジェクトストレージ上のデータを、複数のエンジンで扱えるテーブルとして管理するためのオープンなテーブル形式。</p></div>
      <div class="iceberg-layout">
        <div class="iceberg-main">
          <p class="mini-label">HOW IT WORKS</p>
          <div class="layers" aria-label="Apache Icebergの構成">
            <div><small>QUERY ENGINE</small><strong>Spark · Snowflake · Trino など</strong><span>対応範囲はエンジンごとに異なる</span></div>
            <div><small>CATALOG + ICEBERG METADATA</small><strong>現在のテーブル状態と参照先ファイルを管理</strong><span>スナップショット・スキーマ・パーティション情報</span></div>
            <div><small>OBJECT STORAGE</small><strong>S3 · ADLS · GCS など</strong><span>Parquetなどのデータファイルを保存</span></div>
          </div>
          <p class="explainer">Parquetは個々のデータファイルの形式。Icebergは、どのファイルの集合が現在のテーブルなのかを管理する形式です。単にParquetを置くこととは役割が異なります。</p>
        </div>
        <aside class="comparison"><p class="mini-label">LEARN NEXT</p><h3>Iceberg の位置づけ</h3><dl><div><dt>Parquet</dt><dd>ファイル形式</dd></div><div><dt>Iceberg</dt><dd>テーブル形式</dd></div><div><dt>Catalog</dt><dd>テーブルの所在と参照を管理</dd></div><div><dt>Snowflake Iceberg Tables</dt><dd>SnowflakeからIcebergを扱う機能</dd></div></dl><p>Snowflake固有の構成や書き込み可否は、Snowflake側の学習ページで扱います。</p></aside>
      </div>
      <div class="feature-grid">{icebergFeatures.map((feature) => <article><h3>{feature.title}</h3><p>{feature.description}</p></article>)}</div>
      <p class="footnote">性能面ではパーティション、ファイルサイズ、メタデータ、並び順なども重要です。Hilbert曲線を含むソート手法は、使用中のIcebergバージョンと処理エンジンの対応を確認してから設計します。</p>
      <nav class="references" aria-label="公式資料"><a href="https://iceberg.apache.org/spec/" target="_blank" rel="noopener noreferrer">Apache Iceberg Specification ↗</a><a href="https://iceberg.apache.org/docs/latest/evolution/" target="_blank" rel="noopener noreferrer">Schema & Partition Evolution ↗</a><a href="https://docs.snowflake.com/en/user-guide/tables-iceberg" target="_blank" rel="noopener noreferrer">Snowflake Iceberg Tables ↗</a></nav>
    </section>

    <footer class="closing"><span>NEXT STEP</span><p>概念を理解し、実データで試し、選定理由を説明できる形に残す。</p><a href="#knowledge-map">Back to knowledge map ↑</a></footer>
  </main>
</BaseLayout>

<style>
  :global(body){background:radial-gradient(circle at 75% 5%,rgba(52,211,153,.12),transparent 32%),#0a1119}
  .de-page{width:min(1120px,calc(100% - 40px));margin:auto;padding:38px 0 100px;color:#eef6f9}
  .back{color:#90a6b0;font-size:.82rem;text-decoration:none}.back:hover,.closing a:hover{color:#34d399}
  .hero{display:grid;grid-template-columns:1.2fr .8fr;gap:48px;align-items:center;min-height:480px;padding:50px 0 65px;border-bottom:1px solid rgba(190,220,240,.18)}
  .eyebrow,.section-heading>span,.mini-label,.closing>span{color:#34d399;font:800 .66rem/1.4 ui-monospace,monospace;letter-spacing:.16em}
  h1{margin:20px 0 24px;font-size:clamp(3.6rem,8vw,7.2rem);line-height:.91;letter-spacing:-.07em}h1 span{color:#9cecc9}
  .lead{max-width:650px;color:#a7b9c0;line-height:1.85}.hero-link{display:inline-flex;gap:20px;align-items:center;margin-top:22px;color:#7ce4b7;font-weight:700;text-decoration:none}
  .hero-mark{display:flex;min-height:290px;flex-direction:column;justify-content:center;padding:32px;border:1px solid rgba(130,240,190,.3);border-radius:24px;background:radial-gradient(circle at 55% 40%,rgba(52,211,153,.18),transparent 55%),linear-gradient(140deg,#12242a,#0b1822)}
  .hero-mark small{color:#8ed9b8;font:700 .65rem ui-monospace,monospace;letter-spacing:.14em}.hero-mark strong{margin:12px 0;color:#34d399;font-size:7rem;line-height:1;letter-spacing:-.1em}.hero-mark span{color:#8eaaa5;font-size:.8rem}
  .section{margin-top:82px;scroll-margin-top:32px}.section-heading{margin-bottom:28px}.section-heading h2{margin:12px 0;font-size:clamp(2rem,4vw,3rem);letter-spacing:-.05em}.section-heading p{max-width:750px;margin:0;color:#9aadb6;line-height:1.7}
  .area-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.area-card,.iceberg-main,.comparison,.feature-grid article{border:1px solid rgba(190,220,240,.18);border-radius:18px;background:linear-gradient(145deg,rgba(19,34,45,.96),rgba(11,22,32,.96))}
  .area-card{padding:26px;scroll-margin-top:32px}.number{color:#34d399;font:700 .7rem ui-monospace,monospace}.area-card h3{margin:27px 0 9px;font-size:1.27rem}.area-card p,.feature-grid p,.comparison p{color:#97aeb7;font-size:.87rem;line-height:1.75}.tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:22px}.tags span{padding:7px 10px;border:1px solid #29434c;border-radius:7px;color:#a8d5c3;background:#122a2b;font-size:.71rem}
  .flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;list-style:none;padding:0;margin:0}.flow li{position:relative;min-height:140px;padding:20px 16px;border:1px solid #29434c;border-radius:12px;background:#11222a}.flow li:not(:last-child)::after{content:'→';position:absolute;right:-13px;top:45%;z-index:1;color:#74d6ac;font-size:1.25rem}.flow small,.flow span{display:block;color:#88a8a7;font-size:.67rem}.flow small{color:#68d7a7;font-family:ui-monospace,monospace}.flow strong{display:block;margin:18px 0 9px;font-size:.91rem;line-height:1.4}.flow-note,.footnote{color:#86a39e;font-size:.8rem;line-height:1.75}
  .iceberg-layout{display:grid;grid-template-columns:1.5fr .85fr;gap:14px}.iceberg-main,.comparison{padding:28px}.mini-label{margin:0 0 20px}.layers{display:grid;gap:8px}.layers div{display:flex;flex-direction:column;gap:5px;padding:17px 19px;border:1px solid #2d5551;border-radius:10px;background:#102c2d}.layers small{color:#63d4a5;font:.67rem ui-monospace,monospace}.layers strong{font-size:.95rem}.layers span{color:#8ba9aa;font-size:.73rem}.explainer{margin:25px 0 0;color:#bbd0d0;line-height:1.8;font-size:.88rem}
  .comparison h3{margin:0 0 23px}.comparison dl{margin:0}.comparison dl div{padding:13px 0;border-bottom:1px solid #2a3c45}.comparison dt{font-weight:700;font-size:.84rem}.comparison dd{margin:5px 0 0;color:#9caeb7;font-size:.77rem}.comparison p:last-child{margin-top:24px}
  .feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.feature-grid article{padding:21px}.feature-grid h3{margin:0;color:#a2eccb;font-size:1rem}.feature-grid p{margin-bottom:0}.footnote{margin-top:20px}
  .references{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}.references a{color:#9cecc9;font-size:.78rem;text-decoration:underline;text-underline-offset:3px}
  .closing{display:flex;flex-wrap:wrap;align-items:center;gap:15px;margin-top:90px;padding:32px 0;border-top:1px solid #354b51}.closing p{flex:1;min-width:240px;color:#b5c9c9}.closing a{color:#a5d9c5;font-size:.8rem;text-decoration:none}
  @media(max-width:800px){.hero,.iceberg-layout{grid-template-columns:1fr}.hero{gap:24px;min-height:0}.hero-mark{min-height:190px}.hero-mark strong{font-size:5rem}.flow{grid-template-columns:repeat(2,minmax(0,1fr))}.flow li::after{display:none}}
  @media(max-width:600px){.de-page{width:min(100% - 32px,1120px)}.hero{padding:40px 0 50px}.area-grid,.feature-grid{grid-template-columns:1fr}.flow{grid-template-columns:1fr}.flow li{min-height:0}.section{margin-top:64px}h1{font-size:clamp(3.1rem,14vw,5rem)}}
</style>
