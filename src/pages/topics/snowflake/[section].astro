---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    {
      params: { section: 'core' },
      props: {
        eyebrow: 'CERTIFICATION',
        title: 'SnowPro Core',
        heroNote: 'Official scope updated for COF-C03.',
        sections: [
          {
            no: '01',
            title: 'Overview',
            body: 'SnowPro Core (COF-C03) is the foundational Snowflake certification. The official certification page positions it as validation of practical ability on the Snowflake AI Data Cloud, and recommends it for candidates with roughly 6+ months of Snowflake experience.',
            bullets: [
              'Exam code: COF-C03',
              'Foundational certification for Snowflake practitioners',
              'Recommended experience: 6+ months using Snowflake',
              'Official page also links to the study guide and learning journey',
            ],
          },
          {
            no: '02',
            title: 'Key concepts',
            body: 'Based on the official SnowPro Core certification page, the exam expects you to understand the following capability areas:',
            bullets: [
              'Use Snowflake AI Data Cloud architecture',
              'Manage Snowflake accounts and virtual warehouses',
              'Perform data loading, unloading, and transformation',
              'Work with structured, semi-structured, and unstructured data',
              'Monitor and optimize performance',
              'Enable data collaboration and protection features',
              'Set up Snowflake connections',
            ],
          },
          {
            no: '03',
            title: 'Practical notes',
            body: 'Use this area for your own takeaways from practice, exercises, project work, and exam prep. Add mistakes, shortcuts, memorization points, and examples you want to reuse later.',
            bullets: [
              'TBD · personal hands-on notes',
              'TBD · architecture / warehouse reminders',
              'TBD · SQL / loading / semi-structured examples',
            ],
          },
          {
            no: '04',
            title: 'Review',
            body: 'This section can be used as a final recap area before the exam: checklist, weak points, review questions, and links back to detailed notes.',
            bullets: [
              'TBD · checklist',
              'TBD · weak points to revisit',
              'TBD · last-day review notes',
            ],
          },
        ],
      },
    },
    {
      params: { section: 'data-engineer' },
      props: { eyebrow: 'CERTIFICATION', title: 'Advanced Data Engineer' },
    },
    {
      params: { section: 'architect' },
      props: { eyebrow: 'CERTIFICATION', title: 'Advanced Architect' },
    },
    {
      params: { section: 'architecture' },
      props: { eyebrow: 'PLATFORM', title: 'Architecture' },
    },
    {
      params: { section: 'data-engineering' },
      props: { eyebrow: 'PIPELINES', title: 'Data Engineering' },
    },
    {
      params: { section: 'storage-data' },
      props: { eyebrow: 'DATA LAYER', title: 'Storage & Data' },
    },
    {
      params: { section: 'performance-cost' },
      props: { eyebrow: 'EFFICIENCY', title: 'Performance & Cost' },
    },
    {
      params: { section: 'security-governance' },
      props: { eyebrow: 'CONTROL', title: 'Security & Governance' },
    },
    {
      params: { section: 'sharing-integration' },
      props: { eyebrow: 'CONNECT', title: 'Sharing & Integration' },
    },
    {
      params: { section: 'apps-development' },
      props: { eyebrow: 'BUILD', title: 'Apps & Development' },
    },
  ];
}

const {
  eyebrow,
  title,
  heroNote = 'UI READY · CONTENT TBD',
  sections = [
    {
      no: '01',
      title: 'Overview',
      body: 'TBD · high-level overview and purpose of this page.',
      bullets: ['TBD'],
    },
    {
      no: '02',
      title: 'Key concepts',
      body: 'TBD · important concepts to organize here.',
      bullets: ['TBD'],
    },
    {
      no: '03',
      title: 'Practical notes',
      body: 'TBD · hands-on notes and examples.',
      bullets: ['TBD'],
    },
    {
      no: '04',
      title: 'Review',
      body: 'TBD · review checklist and summary.',
      bullets: ['TBD'],
    },
  ],
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const isCore = title === 'SnowPro Core';
---

<BaseLayout title={`${title} | Snowflake | Seiji Tech Atlas`}>
  <main class="page">
    <a href={route('topics/snowflake/')} class="back">← Back to Snowflake</a>

    <section class="hero">
      <div class="label">SNOWFLAKE / {eyebrow}</div>
      <h1>{title}</h1>

      <div class="status">
        <span></span>
        {heroNote}
      </div>
    </section>

    {isCore && (
      <section class="resource-callout">
        <div>
          <small>OFFICIAL SOURCE</small>
          <strong>Snowflake Certification Page</strong>
          <p>Overview and key concepts are aligned to the latest official SnowPro Core certification page (COF-C03).</p>
        </div>
        <a href="https://learn.snowflake.com/en/certifications/snowpro-core-kor-C03/" target="_blank" rel="noreferrer">Open official page ↗</a>
      </section>
    )}

    <section class="frame-grid">
      {sections.map((section) => (
        <article>
          <span>{section.no}</span>
          <h2>{section.title}</h2>
          <p class="body-copy">{section.body}</p>
          <ul>
            {section.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 72% 10%, rgba(104, 212, 248, .12), transparent 30%),
      #0a1119;
  }

  .page {
    width: min(1080px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 100px;
  }

  .back {
    color: #8fa4b0;
    font-size: .82rem;
  }

  .hero {
    padding: 86px 0 64px;
    border-bottom: 1px solid rgba(190, 220, 240, .18);
  }

  .label {
    color: #68d4f8;
    font: 800 .68rem/1 ui-monospace, monospace;
    letter-spacing: .17em;
  }

  h1 {
    margin: 14px 0 24px;
    color: #f2f7fa;
    font-size: clamp(3.2rem, 8vw, 6.5rem);
    line-height: .9;
    letter-spacing: -.065em;
  }

  .status {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 9px;
    padding: 8px 12px;
    border: 1px solid rgba(104, 212, 248, .35);
    border-radius: 999px;
    color: #b9ced8;
    font: 700 .64rem/1 ui-monospace, monospace;
    letter-spacing: .08em;
  }

  .status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #68d4f8;
    box-shadow: 0 0 12px rgba(104, 212, 248, .7);
  }

  .resource-callout {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 30px;
    padding: 20px 22px;
    border: 1px solid rgba(104, 212, 248, .18);
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(18, 31, 44, .95), rgba(11, 21, 31, .95));
  }

  .resource-callout small {
    display: block;
    color: #68d4f8;
    font: 800 .62rem/1 ui-monospace, monospace;
    letter-spacing: .16em;
  }

  .resource-callout strong {
    display: block;
    margin-top: 8px;
    color: #eef6f9;
    font-size: 1rem;
  }

  .resource-callout p {
    margin: 8px 0 0;
    color: #9db0bb;
    font-size: .8rem;
    line-height: 1.7;
  }

  .resource-callout a {
    flex: 0 0 auto;
    color: #68d4f8;
    font-size: .82rem;
  }

  .frame-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 13px;
    margin-top: 36px;
  }

  .frame-grid article {
    min-height: 260px;
    padding: 24px;
    border: 1px solid rgba(190, 220, 240, .19);
    border-radius: 16px;
    background:
      linear-gradient(145deg, rgba(18, 31, 44, .95), rgba(11, 21, 31, .95));
  }

  .frame-grid article > span {
    color: #526b7b;
    font: 700 .68rem/1 ui-monospace, monospace;
  }

  .frame-grid h2 {
    margin: 28px 0 8px;
    color: #eef6f9;
  }

  .body-copy {
    margin: 0;
    color: #aebfc8;
    font-size: .82rem;
    line-height: 1.72;
  }

  .frame-grid ul {
    margin: 14px 0 0;
    padding-left: 18px;
    color: #68d4f8;
  }

  .frame-grid li {
    margin: 0 0 7px;
    color: #8eddf7;
    font-size: .76rem;
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .resource-callout {
      display: block;
    }

    .resource-callout a {
      display: inline-block;
      margin-top: 12px;
    }

    .frame-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
