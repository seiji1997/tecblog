]},
{"id": "pipelines", "title": "パイプライン・変更追跡", "en": "PIPELINES & CHANGE DATA CAPTURE", "sections": ["data-engineering"], "description": "差分処理、自動実行、宣言的変換、運用時の再実行をつなぐ。", "terms": [
  {"id": "stream", "title": "Stream", "ja": "ストリーム", "meaning": "対象オブジェクトの変更を追跡し、前回のオフセット以降の差分を取得するオブジェクト。差分処理の起点になる。", "example": "変更された顧客データを下流のマスタへ反映する。", "note": "Stream自体に元データの完全コピーを保持するわけではない。保持期間と消費方法が重要。", "sources": ["streams"], "tracks": ["C", "D", "A"], "aliases": "CDC change data capture 差分", "featured": true, "related": ["stream-offset", "stream-stale", "change-tracking", "task", "dynamic-table"], "sql": "SELECT * FROM changes_stream;\n-- SELECTだけではStreamのオフセットは進まない。"},
  {"id": "stream-types", "title": "Standard / append-only / insert-only stream", "ja": "ストリームの種類", "meaning": "更新・削除を含む変更、追加行だけ、外部表等への挿入中心など、対象と必要な差分で種類を選ぶ。", "example": "追記ログにはappend-only、更新のあるマスタにはstandardを検討する。", "note": "対象テーブルによって使える種類が異なる。append-onlyで更新・削除まで同様に追えるとは考えない。", "sources": ["streams"], "tracks": ["D", "A"], "aliases": "APPEND_ONLY INSERT_ONLY 標準ストリーム", "featured": false, "related": ["stream", "task"]},
  {"id": "stream-offset", "title": "Stream offset / consumption", "ja": "ストリームのオフセットと消費", "meaning": "どこまでの変更を処理したかを示す位置。StreamをDML等で消費し、トランザクションがコミットされると進む。", "example": "差分をMERGEで反映して処理済み位置を進める。", "note": "単にSELECTしただけではオフセットは進まない。複数の独立利用者には別Streamを検討する。", "sources": ["streams"], "tracks": ["C", "D", "A"], "aliases": "consume offset COMMIT 消費", "featured": false, "related": ["stream", "stream-stale", "change-tracking"]},
  {"id": "stream-stale", "title": "Stream staleness", "ja": "ストリームの陳腐化", "meaning": "必要な履歴が保持されなくなり、差分を正しく取得できなくなる状態。未消費期間と保持設定に注意する。", "example": "長期停止していたパイプラインの再開前にSTALE_AFTERを確認する。", "note": "Streamを作れば変更履歴が永久保存されるわけではない。", "sources": ["streams"], "tracks": ["D", "A"], "aliases": "stale STALE_AFTER MAX_DATA_EXTENSION_TIME_IN_DAYS", "featured": false, "related": ["stream", "stream-offset", "change-tracking"]},
  {"id": "change-tracking", "title": "CHANGE_TRACKING / CHANGES", "ja": "変更追跡とCHANGES句", "meaning": "変更追跡を有効にし、指定区間の差分を問い合わせる仕組み。Streamオブジェクトを使わない取得方法もある。", "example": "期間を指定して変更を調査する。", "note": "CHANGES句は自動で利用者ごとの処理済み位置を管理するStreamと同一ではない。", "sources": ["streams"], "tracks": ["D", "A"], "aliases": "CHANGE_TRACKING CHANGES", "featured": false, "related": ["stream", "stream-offset", "stream-stale"]},
  {"id": "stream-metadata", "title": "Stream metadata columns", "ja": "変更メタデータ列", "meaning": "METADATA$ACTION、METADATA$ISUPDATE、METADATA$ROW_ID等で、差分の操作種別や識別情報を表す。", "example": "UPDATE由来のDELETE/INSERTの組を考慮してMERGEする。", "note": "ACTIONだけを見て業務上の削除と判断しない。更新が複数行として表現される場合がある。", "sources": ["streams"], "tracks": ["D", "A"], "aliases": "METADATA$ACTION METADATA$ISUPDATE METADATA$ROW_ID", "featured": false, "related": ["stream", "task"]},
  {"id": "task", "title": "Task", "ja": "タスク", "meaning": "スケジュールや条件に基づきSQLやプロシージャを実行するオブジェクト。定期処理やパイプラインを自動化する。", "example": "毎時の集計や申請データの検証を実行する。", "note": "Streamは変更追跡、Taskは実行。片方だけで両方の役割を持つわけではない。", "sources": ["tasks"], "tracks": ["C", "D", "A"], "aliases": "CREATE TASK CRON SCHEDULE", "featured": true, "related": ["stream", "dynamic-table"]},
  {"id": "serverless-task", "title": "Serverless task", "ja": "サーバーレスタスク", "meaning": "利用者がウェアハウスを指定せず、Snowflake管理の資源で実行するタスク。", "example": "負荷が変動する定期処理の計算管理を簡素化する。", "note": "ユーザー管理ウェアハウスのタスクと、費用・権限・制御方法を比較する。", "sources": ["tasks"], "tracks": ["D", "A"], "aliases": "USER_TASK_MANAGED_INITIAL_WAREHOUSE_SIZE", "featured": false, "related": ["serverless", "resource-monitor", "budget"]},
  {"id": "triggered-task", "title": "Triggered task", "ja": "トリガータスク", "meaning": "Streamへの変更などの条件を契機に実行するタスク。固定間隔のスケジュールと使い分ける。", "example": "新しい注文差分があるときだけ処理する。", "note": "変更検知の条件は、実際に処理すべき行が必ず存在する保証とは限らない。", "sources": ["tasks"], "tracks": ["D", "A"], "aliases": "WHEN SYSTEM$STREAM_HAS_DATA triggered", "featured": false, "related": ["stream", "task"]},
  {"id": "task-graph", "title": "Task graph", "ja": "タスクグラフ", "meaning": "依存関係を持つ複数タスクを連結した処理グラフ。先行処理、並行処理、最終処理を組み立てる。", "example": "ロード完了後に複数マートを更新し、最後に通知する。", "note": "再実行時の重複、副作用、部分成功を設計する必要がある。", "sources": ["task-graphs"], "tracks": ["D", "A"], "aliases": "DAG AFTER root child finalizer", "featured": false, "related": ["stream", "task"]},
  {"id": "task-retry", "title": "Task retry / error notification", "ja": "タスクの再試行・障害通知", "meaning": "失敗したタスクやグラフの再実行、エラー通知、実行履歴の確認に関わる仕組み。", "example": "一時的な接続エラーを再試行し、失敗継続時に通知する。", "note": "再実行できることと冪等であることは別。通知統合や権限も必要。", "sources": ["tasks", "task-graphs"], "tracks": ["D", "A"], "aliases": "TASK_AUTO_RETRY_ATTEMPTS ERROR_INTEGRATION TASK_HISTORY", "featured": false, "related": ["stream", "task"]},
  {"id": "dynamic-table", "title": "Dynamic table", "ja": "動的テーブル", "meaning": "SELECTで望む結果と鮮度目標を定義し、Snowflakeが更新処理と依存関係を管理するテーブル。", "example": "生データから加工済みデータへ宣言的なパイプラインを作る。", "note": "通常のビューと違って結果を保持する。任意の手続き処理をそのまま置き換えられるわけではない。", "sources": ["dynamic"], "tracks": ["C", "D", "A"], "aliases": "DT ダイナミックテーブル 宣言的", "featured": true, "related": ["stream", "task", "target-lag", "refresh-mode", "materialized-view"], "sql": "SHOW DYNAMIC TABLES;\n-- ラグや更新の詳細は、対象の履歴・定義も確認する。"},
  {"id": "target-lag", "title": "Target lag", "ja": "目標遅延", "meaning": "Dynamic Tableで許容するデータの古さを指定する考え方。依存する上流からの鮮度を意識する。", "example": "分析表の目標遅延を設定し、更新頻度と費用を調整する。", "note": "厳密な実行間隔や常時達成されるSLAではない。DOWNSTREAM指定の意味も確認する。", "sources": ["dynamic"], "tracks": ["D", "A"], "aliases": "TARGET_LAG DOWNSTREAM 鮮度", "featured": false, "related": ["dynamic-table", "refresh-mode", "materialized-view"]},
  {"id": "refresh-mode", "title": "Incremental / full refresh", "ja": "差分更新・全件更新", "meaning": "Dynamic Tableの結果を変更分から計算するか、全体を再計算するかの方式。対応SQLと設定に依存する。", "example": "差分が小さい処理でincrementalの効果を確認する。", "note": "差分更新だから常に安いとは限らない。変更割合とクエリ構造で費用が変わる。", "sources": ["dynamic"], "tracks": ["D", "A"], "aliases": "REFRESH_MODE AUTO INCREMENTAL FULL", "featured": false, "related": ["dynamic-table", "target-lag", "materialized-view"]},
  {"id": "row-timestamps", "title": "Row timestamps", "ja": "行タイムスタンプ", "meaning": "行の取り込みや更新に関する時刻を使い、パイプラインの遅延を測る機能。", "example": "ソースイベントの発生時刻と取り込み時刻を比較する。", "note": "業務イベント時刻そのものと同一ではない。対応オブジェクトや設定を確認する。", "sources": ["rowtime"], "tracks": ["D", "X"], "aliases": "METADATA$ROW_LAST_COMMIT_TIME latency", "featured": false, "related": ["stream", "task"]},
  {"id": "openflow", "title": "Snowflake Openflow", "ja": "Openflow", "meaning": "Apache NiFiを基盤とするデータ統合サービス。コネクタとフローを使って各種ソースの取り込み・連携を構成する。", "example": "データベースやSaaSからデータを継続的に取り込む。", "note": "SnowpipeやTaskの別名ではない。デプロイ方式、コネクタ、稼働費用を確認する。", "sources": ["openflow"], "tracks": ["D", "A", "X"], "aliases": "NiFi ETL connector BYOC", "featured": false, "related": ["stream", "task"]},
  {"id": "dbt-projects", "title": "dbt Projects on Snowflake", "ja": "Snowflake上のdbtプロジェクト", "meaning": "dbtプロジェクトをSnowflake上で管理・実行する機能。SQLモデルやテストをプロジェクトとして扱う。", "example": "Git管理したdbtモデルをデプロイし、変換を実行する。", "note": "dbtの全製品・全外部機能が同じ形で含まれるわけではない。対応版や実行方法を確認する。", "sources": ["dbt"], "tracks": ["D", "A", "X"], "aliases": "dbt Core models tests", "featured": false, "related": ["stream", "task"]},
  {"id": "dcm-projects", "title": "DCM Projects", "ja": "宣言的変更管理プロジェクト", "meaning": "定義した望ましい状態を基に、Snowflakeオブジェクトやデータパイプラインの変更管理を行う仕組み。", "example": "開発・本番で構成の差分を確認し、宣言的に反映する。", "note": "通常のSQLスクリプトやdbtと役割を混同しない。対象オブジェクト・制約を確認する。", "sources": ["dcm"], "tracks": ["D", "A", "X"], "aliases": "Declarative Change Management DCM", "featured": false, "related": ["stream", "task"]},
  {"id": "idempotency", "title": "Idempotency", "ja": "冪等性", "meaning": "同じ処理を再実行しても意図した結果が変わらないようにする設計特性。Snowflake固有の単一機能名ではない。", "example": "申請IDや業務キーで二重登録を防ぎながら再処理する。", "note": "COPYのファイル判定、Streamの消費、MERGEだけで全工程の冪等性が自動保証されるわけではない。", "sources": ["copy", "streams", "merge"], "tracks": ["D", "A"], "aliases": "再実行 exactly-once 重複排除", "featured": false, "related": ["merge", "transaction"]}
]},
{"id": "sql", "title": "SQL・変換・データ型", "en": "SQL & TRANSFORMATION", "sections": ["data-engineering", "storage-data"], "description": "SnowflakeらしいSQLと、実装時に間違えやすい型・NULL・更新をまとめる。", "terms": [
  {"id": "merge", "title": "MERGE", "ja": "条件付き挿入・更新・削除", "meaning": "ソースと対象の一致条件に基づきINSERT、UPDATE、DELETEを組み合わせるSQL。増分反映やマスタ更新に使う。", "example": "検証済み申請を業務キーでMasterへ反映する。", "note": "ソースに同じキーが複数ある場合の結果を確認する。MERGEを使えば重複が自動解消されるわけではない。", "sources": ["merge"], "tracks": ["C", "D", "A"], "aliases": "upsert アップサート", "featured": true, "related": ["idempotency", "transaction"], "sql": "MERGE INTO customer_master AS t\nUSING request_source AS s ON t.customer_id = s.customer_id\nWHEN MATCHED THEN UPDATE SET t.name = s.name\nWHEN NOT MATCHED THEN INSERT (customer_id, name)\nVALUES (s.customer_id, s.name);\n-- 更新を伴う例。ソースIDの一意性を先に検証する。"},
  {"id": "transaction", "title": "Transaction", "ja": "トランザクション", "meaning": "複数の処理をコミットまたはロールバックする単位。中途半端な反映を防ぐための境界を設計する。", "example": "複数表への業務更新をBEGIN/COMMITで扱う。", "note": "DDLの暗黙コミットやストアドプロシージャ内のスコープを確認する。全SQLが一律にロールバック可能とは限らない。", "sources": ["transactions"], "tracks": ["C", "D", "A"], "aliases": "ACID BEGIN COMMIT ROLLBACK AUTOCOMMIT", "featured": false, "related": ["merge", "idempotency"]},
  {"id": "variant", "title": "VARIANT", "ja": "半構造化データ型", "meaning": "JSON等の多様な値を保持できる型。値の型情報とともに保持し、パスで内部要素を参照する。", "example": "APIレスポンスや検証結果をJSONとして受け渡す。", "note": "JSON文字列をVARCHARに入れることと、PARSE_JSONしてVARIANTにすることは違う。", "sources": ["variant"], "tracks": ["C", "D", "A"], "aliases": "JSON semi-structured 半構造化", "featured": true, "related": ["flatten", "json-null", "object-array"], "sql": "SELECT PARSE_JSON('{\"customer_id\":101,\"active\":true}') AS payload;"},
  {"id": "object-array", "title": "OBJECT / ARRAY", "ja": "オブジェクト・配列", "meaning": "キーと値の集合や値の並びを扱う型。半構造化と構造化の形式があり、必要な型保証で選ぶ。", "example": "申請の属性群をOBJECT、エラーの一覧をARRAYにまとめる。", "note": "配列内の位置と業務キーを同一視しない。構造化型との違いにも注意する。", "sources": ["variant", "structured"], "tracks": ["C", "D"], "aliases": "配列 オブジェクト", "featured": false, "related": ["variant", "flatten", "json-null"]},
  {"id": "flatten", "title": "FLATTEN / LATERAL", "ja": "配列・オブジェクトの行展開", "meaning": "入れ子のデータを複数行へ展開するテーブル関数。LATERALで元の行と対応づけて扱える。", "example": "注文JSONの明細配列を行単位に変換する。", "note": "展開で行数が増えるため、元の粒度の金額等を重複集計しない。", "sources": ["flatten"], "tracks": ["C", "D"], "aliases": "展開 explode LATERAL FLATTEN", "featured": false, "related": ["variant", "json-null", "object-array"], "sql": "SELECT f.value::NUMBER AS item\nFROM TABLE(FLATTEN(INPUT => PARSE_JSON('[10,20,30]'))) AS f;"},
  {"id": "json-null", "title": "SQL NULL / JSON null", "ja": "SQLのNULLとJSONのnull", "meaning": "SQL上の欠損と、VARIANT内にあるJSONのnullは区別される。判定関数や変換時の挙動も異なる。", "example": "JSONで未設定・明示null・空文字を別々に扱う。", "note": "NULL、空文字、文字列「null」、存在しないキーを一律に同じ値として処理しない。", "sources": ["variant"], "tracks": ["C", "D"], "aliases": "IS_NULL_VALUE PARSE_JSON null", "featured": false, "related": ["variant", "flatten", "object-array"], "sql": "SELECT IS_NULL_VALUE(PARSE_JSON('null')) AS json_null,\n       PARSE_JSON('null') IS NULL AS sql_null;"},
  {"id": "try-cast", "title": "TRY_CAST / TRY_TO_*", "ja": "失敗時にNULLを返す変換", "meaning": "対応する型変換で、変換不能な値をエラーにせずNULLとして扱う関数群。", "example": "日付や数値が混在するCSVを検証する。", "note": "NULLになったことを成功と扱わない。元データの欠損と変換失敗を区別する。", "sources": ["numeric", "datetime"], "tracks": ["C", "D"], "aliases": "TRY_TO_DATE TRY_TO_NUMBER TRY_TO_TIMESTAMP", "featured": false, "related": ["load-validation", "schema-evolution"]},
  {"id": "qualify", "title": "QUALIFY", "ja": "ウィンドウ計算後の絞り込み", "meaning": "ウィンドウ関数を評価した結果で行を絞り込む句。サブクエリを減らして書ける。", "example": "ROW_NUMBERでキーごとの最新1行を残す。", "note": "WHEREやHAVINGと評価対象が異なる。順位を決めるORDER BYを明示する。", "sources": ["qualify"], "tracks": ["C", "D"], "aliases": "ROW_NUMBER 最新行 重複排除", "featured": true, "related": ["window-function", "cte"], "sql": "SELECT customer_id, event_at\nFROM events\nQUALIFY ROW_NUMBER() OVER (\n  PARTITION BY customer_id ORDER BY event_at DESC\n) = 1;\n-- 同時刻がある場合は、一意に決まる並び順を追加する。"},
  {"id": "window-function", "title": "Window functions", "ja": "ウィンドウ関数", "meaning": "行を残したまま、指定した区分と順序・範囲で集計や順位づけをする関数。", "example": "顧客別の累積売上や前回値との差を計算する。", "note": "GROUP BYの集約とは粒度が違う。暗黙のフレームや同順位行の扱いを確認する。", "sources": ["window"], "tracks": ["C", "D"], "aliases": "OVER PARTITION BY ROWS RANGE LAG LEAD", "featured": false, "related": ["qualify", "cte"], "sql": "SELECT sale_date, amount,\n       SUM(amount) OVER (ORDER BY sale_date\n         ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total\nFROM daily_sales;\n-- この例はsale_dateが一意であることを前提とする。"},
  {"id": "cte", "title": "CTE / recursive CTE", "ja": "共通テーブル式・再帰CTE", "meaning": "WITH句で名前付きの中間結果を定義する構文。再帰CTEは階層の探索等に使う。", "example": "組織階層や依存関係をたどる。", "note": "通常のCTEが永続テーブルとして保存されるわけではない。再帰では停止条件を設計する。", "sources": ["sql"], "tracks": ["D", "A"], "aliases": "WITH RECURSIVE 再帰", "featured": false, "related": ["qualify", "window-function"]},
  {"id": "asof-join", "title": "ASOF JOIN", "ja": "時刻に基づく近傍結合", "meaning": "条件を満たす最も近い時点の行を対応づける結合。時系列データの突合に使う。", "example": "取引時点で有効だった価格の行を対応づける。", "note": "同時刻の複数候補やキーの粒度を確認する。通常の完全一致JOINとは異なる。", "sources": ["asof"], "tracks": ["D", "X"], "aliases": "時系列結合 MATCH_CONDITION", "featured": false, "related": ["timestamp-types", "point-in-time"]},
  {"id": "pivot", "title": "PIVOT / UNPIVOT", "ja": "行列変換", "meaning": "カテゴリの値を列に広げる、または列を行へ戻す構文。分析用の形を整える。", "example": "月ごとの売上を横並びにする。", "note": "集約やNULLの扱いにより元データを完全に復元できるとは限らない。", "sources": ["pivot"], "tracks": ["C", "D"], "aliases": "ピボット アンピボット", "featured": false, "related": ["merge", "variant"]},
  {"id": "match-recognize", "title": "MATCH_RECOGNIZE", "ja": "行パターン認識", "meaning": "順序づけられた行の並びに対して、条件で定義したパターンを検索するSQL機能。", "example": "連続するイベントや状態遷移のパターンを探す。", "note": "文字列の正規表現そのものではなく、行の並びを対象にする。", "sources": ["match"], "tracks": ["D", "X"], "aliases": "PATTERN DEFINE 行パターン", "featured": false, "related": ["merge", "variant"]},
  {"id": "number-float", "title": "NUMBER / FLOAT", "ja": "固定小数点・浮動小数点", "meaning": "NUMBERは精度・スケールを指定する数値型、FLOATは近似的な浮動小数点型。計算要件で選ぶ。", "example": "厳密な小数計算が必要な金額に適した型を設計する。", "note": "FLOATの等値比較や丸め誤差に注意する。NUMBERでも定義した精度・スケールの限界がある。", "sources": ["numeric"], "tracks": ["C", "D"], "aliases": "DECIMAL NUMERIC precision scale", "featured": false, "related": ["merge", "variant"], "sql": "SELECT 1.25::NUMBER(10,2) AS fixed_point,\n       1.25::FLOAT AS floating_point;"},
  {"id": "timestamp-types", "title": "TIMESTAMP_NTZ / LTZ / TZ", "ja": "タイムスタンプの種類", "meaning": "タイムゾーンを持たない値、セッションのタイムゾーンに応じた表示、オフセットを保持する値を区別する型。", "example": "日本と欧州のログをUTC基準で突き合わせる。", "note": "TIMESTAMP_TZが地域名と将来の夏時間規則をそのまま保存するとは考えない。", "sources": ["datetime"], "tracks": ["C", "D", "A"], "aliases": "UTC JST TIMEZONE NTZ LTZ TZ", "featured": false, "related": ["asof-join", "point-in-time"]},
  {"id": "date-time", "title": "DATE / TIME / date functions", "ja": "日付・時刻と日付関数", "meaning": "日付、時刻、期間差、切り捨て等を扱う型と関数群。粒度やカレンダーの基準を明示する。", "example": "月初で売上をまとめ、営業日と経過日数を区別する。", "note": "週の開始曜日やタイムゾーン等のセッション設定で結果が変わり得る。", "sources": ["datetime", "query-tag"], "tracks": ["C", "D"], "aliases": "DATE_TRUNC DATEADD DATEDIFF CONVERT_TIMEZONE", "featured": false, "related": ["merge", "variant"]},
  {"id": "geography", "title": "GEOGRAPHY / GEOMETRY", "ja": "地理空間データ型", "meaning": "地球上の位置を扱うGEOGRAPHYと平面座標を扱うGEOMETRY。距離・交差・包含等の空間分析に使う。", "example": "店舗と顧客の位置関係を分析する。", "note": "座標系、単位、地球表面と平面の違いを無視して距離を比較しない。", "sources": ["geospatial"], "tracks": ["D", "X"], "aliases": "ST_DISTANCE ST_CONTAINS WKT WKB SRID H3", "featured": false, "related": ["merge", "variant"], "sql": "SELECT ST_DISTANCE(\n  TO_GEOGRAPHY('POINT(139.7671 35.6812)'),\n  TO_GEOGRAPHY('POINT(139.7630 35.6751)')\n) AS meters;"},
  {"id": "vector", "title": "VECTOR", "ja": "ベクトル型", "meaning": "決まった要素型と次元を持つベクトルを扱う型。埋め込みや類似度計算に使う。", "example": "文章の埋め込みベクトルを保存する。", "note": "VECTOR列を作るだけでCortex Searchサービスが構築されるわけではない。", "sources": ["vector"], "tracks": ["D", "X"], "aliases": "embedding cosine 次元", "featured": false, "related": ["ai-similarity", "ai-embed"]},
  {"id": "identifiers", "title": "Identifiers / case sensitivity", "ja": "識別子と大文字・小文字", "meaning": "オブジェクト名や列名の解釈規則。引用符なしと二重引用符ありで大文字・小文字等の扱いが異なる。", "example": "外部ツールで作った混在ケースの列名を正確に参照する。", "note": "文字列リテラルのシングルクォートと、識別子のダブルクォートを混同しない。", "sources": ["sql"], "tracks": ["C", "D"], "aliases": "double quotes case sensitive 名前", "featured": false, "related": ["session-context", "object-hierarchy"]},
  {"id": "result-scan", "title": "RESULT_SCAN", "ja": "実行済み結果の再参照", "meaning": "過去に実行したコマンド等の結果を表形式で再利用する関数。SHOW結果の分析などに使う。", "example": "SHOW TABLESの結果を絞り込む。", "note": "元データへ再問い合わせするのとは違う。結果保持期限と参照権限がある。", "sources": ["persisted"], "tracks": ["C", "D"], "aliases": "LAST_QUERY_ID RESULT_SCAN SHOW", "featured": false, "related": ["warehouse-cache", "result-cache"]}
]},
{"id": "performance", "title": "性能最適化・クエリ診断", "en": "PERFORMANCE & QUERY DIAGNOSTICS", "sections": ["performance-cost"], "description": "走査量・並列性・キャッシュ・待機を切り分け、対策を選ぶ。", "terms": [
  {"id": "pruning", "title": "Partition / column pruning", "ja": "読み取り対象の削減", "meaning": "条件に不要なマイクロパーティションや列を走査から除外する最適化。読み取り量削減の基本となる。", "example": "日付条件や必要列の指定で走査を絞る。", "note": "WHEREがあるだけで必ず十分に読み飛ばせるわけではない。条件式とデータの並びに依存する。", "sources": ["micro"], "tracks": ["C", "D", "A"], "aliases": "プルーニング pruning scan", "featured": true, "related": ["clustering-key", "search-optimization", "query-acceleration"]},
  {"id": "clustering-key", "title": "Clustering key", "ja": "クラスタリングキー", "meaning": "大きなテーブルのデータ配置を検索条件に合わせて整理するための列・式。読み飛ばしを改善する目的で選ぶ。", "example": "大規模な時系列表で日付や頻繁に絞る列を検討する。", "note": "一般的なB-treeインデックスとは別。高カーディナリティの列を無条件に指定しない。", "sources": ["clustering"], "tracks": ["C", "D", "A"], "aliases": "CLUSTER BY cardinality クラスタキー", "featured": false, "related": ["pruning", "search-optimization", "query-acceleration"]},
  {"id": "clustering-depth", "title": "Clustering depth / overlap", "ja": "クラスタリング深度・重なり", "meaning": "キーの値の範囲がマイクロパーティション間でどの程度重なるかを評価する指標。", "example": "配置が悪化した表のクラスタリング状態を調べる。", "note": "指標だけで最適化を決めず、実際のクエリと費用の変化で判断する。", "sources": ["clustering", "micro"], "tracks": ["D", "A"], "aliases": "SYSTEM$CLUSTERING_INFORMATION SYSTEM$CLUSTERING_DEPTH", "featured": false, "related": ["pruning", "search-optimization"]},
  {"id": "automatic-clustering", "title": "Automatic Clustering", "ja": "自動クラスタリング", "meaning": "定義されたクラスタリングキーに沿ってデータ配置を維持するサーバーレス機能。", "example": "継続更新される大規模表の読み飛ばし性能を維持する。", "note": "すべての表に自動でキーが設定されるわけではない。更新・履歴保存に追加費用が関わる。", "sources": ["auto-cluster"], "tracks": ["D", "A"], "aliases": "reclustering 再クラスタリング", "featured": false, "related": ["pruning", "search-optimization"]},
  {"id": "search-optimization", "title": "Search Optimization Service", "ja": "検索最適化サービス", "meaning": "対応する条件の選択性の高い検索を速めるため、追加の検索アクセスパスを管理するサービス。", "example": "大きな表から特定IDに対応する少数行を検索する。", "note": "Cortex Searchとは別。保持・メンテナンス費用と、対応する述語・型を確認する。", "sources": ["search-opt"], "tracks": ["C", "D", "A"], "aliases": "SOS 検索最適化 point lookup", "featured": true, "related": ["pruning", "clustering-key", "query-acceleration", "cortex-search", "ai-embed"]},
  {"id": "result-cache", "title": "Persisted result cache", "ja": "永続化されたクエリ結果", "meaning": "条件を満たす再実行で、以前のクエリ結果を再利用する仕組み。計算を省ける場合がある。", "example": "同じSQLを、元データに変更がない状態で再実行する。", "note": "同じ意味のSQLなら常に再利用できるわけではない。権限・式・データ変更等の条件がある。", "sources": ["persisted"], "tracks": ["C", "D", "A"], "aliases": "USE_CACHED_RESULT 結果キャッシュ", "featured": true, "related": ["warehouse-cache", "result-scan"]},
  {"id": "query-profile", "title": "Query Profile", "ja": "クエリプロファイル", "meaning": "SQLの実行を演算子単位で見て、時間、行数、走査、スピル等を調べるための情報。", "example": "最も時間を使うJOINやTableScanを探す。", "note": "クエリ全体の時間と各演算子の時間の関係を確認し、単純加算で解釈しない。", "sources": ["profile"], "tracks": ["C", "D", "A"], "aliases": "プロファイル bottleneck operator", "featured": false, "related": ["spill", "join-explosion"]},
  {"id": "spill", "title": "Local / remote spilling", "ja": "ローカル・リモートへのスピル", "meaning": "処理に必要なデータがメモリーに収まらず、ディスクやリモートストレージへ退避される状態。", "example": "大規模ソートや結合の遅さを調べる。", "note": "サイズ変更だけでなく、処理行数、結合条件、不要列の削減も検討する。", "sources": ["profile", "performance"], "tracks": ["D", "A"], "aliases": "BYTES_SPILLED_TO_LOCAL_STORAGE BYTES_SPILLED_TO_REMOTE_STORAGE", "featured": false, "related": ["query-profile", "join-explosion"]},
  {"id": "join-explosion", "title": "Join explosion / data skew", "ja": "結合による行数膨張・偏り", "meaning": "多対多結合等による中間行数の急増や、一部キーへのデータ集中。性能と結果の正しさの両方に影響する。", "example": "顧客IDの重複で売上行が増えていないか確認する。", "note": "ウェアハウスを大きくする前に、データの粒度とJOIN条件を点検する。", "sources": ["profile"], "tracks": ["D", "A"], "aliases": "Cartesian join exploding join skew", "featured": false, "related": ["query-profile", "spill"]},
  {"id": "query-insights", "title": "Query insights", "ja": "クエリ改善のヒント", "meaning": "実行状況から問題や改善候補を把握するための診断情報。プロファイルと併せて使う。", "example": "非効率な結合や走査の候補を見つける。", "note": "ヒントが全処理の最適解を保証するわけではない。対象SQLの実測が必要。", "sources": ["performance", "profile"], "tracks": ["D", "A"], "aliases": "insights recommendation 診断", "featured": false, "related": ["pruning", "search-optimization"]},
  {"id": "query-attribution", "title": "Query cost attribution", "ja": "クエリ別の計算費用分析", "meaning": "クエリに帰属する計算利用量等を使って、処理別の費用を分析する観点。", "example": "高コストSQLを探し、QUERY_TAGと合わせて用途別に集計する。", "note": "アイドル時間や別サービス費用を含む請求総額と、クエリ帰属費用は一致しない場合がある。", "sources": ["account-usage", "cost"], "tracks": ["D", "A"], "aliases": "QUERY_ATTRIBUTION_HISTORY query cost", "featured": false, "related": ["resource-monitor", "budget", "cost-attribution"]},
  {"id": "optimization-choice", "title": "Optimization trade-offs", "ja": "最適化手段の使い分け", "meaning": "サイズ、クラスター数、クラスタリング、検索最適化、MV、QAS等をボトルネック別に比較する設計観点。", "example": "単一SQLが遅いのか、同時実行が多いのかを先に分ける。", "note": "すべての最適化を有効にすると費用や更新負荷が増える。導入前後で測定する。", "sources": ["performance"], "tracks": ["C", "D", "A"], "aliases": "tuning チューニング 最適化", "featured": false, "related": ["pruning", "search-optimization"]}
]},
{"id": "operations", "title": "費用・監視・運用", "en": "COST & OBSERVABILITY", "sections": ["performance-cost"], "description": "利用量と請求を分けて理解し、監視・通知・制御へつなぐ。", "terms": [
  {"id": "credits", "title": "Credits / consumption", "ja": "クレジットと消費量", "meaning": "Snowflakeの計算サービス等の使用を表す単位。クレジット量と通貨での請求額を分けて見る。", "example": "処理時間とクレジットを比較して効率を測る。", "note": "単価は契約、エディション、リージョン等に依存する。すべての費用がクレジット課金ではない。", "sources": ["cost"], "tracks": ["C", "D", "A"], "aliases": "credit クレジット 課金", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "billing-components", "title": "Compute / storage / transfer costs", "ja": "計算・保存・転送費用", "meaning": "ウェアハウスや各種サービスの計算、データ保存、データ転送等から費用を分解する見方。", "example": "ウェアハウス停止後にも続く費用の原因を調べる。", "note": "「操作していない」ことと「利用資源がない」ことは同じではない。自動更新や稼働中アプリも確認する。", "sources": ["cost"], "tracks": ["C", "D", "A"], "aliases": "課金 内訳 storage egress", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "resource-monitor", "title": "Resource monitor", "ja": "リソースモニター", "meaning": "ウェアハウスのクレジット利用を監視し、しきい値で通知や停止を行う仕組み。", "example": "検証用ウェアハウスで消費超過を検知する。", "note": "Snowpipe等すべてのサーバーレス費用を停止する万能な上限機能ではない。", "sources": ["resource-monitor"], "tracks": ["C", "D", "A"], "aliases": "quota suspend notify RESOURCE MONITOR", "featured": true, "related": ["serverless", "serverless-task", "budget", "cost-attribution", "query-attribution"]},
  {"id": "budget", "title": "Budget", "ja": "予算", "meaning": "対応するオブジェクトやサービスのクレジット利用を監視し、予測・通知等を行う機能。", "example": "サーバーレスを含む対象の費用見込みを確認する。", "note": "予算を設定するだけで全費用が厳密な金額で停止するわけではない。対応サービスとアクションを確認する。", "sources": ["budgets"], "tracks": ["C", "D", "A"], "aliases": "SNOWFLAKE.CORE.BUDGET 予算予測", "featured": true, "related": ["serverless", "serverless-task", "resource-monitor", "cost-attribution", "query-attribution"]},
  {"id": "account-usage", "title": "ACCOUNT_USAGE", "ja": "アカウント利用履歴", "meaning": "アカウント内のオブジェクト・クエリ・費用等の履歴を提供するSNOWFLAKEデータベースのスキーマ。", "example": "長めの期間で利用量や実行傾向を分析する。", "note": "ビューごとに遅延、保持期間、必要権限が異なる。即時監視と同一視しない。", "sources": ["account-usage"], "tracks": ["C", "D", "A"], "aliases": "SNOWFLAKE.ACCOUNT_USAGE 運用ビュー", "featured": false, "related": ["information-schema", "query-history"], "sql": "SELECT *\nFROM SNOWFLAKE.ACCOUNT_USAGE.WAREHOUSE_METERING_HISTORY\nWHERE start_time >= DATEADD(day, -1, CURRENT_TIMESTAMP())\nLIMIT 20;\n-- 参照権限とビューの反映遅延を確認する。"},
  {"id": "information-schema", "title": "INFORMATION_SCHEMA", "ja": "情報スキーマ", "meaning": "データベースのメタデータ等を問い合わせる標準的なスキーマと関連テーブル関数。", "example": "表の列定義やオブジェクト一覧を取得する。", "note": "ACCOUNT_USAGEと対象範囲・履歴・遅延が異なる。現在のロールで見える情報にも依存する。", "sources": ["information-schema"], "tracks": ["C", "D", "A"], "aliases": "情報スキーマ COLUMNS TABLES", "featured": false, "related": ["account-usage", "query-history"]},
  {"id": "query-history", "title": "QUERY_HISTORY", "ja": "クエリ履歴", "meaning": "SQLの実行時刻、状態、実行時間、待機、読み取り量等を調べる情報。", "example": "失敗SQLや高負荷の時間帯を探す。", "note": "SQL文字列に機密情報を埋め込むと履歴に残り得る。アクセス権も管理する。", "sources": ["query-history"], "tracks": ["C", "D", "A"], "aliases": "QUERY_ID EXECUTION_STATUS query log", "featured": false, "related": ["account-usage", "information-schema"], "sql": "SELECT query_id, query_text, total_elapsed_time\nFROM TABLE(INFORMATION_SCHEMA.QUERY_HISTORY())\nORDER BY start_time DESC\nLIMIT 10;\n-- 閲覧できる履歴は実行ロール等の条件に依存する。"},
  {"id": "query-tag", "title": "QUERY_TAG", "ja": "クエリタグ", "meaning": "クエリに用途やアプリケーション等の識別情報を付けるパラメーター。運用分析や費用集計に使う。", "example": "パイプライン名・実行IDを付けて追跡する。", "note": "オブジェクトタグとは別。機密値そのものをタグに保存しない。", "sources": ["query-tag"], "tracks": ["D", "A"], "aliases": "query tag タグ セッションパラメータ", "featured": false, "related": ["resource-monitor", "budget"], "sql": "ALTER SESSION SET QUERY_TAG = 'learning:sample';\nSELECT CURRENT_TIMESTAMP();\nALTER SESSION UNSET QUERY_TAG;\n-- セッション設定を変更する例。共有接続では運用に注意する。"},
  {"id": "metering-history", "title": "Metering / warehouse load history", "ja": "利用計測・ウェアハウス負荷履歴", "meaning": "利用量と稼働・混雑の履歴を使い、請求や待ち時間を分析する機能群。", "example": "アイドル稼働とクエリ混雑の時間帯を切り分ける。", "note": "異なる履歴ビューの時間粒度や更新遅延をそろえて比較する。", "sources": ["account-usage", "cost"], "tracks": ["D", "A"], "aliases": "METERING_HISTORY WAREHOUSE_METERING_HISTORY WAREHOUSE_LOAD_HISTORY", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "alert", "title": "Alert", "ja": "アラート", "meaning": "条件を評価し、満たされた場合にアクションを実行するオブジェクト。データや運用上の異常検知に使う。", "example": "データ到着遅延や異常な件数を検知する。", "note": "Taskと同じものではない。実行方式・スケジュール・通知連携の設定が必要。", "sources": ["alerts"], "tracks": ["D", "A"], "aliases": "CREATE ALERT alert", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "notification", "title": "Notification integration", "ja": "通知統合", "meaning": "メール、クラウドのメッセージサービス、Webhook等の対応する通知先を管理する統合オブジェクト。", "example": "パイプライン失敗や予算超過を通知する。", "note": "通知経路を作っただけで任意のエラーが自動通知されるわけではない。送信側の連携設定も必要。", "sources": ["notification"], "tracks": ["D", "A"], "aliases": "email webhook 通知 integration", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "event-table", "title": "Event table / telemetry", "ja": "イベントテーブルとテレメトリー", "meaning": "ハンドラーや対応サービスのログ、トレース、メトリクス等を収集・分析するためのテーブル。", "example": "Pythonプロシージャのエラーや処理段階を追う。", "note": "QUERY_HISTORYとは観測対象が違う。詳細ログの量・費用・機密情報に注意する。", "sources": ["procedure", "account-usage"], "tracks": ["D", "A"], "aliases": "logging tracing OpenTelemetry ログ", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "release-bcr", "title": "Release notes / behavior change bundle", "ja": "リリースと動作変更バンドル", "meaning": "機能追加や既存動作への変更を把握する情報と、その適用を管理する仕組み。", "example": "依存するSQLや認証方式への変更を事前に検証する。", "note": "新機能の追加と互換性に影響する変更は分けて確認する。", "sources": ["architecture"], "tracks": ["D", "A"], "aliases": "BCR BCB リリースノート behavior change", "featured": false, "related": ["resource-monitor", "budget"]},
  {"id": "cost-attribution", "title": "Cost attribution / chargeback", "ja": "費用配賦と可視化", "meaning": "ウェアハウス、処理、チーム等へ利用量を対応付ける運用の考え方。", "example": "チーム別の計算利用をQuery Tagや利用履歴で確認する。", "note": "クエリ別の利用量だけでは待機資源や全サービス費用を説明できない。集計範囲を明示する。", "sources": ["cost", "account-usage"], "tracks": ["D", "A"], "aliases": "showback chargeback FinOps 配賦", "featured": false, "related": ["resource-monitor", "budget", "query-attribution"]}
]},
{"id": "security", "title": "権限・認証・ネットワーク", "en": "IDENTITY, ACCESS & NETWORK", "sections": ["security-governance"], "description": "誰が、どの権限で、どこから接続できるかを設計する。", "terms": [
  {"id": "rbac", "title": "RBAC", "ja": "ロールベースアクセス制御", "meaning": "権限をロールにまとめ、ユーザーや上位ロールへ付与してアクセスを管理する方式。Snowflakeの権限設計の中心となる。", "example": "読取、更新、運用を別ロールに分ける。", "note": "ロール付与だけでなく、実行時の有効ロールとオブジェクト階層の権限を確認する。", "sources": ["access"], "tracks": ["C", "D", "A"], "aliases": "Role-Based Access Control RBAC", "featured": true, "related": ["account-role", "database-role", "role-hierarchy"], "sql": "SHOW GRANTS TO ROLE analyst_role;\n-- analyst_roleは例示用。対象ロール名へ置き換える。"},
  {"id": "account-role", "title": "Account role", "ja": "アカウントロール", "meaning": "アカウント内の権限をまとめ、ユーザーへ割り当てたりロール階層に組み込んだりするロール。", "example": "分析者に必要な複数データベースの権限を束ねる。", "note": "Database Roleとスコープが異なる。作業用に管理者権限を常用しない。", "sources": ["access"], "tracks": ["C", "D", "A"], "aliases": "CREATE ROLE role", "featured": false, "related": ["rbac", "database-role", "role-hierarchy"]},
  {"id": "database-role", "title": "Database role", "ja": "データベースロール", "meaning": "一つのデータベース内の権限を整理するロール。アカウントロールに付与して利用する等の設計に使う。", "example": "製品データベースごとに読取ロールを用意する。", "note": "アカウントロールと同様に直接セッションで有効化できるとは考えない。", "sources": ["access"], "tracks": ["C", "D", "A"], "aliases": "CREATE DATABASE ROLE", "featured": false, "related": ["rbac", "account-role", "role-hierarchy"]},
  {"id": "role-hierarchy", "title": "Role hierarchy / inheritance", "ja": "ロール階層と継承", "meaning": "ロールを他のロールへ付与し、権限を継承させる構造。業務ロールとアクセスロールを分離して設計する。", "example": "表単位のアクセス権を業務ロールへまとめる。", "note": "親子の向きを誤ると意図しない権限が広がる。循環と管理者権限の扱いに注意する。", "sources": ["access", "access-config"], "tracks": ["C", "D", "A"], "aliases": "inheritance GRANT ROLE 継承", "featured": false, "related": ["rbac", "account-role", "database-role"]},
  {"id": "system-roles", "title": "System-defined roles", "ja": "システム定義ロール", "meaning": "ACCOUNTADMIN、SECURITYADMIN、SYSADMIN、USERADMIN、PUBLIC等の組み込みロール。役割が異なる。", "example": "ユーザー管理とオブジェクト管理を分離する。", "note": "SYSADMINが必ずすべての表を読めると考えない。カスタムロールの継承と所有権設計による。", "sources": ["access"], "tracks": ["C", "D", "A"], "aliases": "ACCOUNTADMIN SECURITYADMIN SYSADMIN USERADMIN PUBLIC", "featured": false, "related": ["rbac"]},
  {"id": "ownership", "title": "OWNERSHIP / MANAGE GRANTS", "ja": "所有権と権限管理", "meaning": "オブジェクトを所有する権限と、権限付与を管理する権限を区別する考え方。所有権移譲も設計対象。", "example": "退職者が作成したオブジェクトの管理責任を移す。", "note": "オブジェクトを参照できること、変更できること、権限を付与できることは同義ではない。", "sources": ["access-priv", "access-config"], "tracks": ["C", "D", "A"], "aliases": "GRANT OWNERSHIP COPY CURRENT GRANTS", "featured": false, "related": ["future-grants", "managed-access"]},
  {"id": "usage-select", "title": "USAGE / SELECT privileges", "ja": "利用権限と読取権限", "meaning": "コンテナや計算資源を使う権限と、表のデータを読む権限。通常は必要な階層の権限を組み合わせる。", "example": "DB・Schema・Warehouseの利用権限とTableのSELECTを確認する。", "note": "SELECTだけで実行に必要な権限が必ずそろうわけではない。", "sources": ["access-priv"], "tracks": ["C", "D"], "aliases": "USAGE SELECT grant", "featured": false, "related": ["rbac"]},
  {"id": "future-grants", "title": "Future grants", "ja": "将来オブジェクトへの権限付与", "meaning": "今後作成される対象オブジェクトに権限を自動付与する設定。新規表の追加時の運用を標準化する。", "example": "新しいMARTテーブルを読取ロールから利用できるようにする。", "note": "既存オブジェクトへの一括付与とは別。データベースとスキーマでの優先関係も確認する。", "sources": ["access-config"], "tracks": ["C", "D", "A"], "aliases": "ON FUTURE TABLES 未来権限", "featured": false, "related": ["ownership", "managed-access"]},
  {"id": "managed-access", "title": "Managed access schema", "ja": "管理アクセススキーマ", "meaning": "スキーマ内のオブジェクトの権限管理を集中させるスキーマ。個別所有者による分散したGRANTを抑える。", "example": "データ製品のアクセス付与を管理担当へ集約する。", "note": "表の所有者が通常スキーマと同じように権限付与できるとは限らない。", "sources": ["access"], "tracks": ["D", "A"], "aliases": "WITH MANAGED ACCESS", "featured": false, "related": ["ownership", "future-grants"]},
  {"id": "secondary-roles", "title": "Primary / secondary roles", "ja": "プライマリ・セカンダリロール", "meaning": "セッションの主ロールと、追加で有効にするロール群。操作時の権限評価に関わる。", "example": "複数の業務ロールの読取権限を組み合わせる。", "note": "オブジェクト作成時の所有権等は別途確認する。有効なロールと付与済みロールを混同しない。", "sources": ["access"], "tracks": ["D", "A"], "aliases": "USE SECONDARY ROLES ALL CURRENT_SECONDARY_ROLES", "featured": false, "related": ["rbac"]},
  {"id": "mfa", "title": "MFA", "ja": "多要素認証", "meaning": "パスワード等に加え別の要素で本人確認する仕組み。人間のユーザーの認証保護に使う。", "example": "対話的ログインのアカウント乗っ取りリスクを下げる。", "note": "適用要件や対応方法は更新される。サービスユーザーの認証方式とは分けて設計する。", "sources": ["mfa"], "tracks": ["C", "A"], "aliases": "multi-factor authentication 多要素", "featured": false, "related": ["rbac"]},
  {"id": "sso", "title": "Federated authentication / SSO", "ja": "フェデレーション認証・SSO", "meaning": "外部のIDプロバイダーと連携し、組織の認証基盤からSnowflakeへログインする仕組み。", "example": "企業のIdPでユーザー認証を統一する。", "note": "認証できることとデータへの権限があることは別。SCIMのユーザー同期とも役割が違う。", "sources": ["sso"], "tracks": ["C", "A"], "aliases": "SAML IdP single sign-on", "featured": false, "related": ["rbac"]},
  {"id": "key-pair", "title": "Key-pair authentication", "ja": "鍵ペア認証", "meaning": "秘密鍵で署名し、ユーザーに設定した公開鍵で検証する認証方式。機械的な接続等に使われる。", "example": "パスワードを埋め込まないバッチ接続を構成する。", "note": "秘密鍵は安全に保管しローテーションする。鍵を使えば権限管理が不要になるわけではない。", "sources": ["keypair"], "tracks": ["C", "D", "A"], "aliases": "RSA JWT public private key", "featured": false, "related": ["oauth", "workload-identity", "least-privilege"]},
  {"id": "oauth", "title": "OAuth", "ja": "OAuthによる認可連携", "meaning": "トークンを使い、外部アプリケーションからの接続や権限委譲を行う仕組み。Snowflake OAuthとExternal OAuth等を区別する。", "example": "BIツールをユーザーの権限に応じて接続する。", "note": "SAML SSOと同じ方式ではない。トークンの発行元・有効期限・ロール制約を確認する。", "sources": ["oauth"], "tracks": ["C", "D", "A"], "aliases": "External OAuth Snowflake OAuth token", "featured": false, "related": ["key-pair", "workload-identity", "least-privilege"]},
  {"id": "scim", "title": "SCIM", "ja": "ユーザー・グループの自動管理", "meaning": "IDプロバイダーからユーザーやグループの作成・変更を同期するための標準と連携機能。", "example": "入社・異動・退職に伴うアカウント管理を自動化する。", "note": "SCIM自体がログイン時の認証を行うわけではない。同期対象と削除時の挙動を確認する。", "sources": ["scim"], "tracks": ["A"], "aliases": "provisioning deprovisioning プロビジョニング", "featured": false, "related": ["rbac"]},
  {"id": "workload-identity", "title": "Workload identity federation", "ja": "ワークロードID連携", "meaning": "外部クラウド等が発行する短期IDを使い、長期シークレット管理を減らしてSnowflakeへ認証する仕組み。", "example": "クラウド上のジョブを実行環境のIDで接続する。", "note": "対応プロバイダー、ドライバー、サービスユーザー等の条件がある。どの環境でも自動利用できるわけではない。", "sources": ["wif"], "tracks": ["D", "A", "X"], "aliases": "WIF identity federation OIDC", "featured": false, "related": ["key-pair", "oauth", "least-privilege"]},
  {"id": "network-policy", "title": "Network policy", "ja": "ネットワークポリシー", "meaning": "接続元のネットワークを許可・制限するためのポリシー。対象ユーザーやアカウントへの適用を管理する。", "example": "社内や承認された経路からの接続に限定する。", "note": "データの行・列を制御するポリシーではない。適用の優先順位と管理者の接続経路も確認する。", "sources": ["network"], "tracks": ["C", "D", "A"], "aliases": "IP allowlist blocklist ネットワーク", "featured": false, "related": ["network-rule", "private-connectivity"]},
  {"id": "network-rule", "title": "Network rule", "ja": "ネットワークルール", "meaning": "IPやドメイン等のネットワーク識別子をまとめるオブジェクト。ポリシーや外部アクセス統合等から利用される。", "example": "アプリの外部接続先を許可リストとして管理する。", "note": "ルールを作っただけで接続制限が適用されるわけではない。方向と使用先を確認する。", "sources": ["network-rule"], "tracks": ["D", "A"], "aliases": "INGRESS EGRESS HOST_PORT", "featured": false, "related": ["network-policy", "private-connectivity"]},
  {"id": "private-connectivity", "title": "Private connectivity", "ja": "プライベート接続", "meaning": "対応クラウドのプライベート経路でSnowflake等へ接続する仕組み。ネットワーク要件から利用を検討する。", "example": "公開インターネットを避けた接続経路を構成する。", "note": "利用エディション、DNS、エンドポイント、接続対象別の設定を確認する。認証・認可は別途必要。", "sources": ["private"], "tracks": ["C", "A"], "aliases": "AWS PrivateLink Azure Private Link PSC", "featured": false, "related": ["network-policy", "network-rule"]},
  {"id": "encryption", "title": "Encryption / Tri-Secret Secure", "ja": "暗号化・Tri-Secret Secure", "meaning": "保存時・通信時の暗号化と鍵管理。Tri-Secret Secureでは顧客管理鍵を組み合わせる保護を提供する。", "example": "顧客管理鍵の要件を満たす構成を検討する。", "note": "マスキングとは別。鍵を利用不能にしたときの影響、復旧手順、利用条件を確認する。", "sources": ["encryption", "trisecret"], "tracks": ["C", "A"], "aliases": "CMK KMS TLS customer-managed key", "featured": false, "related": ["rbac"]},
  {"id": "authentication-policy", "title": "Authentication policy / session policy", "ja": "認証ポリシー・セッションポリシー", "meaning": "許可する認証方式やセッションの条件を、対応するポリシーで制御する仕組み。", "example": "サービス用ユーザーと対話利用者で認証条件を分ける。", "note": "Network Policyは接続元、認証ポリシーは認証条件という違いがある。接続不能に備えて段階的に適用する。", "sources": ["authentication-policy", "session-policy"], "tracks": ["C", "A"], "aliases": "AUTHENTICATION POLICY SESSION POLICY idle timeout", "featured": false, "related": ["rbac"]},
  {"id": "least-privilege", "title": "Least privilege / service user", "ja": "最小権限とサービス用ユーザー", "meaning": "必要な操作だけを許可し、人の操作とプログラムの実行主体を分ける設計。", "example": "バッチ用ユーザーに対象データと実行資源だけを許可する。", "note": "ユーザー種別と認証方式を確認する。管理者権限の共有や資格情報のコード埋め込みを避ける。", "sources": ["access", "keypair", "wif"], "tracks": ["C", "D", "A"], "aliases": "SERVICE PERSON LEGACY_SERVICE 最小権限", "featured": false, "related": ["key-pair", "oauth", "workload-identity"]}
]},
{"id": "governance", "title": "ガバナンス・品質・プライバシー", "en": "GOVERNANCE & DATA QUALITY", "sections": ["security-governance"], "description": "機密性、利用条件、来歴、品質をデータと一緒に管理する。", "terms": [
  {"id": "horizon", "title": "Snowflake Horizon Catalog", "ja": "Horizon Catalog", "meaning": "データの発見、メタデータ、ガバナンス等を扱う機能群の総称。保護や品質、来歴の理解につなげる。", "example": "どこにどのデータがあり、どう管理されるかを把握する。", "note": "単一のSQLオブジェクトやOpen Catalogの別名ではない。", "sources": ["horizon"], "tracks": ["C", "A", "X"], "aliases": "Horizon カタログ", "featured": false, "related": ["lineage", "access-history"]},
  {"id": "object-tag", "title": "Object tagging", "ja": "オブジェクトタグ", "meaning": "キーと値でオブジェクトの属性を付け、分類や管理に使う仕組み。", "example": "機密区分や担当部署を表・列に付ける。", "note": "タグを付けるだけでデータがマスクされたりアクセス拒否されたりするわけではない。", "sources": ["tags"], "tracks": ["C", "D", "A"], "aliases": "TAG 機密分類 タグ", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "masking-policy", "title": "Masking policy", "ja": "マスキングポリシー", "meaning": "列を問い合わせる際、実行コンテキスト等に応じて返す値を変えるポリシー。", "example": "権限のない利用者にはメールアドレスを伏せて表示する。", "note": "保存データ自体の削除・置換やネットワーク制限とは別。管理権限と適用権限も確認する。", "sources": ["masking"], "tracks": ["C", "D", "A"], "aliases": "Dynamic Data Masking DDM 動的マスキング", "featured": true, "related": ["row-access-policy", "tag-based-masking"]},
  {"id": "tag-based-masking", "title": "Tag-based masking", "ja": "タグベースのマスキング", "meaning": "タグに関連づけたポリシーを使い、対象列へ一貫したマスキングを適用する仕組み。", "example": "機密区分タグを基に保護を展開する。", "note": "ポリシーの型、直接適用との関係、タグの継承・伝播条件を確認する。", "sources": ["masking", "tags"], "tracks": ["D", "A"], "aliases": "tag masking タグ連動", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "row-access-policy", "title": "Row access policy", "ja": "行アクセスポリシー", "meaning": "条件に応じて利用者が参照できる行を制限するポリシー。地域や組織別の閲覧制御等に使う。", "example": "担当する国のデータだけを表示する。", "note": "列の値を変えるマスキングとは別。ポリシー評価の権限と参照テーブルを設計する。", "sources": ["row-access"], "tracks": ["C", "D", "A"], "aliases": "RAP row level security RLS", "featured": true, "related": ["masking-policy", "tag-based-masking"]},
  {"id": "classification", "title": "Sensitive data classification", "ja": "機密データ分類", "meaning": "列の内容等から機密性のカテゴリを識別し、ガバナンスへつなげる機能。", "example": "個人情報を含む可能性のある列を検出する。", "note": "分類結果が正しいとは限らず、検証が必要。分類とアクセス制御の実施は別工程。", "sources": ["classification"], "tracks": ["C", "D", "A"], "aliases": "PII semantic category privacy category", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "access-history", "title": "Access History", "ja": "データアクセス履歴", "meaning": "どのオブジェクト・列等がアクセスされたかを分析する履歴。監査や影響分析の材料になる。", "example": "特定の機密列がどの処理で参照されたかを調べる。", "note": "すべての監査要件を単一ビューだけで満たせるとは限らない。提供条件・遅延・保持を確認する。", "sources": ["access-history"], "tracks": ["D", "A"], "aliases": "ACCESS_HISTORY base_objects_accessed", "featured": false, "related": ["horizon", "lineage"]},
  {"id": "lineage", "title": "Data lineage / object dependencies", "ja": "データリネージと依存関係", "meaning": "データの生成元・加工先やオブジェクト間の依存関係を把握する仕組み。", "example": "列変更の前に影響を受ける表やビューを確認する。", "note": "すべての外部処理や動的SQLまで完全に自動追跡されるとは考えない。", "sources": ["lineage", "access-history"], "tracks": ["D", "A"], "aliases": "リネージ 血統 OBJECT_DEPENDENCIES", "featured": false, "related": ["horizon", "access-history"]},
  {"id": "data-metric-function", "title": "Data metric function", "ja": "データメトリック関数", "meaning": "NULL数、重複数、鮮度等の品質指標を計算する関数。スケジュール監視や独自チェックに使う。", "example": "主キー候補の重複や入力遅延を監視する。", "note": "品質を測ることと不正レコードの登録を自動防止することは別。", "sources": ["quality"], "tracks": ["D", "A"], "aliases": "DMF DATA METRIC FUNCTION NULL_COUNT DUPLICATE_COUNT", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "quality-expectation", "title": "Data quality expectation", "ja": "データ品質の期待条件", "meaning": "計測された品質指標が満たすべき条件を設定し、違反を検出する考え方・機能。", "example": "重複件数が0であることを継続監視する。", "note": "ビジネス上許容される値を設計する必要がある。しきい値の設定だけで品質が修復されるわけではない。", "sources": ["quality"], "tracks": ["D", "A"], "aliases": "expectation 品質チェック", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "aggregation-policy", "title": "Aggregation policy", "ja": "集約ポリシー", "meaning": "一定の集約条件等を満たす分析に利用を制限し、個々のレコードの露出を抑えるポリシー。", "example": "一定数以上のグループ単位でのみ分析を許可する。", "note": "どのような推論攻撃も完全に防げるという意味ではない。許可条件と他の制御を確認する。", "sources": ["aggregation"], "tracks": ["A"], "aliases": "privacy minimum group size", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "projection-policy", "title": "Projection policy", "ja": "プロジェクションポリシー", "meaning": "列の値をクエリの結果へ直接出力できるかを制御するポリシー。", "example": "結合キーとして利用しても、その値の出力は制限する。", "note": "マスキングや行フィルターとは別。対応するクエリでの利用規則を確認する。", "sources": ["projection"], "tracks": ["A"], "aliases": "列出力 projection", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "join-policy", "title": "Join policy", "ja": "結合ポリシー", "meaning": "保護対象のデータへのクエリについて、結合の要否や許可された結合条件等を制御する仕組み。", "example": "承認されたキーでの結合を前提にデータを利用させる。", "note": "PK/FKの整合性検証ではない。サポートするJOINと例外条件を確認する。", "sources": ["join-policy"], "tracks": ["A", "X"], "aliases": "join constraint allowed join keys", "featured": false, "related": ["masking-policy", "row-access-policy"]},
  {"id": "secure-udf", "title": "Secure UDF / secure objects", "ja": "セキュアな関数・オブジェクト", "meaning": "定義の露出や評価時の情報漏えいを抑えるためにSECURE指定を使う機能。", "example": "内部ロジックを公開せず計算機能を提供する。", "note": "SECUREはすべての業務上の秘匿を自動で保証する印ではない。返す情報そのものも設計する。", "sources": ["udf", "secure-view"], "tracks": ["D", "A"], "aliases": "SECURE FUNCTION privacy", "featured": false, "related": ["masking-policy", "row-access-policy"]}
]},
{"id": "sharing", "title": "共有・カタログ・外部連携", "en": "SHARING, CATALOGS & INTEGRATION", "sections": ["sharing-integration"], "description": "コピーしない共有と、データ移動・カタログ連携の境界を理解する。", "terms": [
  {"id": "secure-sharing", "title": "Secure Data Sharing", "ja": "セキュアデータ共有", "meaning": "対応するデータベースオブジェクトを別アカウントへ共有し、同一リージョン等の条件下でデータコピーなしに参照させる仕組み。", "example": "取引先へ必要なデータを提供する。", "note": "すべてのクラウド・リージョン間で無転送という意味ではない。消費側の計算費用等も確認する。", "sources": ["sharing"], "tracks": ["C", "D", "A"], "aliases": "share データ共有 zero copy", "featured": true, "related": ["listing", "replication"]},
