  { title:'Stream ↔ Task ↔ Dynamic Table', text:'変更の追跡、手続きの実行、宣言した結果の維持。責務が違う。', ids:['stream','task','dynamic-table'] },
  { title:'View ↔ Materialized View', text:'SQL定義を参照するか、結果を保持するか。更新と保存の費用も変わる。', ids:['view','materialized-view','dynamic-table'] },
  { title:'Time Travel ↔ Fail-safe ↔ Replication', text:'利用者の履歴操作、最後の復旧保護、別環境への複製は別の仕組み。', ids:['time-travel','fail-safe','replication'] },
  { title:'Permanent ↔ Transient ↔ Temporary', text:'存続期間と復旧保護を、データの再作成可能性から選ぶ。', ids:['permanent-table','transient-table','temporary-table'] },
  { title:'Resource Monitor ↔ Budget', text:'対象資源の監視・停止と、広い利用範囲の予算管理を混同しない。', ids:['resource-monitor','budget'] },
  { title:'Standard ↔ Iceberg ↔ Hybrid', text:'分析、オープン形式、低遅延の読み書き。保存方式と制約から選ぶ。', ids:['standard-table','iceberg-table','hybrid-table'] },
  { title:'Masking ↔ Row Access', text:'見える値を変えるか、見える行を制限するか。ロール設計と組み合わせる。', ids:['masking-policy','row-access-policy','rbac'] },
  { title:'Snowpark ↔ Container Services', text:'APIでデータ処理を記述することと、コンテナーを稼働させることは別。', ids:['snowpark','container-services','compute-pool'] },
  { title:'Search Optimization ↔ Cortex Search', text:'分析SQLの選択性の高い検索を速める機能と、AIアプリ向け検索サービスの違い。', ids:['search-optimization','cortex-search','cortex-analyst'] },
];
const searchIndex = (term: Term, group: Group) => [term.title, term.ja, term.aliases, term.meaning, term.example, term.note, group.title, group.en].join(' ');
---

<BaseLayout title={`${title} | Snowflake | Seiji Tech Atlas`} description={`Snowflakeの${allTerms.length}用語・機能を、意味・用途・注意点・公式資料で整理する学習辞典。`}>
  <main class="sf-page">
    <a class="sf-back" href={route('topics/snowflake/')}>← Back to Snowflake</a>
    <header class="sf-hero">
      <div class="sf-hero-copy">
        <p class="sf-eyebrow">SNOWFLAKE / {eyebrow}</p>
        <h1>{title}<span class="sf-dot">.</span></h1>
        <p class="sf-lead">{guide.lead}</p>
        <div class="sf-meta">
          {code && <code>{code}</code>}
          <span>SHARED KNOWLEDGE BASE</span>
          {official && <a href={official} target="_blank" rel="noopener noreferrer">資格の公式情報 ↗</a>}
        </div>
        <a class="sf-primary" href="#snowflake-glossary">用語・機能を調べる <span aria-hidden="true">↓</span></a>
      </div>
      <aside class="sf-hero-card" aria-label="辞典の収録情報">
        <div class="sf-card-top"><span>SNOWFLAKE FIELD GUIDE</span><span aria-hidden="true">✳</span></div>
        <div class="sf-big-number">{allTerms.length}<small>TERMS & CONCEPTS</small></div>
        <div class="sf-stat-row"><span><b>{groups.length}</b> 分野</span><span><b>{allTerms.filter((t) => t.featured).length}</b> 重要語</span><span><b>{allTerms.filter((t) => t.sql).length}</b> SQL例</span></div>
        <p>Learn once.<br /><strong>Connect the whole platform.</strong></p>
        <small class="sf-reviewed">内容確認 · {reviewed}</small>
      </aside>
    </header>

    <nav class="sf-domain-nav" aria-label="Snowflakeの学習分野">
      {domainNav.map((item) => <a href={route(`topics/snowflake/${item.id}/`)} aria-current={currentSection === item.id ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <section class="sf-learning" aria-labelledby="sf-learning-title">
      <div><p class="sf-eyebrow">ONE DICTIONARY, THREE LEARNING LENSES</p><h2 id="sf-learning-title">覚える。実装する。設計する。</h2><p>資格ごとに別の辞典を作らず、同じ機能を違う観点で読み直す。</p></div>
      <div class="sf-lens-grid">
        <a href="#snowflake-glossary" data-choose-track="C"><small>CORE</small><strong>仕組みをつかむ <span>↗</span></strong><span>基礎概念・違い・基本操作</span></a>
        <a href="#snowflake-glossary" data-choose-track="D"><small>DATA ENGINEER</small><strong>動く流れをつくる <span>↗</span></strong><span>取り込み・変換・品質・運用</span></a>
        <a href="#snowflake-glossary" data-choose-track="A"><small>ARCHITECT</small><strong>要件から選び取る <span>↗</span></strong><span>構成・性能・権限・可用性</span></a>
      </div>
      <p class="sf-fine">分類はこのサイトの学習用タグです。公式の試験範囲・出題保証ではありません。<a href="https://learn.snowflake.com/en/certifications/" target="_blank" rel="noopener noreferrer">受験する試験のガイドを確認 ↗</a></p>
      <details class="sf-focus"><summary>この分野で説明できるようになりたいこと <span aria-hidden="true">＋</span></summary><ul>{guide.focus.map((item) => <li>{item}</li>)}</ul></details>
    </section>

    <atlas-snowflake-glossary data-section={currentSection} data-section-label={title}>
      <details class="sf-dictionary" id="snowflake-glossary" open>
        <summary class="sf-dictionary-heading"><span><small>SEARCH / CONNECT / REVIEW</small><strong>Snowflake 用語・機能辞典</strong><span>{allTerms.length}項目を、必要なところから。</span></span><span class="sf-dictionary-toggle" aria-hidden="true">−</span></summary>
        <div class="sf-dictionary-content">
          <p class="sf-dictionary-intro">用語を開くと「意味」「使う場面」「注意点」「公式資料」を読めます。関連語や比較カードをたどって、点の知識をつなげていきましょう。</p>
          <div class="sf-controls" hidden>
            <div class="sf-scope-row"><div class="sf-segment" role="group" aria-label="表示範囲"><button type="button" data-scope="section" aria-pressed="false">このページの分野</button><button type="button" data-scope="all" aria-pressed="false">全機能</button></div><span class="sf-scope-label" data-scope-label></span></div>
            <label class="sf-search-label" for="sf-search">日本語・英語・略語で探す <kbd>/</kbd></label>
            <div class="sf-search-wrap"><span aria-hidden="true">⌕</span><input id="sf-search" type="search" placeholder="例：タイムトラベル / warehouse / CDC / Cortex" autocomplete="off" spellcheck="false" aria-describedby="sf-search-help" /><button type="button" data-action="clear-search" aria-label="検索文字を消す">×</button></div>
            <p id="sf-search-help" class="sf-fine">検索を始めると全機能へ切り替わります。スペース区切りで複数語を絞り込めます。</p>
            <div class="sf-filter-row"><label class="sf-select-label" for="sf-group-select">分野<select id="sf-group-select"><option value="all">すべての分野</option>{groups.map((group) => <option value={group.id}>{group.title} · {group.terms.length}</option>)}</select></label><div class="sf-track-controls"><span>学習の観点</span><div class="sf-chips" role="group" aria-label="学習の観点"><button type="button" data-track="all" aria-pressed="true">すべて</button>{(['C','D','A','X'] as Track[]).map((track) => <button type="button" data-track={track} aria-pressed="false">{trackLabels[track]}</button>)}</div></div></div>
            <div class="sf-tool-row"><label class="sf-featured-toggle"><input type="checkbox" data-featured />重要語だけ</label><div><button type="button" data-action="expand">用語をすべて開く</button><button type="button" data-action="collapse">用語を閉じる</button><button type="button" data-action="reset">全解除</button></div></div>
          </div>
          <noscript><p class="sf-noscript">JavaScriptが無効のため全項目を表示しています。各分野を開き、ブラウザーのページ内検索で探せます。</p></noscript>
          <div class="sf-result-row"><p role="status" aria-live="polite" aria-atomic="true" data-results>{allTerms.length} / {allTerms.length} 項目 · {groups.length} 分野</p><span>展開して読む <span aria-hidden="true">↓</span></span></div>
          <div class="sf-picks"><span>この分野の入口</span>{guide.picks.map((id) => <a href={`#term-${id}`}>{byId[id].title} ↗</a>)}</div>
          <div class="sf-empty" hidden><strong>該当する用語がありません。</strong><p>別名・英語・略語でも試すか、分野や学習タグを解除してください。</p><button type="button" data-action="reset">全項目を表示する</button></div>
          <div class="sf-groups">
            {groups.map((group, index) => <details class="sf-group" id={`group-${group.id}`} data-group={group.id} data-sections={group.sections.join(' ')} open={index === 0}>
              <summary class="sf-group-heading"><span class="sf-group-no">{String(index + 1).padStart(2, '0')}</span><span class="sf-group-title"><small>{group.en}</small><strong>{group.title}</strong></span><span class="sf-group-count" data-group-count>{group.terms.length}</span><span class="sf-chevron" aria-hidden="true">⌄</span></summary>
              <div class="sf-group-body"><p class="sf-group-description">{group.description}</p><div class="sf-terms">
                {group.terms.map((term) => <details class="sf-term" id={`term-${term.id}`} data-term={term.id} data-tracks={term.tracks.join('')} data-key={term.featured ? 'yes' : 'no'} data-index={searchIndex(term, group)}>
                  <summary><span class="sf-term-heading"><span class="sf-term-en">{term.title}</span><span class="sf-term-ja">{term.ja}</span></span>{term.featured && <span class="sf-key-badge" title="この辞典の重要語">KEY</span>}<span class="sf-term-plus" aria-hidden="true">＋</span></summary>
                  <div class="sf-term-content">
                    <div class="sf-term-tags">{term.tracks.map((track) => <span>{trackLabels[track]}</span>)}</div>
                    <dl><div><dt>意味・役割</dt><dd>{term.meaning}</dd></div><div class="sf-example"><dt>使う場面・例</dt><dd>{term.example}</dd></div><div class="sf-caution"><dt>混同しやすい点・注意</dt><dd>{term.note}</dd></div></dl>
                    {term.sql && <details class="sf-code-example"><summary>SQLでイメージする <span aria-hidden="true">↗</span></summary><p>構文を理解するための例です。オブジェクト名・権限・環境を合わせてください。実行すると更新や作成を伴う例もあります。</p><pre><code>{term.sql}</code></pre></details>}
                    <div class="sf-sources"><small>OFFICIAL DOCS</small>{term.sources.map((key) => <a href={sources[key].url} target="_blank" rel="noopener noreferrer">{sources[key].title} ↗</a>)}</div>
                    <div class="sf-related"><small>関連・読み比べ</small><div>{term.related.map((id) => <a href={`#term-${id}`}>{byId[id].title}</a>)}</div></div>
                    <div class="sf-term-bottom"><span>{term.id}</span><a href={`#term-${term.id}`} aria-label={`${term.title}の直接リンク`}>この用語へのリンク #</a></div>
                  </div>
                </details>)}
              </div></div>
            </details>)}
          </div>
          <p class="sf-bottom-hint">すべて覚えてから進む必要はありません。実装で使った用語を引き、似た機能を一つ読み比べるだけでも知識がつながります。</p>
        </div>
      </details>
    </atlas-snowflake-glossary>

    <section class="sf-comparisons" aria-labelledby="sf-comparisons-title">
      <p class="sf-eyebrow">COMPARE / UNDERSTAND THE DIFFERENCE</p><h2 id="sf-comparisons-title">似ている機能を、並べて考える。</h2><p class="sf-section-lead">名前を覚えたら、「何のために使うか」「何を解決しないか」を比較する。</p>
      <div class="sf-compare-grid">{comparisons.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p><div>{item.ids.map((id) => <a href={`#term-${id}`}>{byId[id].title} ↗</a>)}</div></article>)}</div>
    </section>

    <footer class="sf-footer">
      <div><p class="sf-eyebrow">SCOPE & SOURCES</p><h2>辞典と、公式資料を行き来する。</h2></div>
      <p>主要な機能・用語・設計概念を広く整理しています。全SQL関数、全引数、すべての制限値を列挙したリファレンスではありません。GA／Preview、エディション、クラウド、リージョン、権限、価格は機能ごとに変わるため、実装時は各項目の公式資料を確認してください。</p>
      <p>内容確認日：{reviewed}。学習タグと例は本サイトの編集によるものです。Core・Data Engineerの既存教材や公式試験ガイドを置き換えるものではありません。SQL例はSnowflake実環境での実行検証をしていません。</p>
      <div class="sf-footer-links"><a href="https://docs.snowflake.com/en/" target="_blank" rel="noopener noreferrer">Snowflake Docs ↗</a><a href="https://docs.snowflake.com/en/release-notes/overview" target="_blank" rel="noopener noreferrer">Release notes ↗</a><a href={route('topics/snowflake/core/')}>Core学習ページ ↗</a><a href={route('topics/snowflake/data-engineer/')}>Data Engineer学習ページ ↗</a><a href={route('topics/snowflake/')}>Snowflakeトップ ↗</a></div>
    </footer>
  </main>
</BaseLayout>

<script>
  // Native custom element: no framework/runtime dependency; survives Astro page navigation.
  class AtlasSnowflakeGlossary extends HTMLElement {
    private cleanup?: AbortController;
    connectedCallback() {
      if (this.cleanup) return;
      this.cleanup = new AbortController();
      const signal = this.cleanup.signal;
      const section = this.dataset.section || 'architecture';
      const isArchitect = section === 'architect';
      const root = this.querySelector<HTMLDetailsElement>('.sf-dictionary');
      const input = this.querySelector<HTMLInputElement>('#sf-search');
      const select = this.querySelector<HTMLSelectElement>('#sf-group-select');
      const featured = this.querySelector<HTMLInputElement>('[data-featured]');
      const status = this.querySelector<HTMLElement>('[data-results]');
      const scopeLabel = this.querySelector<HTMLElement>('[data-scope-label]');
      const empty = this.querySelector<HTMLElement>('.sf-empty');
      if (!root || !input || !select || !featured || !status || !scopeLabel || !empty) return;
      const normalize = (value: string) => value.normalize('NFKC').toLowerCase()
        .replace(/[\u30a1-\u30f6]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60))
        .replace(/[\s_\-\/]+/g, ' ').trim();
      const domains = Array.from(this.querySelectorAll<HTMLDetailsElement>('[data-group]')).map((element) => ({
        element, id: element.dataset.group || '', sections: (element.dataset.sections || '').split(' '),
        count: element.querySelector<HTMLElement>('[data-group-count]'),
        terms: Array.from(element.querySelectorAll<HTMLDetailsElement>('[data-term]')).map((term) => ({
          element: term, text: normalize(term.dataset.index || ''), tracks: term.dataset.tracks || '', key: term.dataset.key === 'yes',
        })),
      }));
      const total = domains.reduce((n, group) => n + group.terms.length, 0);
      let scope = isArchitect ? 'all' : 'section';
      let track = isArchitect ? 'A' : 'all';
      let previousSearch = '';
      let composing = false;
      const apply = (openGroups = false) => {
        const words = normalize(input.value).split(' ').filter(Boolean);
        let count = 0;
        let groupCount = 0;
        let openedFirst = false;
        domains.forEach((domain) => {
          const inScope = scope === 'all' || isArchitect || domain.sections.includes(section);
          let visible = 0;
          domain.terms.forEach((term) => {
            const matches = inScope && (select.value === 'all' || select.value === domain.id)
              && (track === 'all' || term.tracks.includes(track)) && (!featured.checked || term.key)
              && words.every((word) => term.text.includes(word) || term.text.replace(/ /g, '').includes(word));
            term.element.hidden = !matches;
            if (matches) visible++;
          });
          domain.element.hidden = visible === 0;
          if (domain.count) domain.count.textContent = String(visible);
          if (visible) {
            groupCount++;
            if (openGroups) domain.element.open = true;
            if (!openedFirst && !this.hasAttribute('data-ready')) domain.element.open = true;
            openedFirst = true;
          }
          count += visible;
        });
        status.textContent = `${count} / ${total} 項目 · ${groupCount} 分野`;
        empty.hidden = count !== 0;
        scopeLabel.textContent = scope === 'section' ? `${this.dataset.sectionLabel || section} の関連分野` : '全分野から表示';
        this.querySelectorAll<HTMLButtonElement>('[data-scope]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.scope === scope)));
        this.querySelectorAll<HTMLButtonElement>('[data-track]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.track === track)));
      };
      const reset = () => {
        scope = 'all'; track = 'all'; select.value = 'all'; featured.checked = false;
        input.value = ''; previousSearch = ''; apply(true);
      };
      const changeTrack = (value: string) => {
        if (!['all', 'C', 'D', 'A', 'X'].includes(value)) return;
        scope = 'all'; track = value; select.value = 'all'; apply(true);
      };
      const reveal = (hash: string, shouldScroll = true) => {
        let id: string;
        try { id = decodeURIComponent(hash.replace(/^#/, '')); } catch { return; }
        const target = document.getElementById(id);
        if (!target || !this.contains(target)) return;
        root.open = true;
        if (id.startsWith('term-') || id.startsWith('group-')) {
          reset();
          if (target instanceof HTMLDetailsElement) target.open = true;
          let parent = target.parentElement;
          while (parent && parent !== this) {
            if (parent instanceof HTMLDetailsElement) parent.open = true;
            parent = parent.parentElement;
          }
        }
        if (shouldScroll) requestAnimationFrame(() => {
          target.scrollIntoView({ behavior:'auto', block:'start' });
          if (target instanceof HTMLDetailsElement) target.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
        });
      };
      const search = () => {
        const next = input.value.trim();
        if (next && !previousSearch) {
          scope = 'all'; track = 'all'; select.value = 'all'; featured.checked = false;
        }
        previousSearch = next;
        apply(true);
      };
      input.addEventListener('compositionstart', () => { composing = true; }, {signal});
      input.addEventListener('compositionend', () => { composing = false; search(); }, {signal});
      input.addEventListener('input', () => { if (!composing) search(); }, {signal});
      select.addEventListener('change', () => { scope = 'all'; apply(true); }, {signal});
      featured.addEventListener('change', () => apply(true), {signal});
      this.addEventListener('click', (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>('button');
        if (!button || !this.contains(button)) return;
        if (button.dataset.scope) {
          scope = button.dataset.scope; track = scope === 'section' && isArchitect ? 'A' : 'all';
          select.value = 'all'; input.value = ''; previousSearch = ''; featured.checked = false; apply(true);
        } else if (button.dataset.track) changeTrack(button.dataset.track);
        else if (button.dataset.action === 'reset') reset();
        else if (button.dataset.action === 'clear-search') { input.value = ''; previousSearch = ''; apply(true); input.focus(); }
        else if (button.dataset.action === 'expand' || button.dataset.action === 'collapse') {
          const open = button.dataset.action === 'expand';
          domains.forEach((domain) => {
            if (domain.element.hidden) return;
            domain.element.open = true;
            domain.terms.forEach((term) => { if (!term.element.hidden) term.element.open = open; });
          });
        }
      }, {signal});
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const anchor = (event.target as Element | null)?.closest<HTMLAnchorElement>('a');
        if (!anchor || anchor.target === '_blank' || anchor.hasAttribute('download')) return;
        const href = anchor.getAttribute('href') || '';
        if (!href.startsWith('#')) return;
        if (anchor.dataset.chooseTrack) {
          event.preventDefault(); reset(); changeTrack(anchor.dataset.chooseTrack);
          root.open = true; root.scrollIntoView({ behavior:'auto', block:'start' }); return;
        }
        let id: string;
        try { id = decodeURIComponent(href.slice(1)); } catch { return; }
        const target = document.getElementById(id);
        if (!target || !this.contains(target)) return;
        event.preventDefault();
        if (location.hash !== href) history.pushState(null, '', href);
        reveal(href);
      }, {signal});
      document.addEventListener('keydown', (event) => {
        const element = event.target as HTMLElement | null;
        const editing = element?.closest('input, textarea, select, [contenteditable="true"]');
        if (event.key === '/' && !editing && !event.ctrlKey && !event.metaKey && !event.altKey) {
          event.preventDefault(); root.open = true; input.focus();
        }
        if (event.key === 'Escape' && document.activeElement === input && !event.isComposing) {
          input.value = ''; previousSearch = ''; apply(true);
        }
      }, {signal});
      window.addEventListener('hashchange', () => reveal(location.hash), {signal});
      apply();
      this.setAttribute('data-ready', '');
      this.querySelector<HTMLElement>('.sf-controls')?.removeAttribute('hidden');
      if (location.hash) reveal(location.hash);
    }
    disconnectedCallback() { this.cleanup?.abort(); this.cleanup = undefined; }
  }
  if (!customElements.get('atlas-snowflake-glossary')) customElements.define('atlas-snowflake-glossary', AtlasSnowflakeGlossary);
</script>

<style>
  :global(body){background:radial-gradient(ellipse at 79% 2%,rgba(57,167,220,.12),transparent 34%),#08111a}
  .sf-page{--sf-ink:#eff7fb;--sf-muted:#9aafbe;--sf-cyan:#78dcff;--sf-line:#253e50;--sf-panel:#10202d;box-sizing:border-box;width:min(1180px,calc(100% - 48px));margin:0 auto;padding:38px 0 88px;color:var(--sf-ink);font-family:inherit;line-height:1.65}
