import BaseLayout from '../../../layouts/BaseLayout.astro';

// This file owns only these eight existing routes. Core and Data Engineer are separate pages.
export function getStaticPaths() {
  return [
    { params: { section: 'architect' }, props: { eyebrow:'CERTIFICATION', title:'Advanced Architect', code:'ARA-C01', official:'https://learn.snowflake.com/en/certifications/snowpro-adv-ara-jpn/' } },
    { params: { section: 'architecture' }, props: { eyebrow:'PLATFORM', title:'Architecture' } },
    { params: { section: 'data-engineering' }, props: { eyebrow:'PIPELINES', title:'Data Engineering' } },
    { params: { section: 'storage-data' }, props: { eyebrow:'DATA LAYER', title:'Storage & Data' } },
    { params: { section: 'performance-cost' }, props: { eyebrow:'EFFICIENCY', title:'Performance & Cost' } },
    { params: { section: 'security-governance' }, props: { eyebrow:'CONTROL', title:'Security & Governance' } },
    { params: { section: 'sharing-integration' }, props: { eyebrow:'CONNECT', title:'Sharing & Integration' } },
    { params: { section: 'apps-development' }, props: { eyebrow:'BUILD', title:'Apps & Development' } },
  ];
}
interface Props { eyebrow: string; title: string; code?: string; official?: string; }
type Track = 'C' | 'D' | 'A' | 'X';
interface Term {
  id: string; title: string; ja: string; meaning: string; example: string; note: string;
  sources: string[]; tracks: Track[]; aliases: string; featured: boolean; related: string[]; sql?: string;
}
interface Group { id: string; title: string; en: string; sections: string[]; description: string; terms: Term[]; }
interface Source { title: string; url: string; }
const { eyebrow, title, code, official } = Astro.props;
const currentSection = Astro.params.section || 'architecture';
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const reviewed = '2026-09-23';
