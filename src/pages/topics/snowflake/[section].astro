  {"id": "hybrid-table", "title": "Hybrid table", "ja": "ハイブリッドテーブル", "meaning": "低遅延の小規模読み書きやトランザクション処理に向けたテーブル。主キー、インデックス、行レベルロック等が特徴。", "example": "アプリケーションの注文状態や参照データを更新する。", "note": "標準テーブルの単なる高速版ではない。利用可能地域・制限・課金を確認する。", "sources": ["hybrid"], "tracks": ["C", "D", "A"], "aliases": "Unistore OLTP ハイブリッド", "featured": true, "related": ["standard-table", "iceberg-table", "external-table", "constraints", "check-constraint"]},
  {"id": "iceberg-table", "title": "Apache Iceberg table", "ja": "Icebergテーブル", "meaning": "オープンなApache Iceberg形式のデータをSnowflakeで扱うテーブル。カタログの管理主体や保存先に複数の構成がある。", "example": "同じデータをSnowflakeと別のIceberg対応エンジンから利用する。", "note": "すべてSnowflake管理、またはすべて外部管理と一括りにしない。構成で機能差がある。", "sources": ["iceberg"], "tracks": ["C", "D", "A"], "aliases": "Apache Iceberg アイスバーグ", "featured": true, "related": ["standard-table", "hybrid-table", "external-table", "external-volume", "catalog-integration", "open-catalog"]},
  {"id": "iceberg-managed", "title": "Snowflake-managed Iceberg", "ja": "Snowflake管理のIceberg", "meaning": "SnowflakeをカタログとしてIcebergテーブルのメタデータやライフサイクルを管理する構成。", "example": "オープン形式を保ちながらSnowflakeでテーブルを更新する。", "note": "データの保存場所とカタログの管理主体は別の設計要素。", "sources": ["iceberg"], "tracks": ["D", "A"], "aliases": "Snowflake as catalog managed Iceberg", "featured": false, "related": ["standard-table", "hybrid-table"]},
  {"id": "iceberg-external", "title": "Externally managed Iceberg", "ja": "外部カタログ管理のIceberg", "meaning": "外部のIcebergカタログを参照してテーブルを利用する構成。同期方法や読み書きの対応を確認する。", "example": "既存の外部Icebergテーブルをカタログ連携で扱う。", "note": "更新可否・自動同期・利用制限はカタログや構成に依存する。常に読み取り専用と断定しない。", "sources": ["iceberg", "catalog"], "tracks": ["D", "A"], "aliases": "external catalog REST catalog", "featured": false, "related": ["standard-table", "hybrid-table"]},
  {"id": "external-table", "title": "External table", "ja": "外部テーブル", "meaning": "外部ステージ上のファイルを、Snowflake内に行データとして取り込まず問い合わせる仕組み。メタデータでファイルを把握する。", "example": "S3の既存ParquetファイルをSQLで参照する。", "note": "標準テーブルのように行を直接更新する用途ではない。Icebergテーブルとも別の機能。", "sources": ["external-table"], "tracks": ["C", "D", "A"], "aliases": "external table 外部表", "featured": false, "related": ["standard-table", "hybrid-table", "iceberg-table"]},
  {"id": "micro-partition", "title": "Micro-partition", "ja": "マイクロパーティション", "meaning": "標準テーブルのデータを自動分割して保持する単位。列ごとの値の範囲等のメタデータが読み飛ばしに使われる。", "example": "日付条件に関係しない保存領域を走査から除外する。", "note": "一般的な手動パーティション表のように、利用者が一つずつパーティションを定義する仕組みではない。", "sources": ["micro"], "tracks": ["C", "D", "A"], "aliases": "MP columnar 列指向", "featured": true, "related": ["standard-table", "hybrid-table"]},
  {"id": "view", "title": "View", "ja": "ビュー", "meaning": "SELECT文をオブジェクトとして保存し、表のように参照する仕組み。通常のビューは結果データを永続化しない。", "example": "部門向けの列だけを公開する論理的な窓口を作る。", "note": "ビューを作るだけで計算結果が保存され、必ず高速化するわけではない。", "sources": ["views"], "tracks": ["C", "D", "A"], "aliases": "論理ビュー logical view", "featured": false, "related": ["secure-view", "materialized-view"]},
  {"id": "secure-view", "title": "Secure view", "ja": "セキュアビュー", "meaning": "定義の露出や一部の最適化に伴う情報漏えいリスクを抑えるためのビュー。データ共有や保護用途で使う。", "example": "元テーブルを直接公開せず、限定したデータを共有する。", "note": "SECUREを付けるだけで必要な行・列の制限が自動設定されるわけではない。", "sources": ["secure-view"], "tracks": ["C", "D", "A"], "aliases": "secure 安全なビュー", "featured": false, "related": ["view", "materialized-view"]},
  {"id": "materialized-view", "title": "Materialized view", "ja": "マテリアライズドビュー", "meaning": "対象クエリの計算結果を保持し、基表の変更に合わせてメンテナンスする仕組み。特定の繰り返し参照を速める。", "example": "同じ表の一部の列・集計を繰り返し利用する。", "note": "対応SQLに制限があり、保存・更新費用も発生する。汎用ETLの代替とは限らない。", "sources": ["materialized"], "tracks": ["C", "D", "A"], "aliases": "MV マテビュー 実体化ビュー", "featured": false, "related": ["dynamic-table", "target-lag", "refresh-mode", "view", "secure-view"]},
  {"id": "semantic-view", "title": "Semantic view", "ja": "セマンティックビュー", "meaning": "業務上のディメンション、メトリクス、テーブル間の関係を定義するスキーマオブジェクト。分析で意味を共有する。", "example": "売上の定義と顧客・日付の関係を共通化する。", "note": "集計結果を物理保存するMaterialized Viewとは別。定義の正しさは設計者が確認する。", "sources": ["semantic"], "tracks": ["D", "A", "X"], "aliases": "semantic layer メトリクス ディメンション", "featured": false, "related": ["cortex-analyst", "semantic-model"]},
  {"id": "constraints", "title": "Constraints", "ja": "制約", "meaning": "主キー、外部キー、一意性、NOT NULL等のデータ規則。実際に強制されるかは制約とテーブルの種類で異なる。", "example": "標準テーブルのPK/FK宣言と、業務バリデーションを区別して設計する。", "note": "標準テーブルのPK/FK/UNIQUEを宣言しただけで全て検証されるとは考えない。Hybridでは挙動が異なる。", "sources": ["constraints", "hybrid"], "tracks": ["C", "D", "A"], "aliases": "PK FK UNIQUE NOT NULL 主キー 参照整合", "featured": false, "related": ["check-constraint", "hybrid-table"]},
  {"id": "sequence", "title": "Sequence / identity", "ja": "シーケンス・自動採番", "meaning": "値を自動生成して識別子等に利用する仕組み。SEQUENCEやIDENTITY／AUTOINCREMENTを使う。", "example": "新規レコードにサロゲートキーを付ける。", "note": "連番に欠番がないことや、業務上の時系列順まで保証する用途には使わない。", "sources": ["sequence"], "tracks": ["C", "D"], "aliases": "AUTOINCREMENT IDENTITY SEQUENCE 採番", "featured": false, "related": ["standard-table", "hybrid-table"]},
  {"id": "check-constraint", "title": "CHECK constraint", "ja": "CHECK制約", "meaning": "列や行の値が指定した条件を満たすかを検証する制約。標準テーブルでは対応するCHECK制約が強制される。", "example": "負の金額など、許容しない値の登録を防ぐ。", "note": "標準テーブルのPK・FK・UNIQUEとは強制の扱いが異なる。Hybrid TableではCHECKをサポートしないため、対象と制限を確認する。", "sources": ["constraints"], "tracks": ["C", "D"], "aliases": "CHECK constraint チェック制約 enforced", "featured": false, "related": ["constraints", "hybrid-table"], "sql": "CREATE TEMP TABLE check_example (\n  amount NUMBER,\n  CONSTRAINT nonnegative_amount CHECK (amount >= 0)\n);\n-- NULLも拒否するならNOT NULLを別途指定する。"}
]},
{"id": "lifecycle", "title": "履歴・復旧・ライフサイクル", "en": "HISTORY & DATA LIFECYCLE", "sections": ["storage-data", "architecture"], "description": "削除前後の復元、クローン、保存期間の違いを理解する。", "terms": [
  {"id": "time-travel", "title": "Time Travel", "ja": "タイムトラベル", "meaning": "設定された保持期間内の過去データを参照・複製・復元する機能。変更や削除への対応に使う。", "example": "誤更新の直前のテーブルを確認する。", "note": "任意の過去を無制限に参照できるわけではない。対象オブジェクトと保持期間を確認する。", "sources": ["time-travel"], "tracks": ["C", "D", "A"], "aliases": "履歴 過去データ", "featured": true, "related": ["fail-safe", "zero-copy-clone", "replication", "retention", "historical-storage"]},
  {"id": "retention", "title": "Data retention period", "ja": "データ保持期間", "meaning": "Time Travelで過去データを保持する期間。標準テーブルではエディションや表種別で設定可能範囲が変わる。", "example": "永続表は長め、再作成可能な中間表は短めに設計する。", "note": "保持期間を延ばしても、すでに利用できなくなった過去データが復活するわけではない。", "sources": ["time-travel"], "tracks": ["C", "D", "A"], "aliases": "DATA_RETENTION_TIME_IN_DAYS 保持日数 90日 1日", "featured": false, "related": ["time-travel", "historical-storage"]},
  {"id": "at-before", "title": "AT / BEFORE", "ja": "時点指定", "meaning": "時刻、相対オフセット、クエリIDを使い、対象時点のデータを問い合わせるTime Travel構文。", "example": "誤ったDELETEのクエリIDより前の状態を調べる。", "note": "ATとBEFOREで境界の扱いが異なる。現在のスキーマで過去データを読む点にも注意する。", "sources": ["time-travel"], "tracks": ["C", "D"], "aliases": "TIMESTAMP OFFSET STATEMENT", "featured": false, "related": ["time-travel", "zero-copy-clone"], "sql": "SELECT * FROM orders AT (OFFSET => -60);\n-- 60秒前の参照例。保持期間や作成時点等の条件がある。"},
  {"id": "undrop", "title": "UNDROP", "ja": "削除オブジェクトの復元", "meaning": "保持期間内にある対応オブジェクトのDROPを取り消すコマンド。", "example": "誤って削除したテーブルを戻す。", "note": "DELETEされた行を直接UNDROPするわけではない。同名オブジェクトの存在も確認する。", "sources": ["time-travel"], "tracks": ["C", "D"], "aliases": "復元 DROP 取り消し", "featured": false, "related": ["time-travel", "zero-copy-clone"]},
  {"id": "zero-copy-clone", "title": "Zero-copy cloning", "ja": "ゼロコピークローン", "meaning": "作成時点のデータを共有して論理的なコピーを作る仕組み。標準テーブルでは初期のデータ全量コピーを避けられる。", "example": "本番に近いテストデータを短時間で用意する。", "note": "作成後の変更は独立する。変更分や履歴のストレージは増え得るため永久に無料ではない。", "sources": ["clone"], "tracks": ["C", "D", "A"], "aliases": "CLONE ゼロコピー", "featured": true, "related": ["time-travel", "fail-safe", "replication"], "sql": "CREATE TABLE orders_copy CLONE orders;\n-- テーブルを作成する例。履歴・権限・依存関係を確認する。"},
  {"id": "clone-scope", "title": "Cloning scope & grants", "ja": "クローンの対象と権限", "meaning": "データベース・スキーマ・テーブル等を複製するとき、含まれるオブジェクト、参照先、権限を確認する観点。", "example": "テスト環境のクローン後にタスク・外部参照・アクセス権を点検する。", "note": "すべてのオブジェクトやデータファイルが同じ規則でコピーされるわけではない。", "sources": ["clone"], "tracks": ["D", "A"], "aliases": "COPY GRANTS clone grants", "featured": false, "related": ["time-travel", "zero-copy-clone"]},
  {"id": "fail-safe", "title": "Fail-safe", "ja": "フェイルセーフ", "meaning": "対象の永続データについて、Time Travel後にSnowflakeが復旧を試みるための保護期間。通常のユーザー操作による履歴検索とは異なる。", "example": "重大なデータ損失時の最後の保護として理解する。", "note": "通常のバックアップや日常的な復元手段ではない。Transient・Temporaryにはない。", "sources": ["failsafe"], "tracks": ["C", "D", "A"], "aliases": "7日 failsafe 災害復旧", "featured": true, "related": ["time-travel", "zero-copy-clone", "replication"]},
  {"id": "historical-storage", "title": "Historical storage", "ja": "履歴ストレージ", "meaning": "現在のデータだけでなく、変更前データ、クローン参照、保護期間中のデータ等が占める保存領域。", "example": "削除したのにストレージ使用量がすぐ減らない理由を調べる。", "note": "論理削除やDROPが即座に物理ストレージの削減になるとは限らない。", "sources": ["time-travel", "failsafe", "clone"], "tracks": ["D", "A"], "aliases": "TIME_TRAVEL_BYTES FAILSAFE_BYTES retained for clone", "featured": false, "related": ["retention", "time-travel"]},
  {"id": "storage-lifecycle", "title": "Storage lifecycle policy", "ja": "ストレージライフサイクルポリシー", "meaning": "条件に応じたデータのライフサイクル管理を行うポリシー機能。古いデータの保持や整理を設計する際に参照する。", "example": "期間を過ぎたデータの扱いを明示的なポリシーで管理する。", "note": "Time Travelの保持期間設定とは別機能。対応表種別・操作・提供条件は最新仕様を確認する。", "sources": ["lifecycle"], "tracks": ["D", "A", "X"], "aliases": "retention policy archive lifecycle", "featured": false, "related": ["time-travel", "zero-copy-clone"]}
]},
{"id": "ingestion", "title": "ロード・アンロード・ファイル", "en": "INGESTION & FILES", "sections": ["data-engineering", "sharing-integration"], "description": "ファイル配置、取り込み、エラー処理、外部ストレージの接続を整理する。", "terms": [
  {"id": "stage", "title": "Stage", "ja": "ステージ", "meaning": "ロード元・アンロード先などのファイルを扱うための場所、またはその場所への参照。内部と外部がある。", "example": "CSVを置いてからCOPY INTOで表にロードする。", "note": "ステージはテーブルそのものではない。ファイル配置と行データの取り込みを区別する。", "sources": ["stage", "load"], "tracks": ["C", "D", "A"], "aliases": "@stage ステージング", "featured": true, "related": ["external-stage", "storage-integration", "external-volume"]},
  {"id": "internal-stage", "title": "Internal stage", "ja": "内部ステージ", "meaning": "Snowflakeが管理するストレージ上のファイル置き場。ユーザー、テーブル、名前付きの種類がある。", "example": "ローカルのCSVを名前付き内部ステージにPUTする。", "note": "内部ステージ上のファイルにも保存費用が関わる。表にロード済みでも元ファイルは別に管理する。", "sources": ["load", "stage"], "tracks": ["C", "D"], "aliases": "internal named stage 内部", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "external-stage", "title": "External stage", "ja": "外部ステージ", "meaning": "S3、Azure、GCS等の外部ストレージの位置とアクセス設定を持つオブジェクト。", "example": "共同バケットの特定パスをロード元として登録する。", "note": "外部ステージを作成してもファイルがSnowflake内にコピーされるわけではない。", "sources": ["stage", "load"], "tracks": ["C", "D", "A"], "aliases": "S3 bucket Azure container GCS 外部", "featured": false, "related": ["stage", "storage-integration", "external-volume"]},
  {"id": "user-table-stage", "title": "User stage / table stage", "ja": "ユーザーステージ・テーブルステージ", "meaning": "ユーザーに対応する@~とテーブルに対応する@%tableの内部ステージ。名前付きステージとは管理単位が違う。", "example": "一人の作業用ファイルにユーザーステージを使う。", "note": "独立した名前付きステージと同じ権限・変更操作ができると考えない。", "sources": ["load"], "tracks": ["C", "D"], "aliases": "@~ @% ユーザ テーブルステージ", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "file-format", "title": "File format", "ja": "ファイル形式定義", "meaning": "区切り文字、引用符、圧縮、NULLの扱い等、ファイルの読み書き規則を設定するオブジェクト。", "example": "UTF-8のCSVでヘッダーや空文字の解釈を明示する。", "note": "拡張子だけでは正しく読めない。空文字、NULL文字列、引用符を別々に確認する。", "sources": ["fileformat"], "tracks": ["C", "D", "A"], "aliases": "CSV JSON Parquet Avro ORC XML UTF-8 NULL_IF", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "copy-into", "title": "COPY INTO table", "ja": "バルクロード", "meaning": "ステージ上のファイルからテーブルへ行データを取り込むSQL。ファイル形式やエラー時の動作を指定できる。", "example": "日次で届くCSVを一括ロードする。", "note": "PUTはファイル転送、COPYは行の取り込み。通常のバルクロードにはウェアハウスを使う。", "sources": ["copy", "load"], "tracks": ["C", "D", "A"], "aliases": "COPY INTO load バルク", "featured": true, "related": ["snowpipe", "snowpipe-streaming"], "sql": "COPY INTO target_table\nFROM @load_stage\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1)\nVALIDATION_MODE = RETURN_ERRORS;\n-- この例はロードせず、エラーを検証する。"},
  {"id": "copy-unload", "title": "COPY INTO location", "ja": "アンロード", "meaning": "SELECT結果やテーブルのデータを、内部・外部ステージのファイルへ出力するSQL。", "example": "加工済みデータをS3へParquetで出力する。", "note": "外部へ書き出す権限やファイル上書き、暗号化、転送費用を確認する。", "sources": ["unload"], "tracks": ["C", "D", "A"], "aliases": "export unload エクスポート", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "put-get", "title": "PUT / GET", "ja": "内部ステージへの転送", "meaning": "PUTはローカルから内部ステージへ、GETは内部ステージからローカルへファイルを転送するコマンド。", "example": "CLIや対応ドライバーでCSVをアップロード・取得する。", "note": "外部ストレージへの一般的なアップロード手段ではない。実行クライアントの対応も確認する。", "sources": ["put", "get"], "tracks": ["C", "D"], "aliases": "アップロード ダウンロード", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "snowpipe", "title": "Snowpipe", "ja": "ファイルの継続取り込み", "meaning": "ステージに届くファイルを継続的に取り込むサーバーレスサービス。イベント通知やAPIでロードを開始する。", "example": "S3に追加されたファイルを自動ロードする。", "note": "行を直接送るSnowpipe Streamingとは別。料金モデルや遅延条件は個別資料で確認する。", "sources": ["snowpipe"], "tracks": ["C", "D", "A"], "aliases": "スノーパイプ PIPE", "featured": true, "related": ["copy-into", "snowpipe-streaming"]},
  {"id": "pipe", "title": "Pipe / auto-ingest", "ja": "パイプ・自動取り込み", "meaning": "ロード用COPY文等の定義を持つオブジェクト。ファイル取り込みではクラウドイベントと連携して自動化できる。", "example": "ファイル到着の通知でSnowpipeを起動する。", "note": "通知設定とストレージ権限がそろう必要がある。パイプ作成だけで全過去ファイルが自動ロードされるとは限らない。", "sources": ["snowpipe"], "tracks": ["D", "A"], "aliases": "AUTO_INGEST SNS SQS Event Grid Pub/Sub", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "snowpipe-streaming", "title": "Snowpipe Streaming", "ja": "行データのストリーミング取り込み", "meaning": "SDKやAPIを通して行データを送る取り込み方式。ファイルの配置を前提とするSnowpipeとは区別する。", "example": "アプリケーションのイベントを低遅延で送信する。", "note": "Classicと新しいアーキテクチャでAPI・機能が違う。遅延の目安を全環境の保証と捉えない。", "sources": ["streaming"], "tracks": ["C", "D", "A"], "aliases": "streaming ストリーミング high performance classic", "featured": true, "related": ["copy-into", "snowpipe"]},
  {"id": "streaming-channel", "title": "Streaming channel / offset token", "ja": "チャネル・オフセットトークン", "meaning": "ストリーミング取り込みの単位や進捗を管理する仕組み。対応SDKで順序・再送・処理済み位置を設計する。", "example": "接続断後に送信済み位置を照合して再開する。", "note": "APIを呼ぶだけで業務全体のexactly-onceが完成するわけではない。チャネル方式やソース側の再送設計が必要。", "sources": ["streaming"], "tracks": ["D", "A"], "aliases": "channel offset token exactly once", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "load-validation", "title": "VALIDATION_MODE / ON_ERROR", "ja": "ロード検証とエラー処理", "meaning": "ロード前の検証や、エラー時に中断・スキップ等をどう扱うかを指定するCOPYオプション。", "example": "本番ロード前にCSVの型・列数エラーを検出する。", "note": "形式チェックが通っても、業務上の重複や親子整合まで検証済みとは限らない。", "sources": ["copy"], "tracks": ["C", "D"], "aliases": "RETURN_ERRORS ABORT_STATEMENT CONTINUE SKIP_FILE", "featured": false, "related": ["try-cast", "schema-evolution"]},
  {"id": "load-history", "title": "Load metadata / duplicate file prevention", "ja": "ロード履歴と重複ファイル判定", "meaning": "読み込んだファイルのメタデータを使って、同じファイルの再ロードを抑える仕組み。", "example": "再実行時に既ロードファイルがスキップされる理由を確認する。", "note": "履歴によるファイル判定は行単位の業務キー重複排除ではない。FORCE等で再ロードされ得る。", "sources": ["copy"], "tracks": ["D", "A"], "aliases": "FORCE COPY_HISTORY 重複ロード", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "schema-evolution", "title": "Schema evolution", "ja": "スキーマの自動進化", "meaning": "条件を満たすロード時に、新しい列などのファイル構造変化を表へ反映する機能。", "example": "供給元が列を追加するParquetデータを取り込む。", "note": "あらゆる型変更を安全に自動吸収する機能ではない。有効化、権限、対応方式を確認する。", "sources": ["schema-evolution"], "tracks": ["D", "A"], "aliases": "ENABLE_SCHEMA_EVOLUTION MATCH_BY_COLUMN_NAME", "featured": false, "related": ["try-cast", "load-validation"]},
  {"id": "infer-schema", "title": "INFER_SCHEMA / USING TEMPLATE", "ja": "スキーマ推定と表定義生成", "meaning": "対応ファイルを読み、列名や型を推定する関数と、その結果をテーブル作成に使う仕組み。", "example": "Parquetの構造から取り込み先テーブルのひな形を作る。", "note": "推定結果は業務上の型設計や品質保証そのものではない。対象ファイルとオプションに依存する。", "sources": ["infer"], "tracks": ["D", "A"], "aliases": "INFER_SCHEMA CREATE TABLE USING TEMPLATE", "featured": false, "related": ["stage", "copy-into"]},
  {"id": "storage-integration", "title": "Storage integration", "ja": "ストレージ統合", "meaning": "外部クラウドストレージへの認証・許可先を管理するオブジェクト。外部ステージ等から参照する。", "example": "長期アクセスキーを直接SQLに書かずS3へのアクセスを設定する。", "note": "クラウド側のIAM設定とSnowflake側のGRANTの両方が必要。External Volumeとは別用途。", "sources": ["storage-integration"], "tracks": ["C", "D", "A"], "aliases": "IAM trust STORAGE_ALLOWED_LOCATIONS", "featured": false, "related": ["stage", "external-stage", "external-volume"]},
  {"id": "unstructured", "title": "Unstructured data", "ja": "非構造化データ", "meaning": "PDF、画像、音声等のファイルをステージ等に置き、参照・処理する機能群。", "example": "申請書PDFを処理し、抽出結果を表へ格納する。", "note": "VARIANTで扱うJSON等の半構造化データと同じものではない。", "sources": ["unstructured"], "tracks": ["C", "D", "X"], "aliases": "PDF image audio 非構造化", "featured": false, "related": ["stage", "copy-into"]},
