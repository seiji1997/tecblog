---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    { params: { section: 'data-engineer' }, props: { eyebrow:'CERTIFICATION', title:'Advanced Data Engineer', code:'DEA-C02', official:'https://learn.snowflake.com/en/certifications/snowpro-adv-dea-jpn-C02/' } },
    { params: { section: 'architect' }, props: { eyebrow:'CERTIFICATION', title:'Advanced Architect', code:'ARA-C01', official:'https://learn.snowflake.com/en/certifications/snowpro-adv-ara-jpn/' } },
    { params: { section: 'architecture' }, props: { eyebrow:'PLATFORM', title:'Architecture' } },
    { params: { section: 'data-engineering' }, props: { eyebrow:'PIPELINES', title:'Data Engineering' } },
    { params: { section: 'storage-data' }, props: { eyebrow:'DATA LAYER', title:'Storage & Data' } },
    { params: { section: 'performance-cost' }, props: { eyebrow:'EFFICIENCY', title:'Performance & Cost' } },
    { params: { section: 'security-governance' }, props: { eyebrow:'CONTROL', title:'Security & Governance' } },
    { params: { section: 'sharing-integration' }, props: { eyebrow:'CONNECT', title:'Sharing & Integration' } },
    { params: { section: 'apps-development' }, props: { eyebrow:'BUILD', title:'Apps & Development' } },
  ];
}

const { eyebrow, title, code, official } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
---

<BaseLayout title={`${title} | Snowflake | Seiji Tech Atlas`}>
  <main class="page">
    <a class="back" href={route('topics/snowflake/')}>← Back to Snowflake</a>

    <section class="hero">
      <div class="label">SNOWFLAKE / {eyebrow}</div>
      <h1>{title}</h1>
      <div class="meta">
        {code && <code>{code}</code>}
        <span>CONTENT GROWING</span>
        {official && <a href={official} target="_blank" rel="noreferrer">公式 ↗</a>}
      </div>
    </section>

    <section class="grid">
      <article><span>01</span><h2>Overview</h2><p>この領域の目的と全体像を整理します。</p></article>
      <article><span>02</span><h2>Key concepts</h2><p>重要な概念、用語、設計上の判断ポイントを整理します。</p></article>
      <article><span>03</span><h2>Practical notes</h2><p>実装・演習・実務で確認した内容を追加します。</p></article>
      <article><span>04</span><h2>Review</h2><p>振り返り用のチェックリストと要点をまとめます。</p></article>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body){background:radial-gradient(circle at 72% 10%,rgba(104,212,248,.1),transparent 30%),#08111a}.page{width:min(1080px,calc(100% - 40px));margin:0 auto;padding:42px 0 100px}.back{color:#8298a5;font-size:.82rem}.hero{padding:86px 0 60px;border-bottom:1px solid rgba(190,220,240,.16)}.label{color:#68d4f8;font:800 .68rem/1 ui-monospace,monospace;letter-spacing:.17em}h1{margin:14px 0 22px;color:#f2f7fa;font-size:clamp(3.2rem,8vw,6.3rem);line-height:.9;letter-spacing:-.065em}.meta{display:flex;flex-wrap:wrap;gap:8px}.meta>*{padding:7px 10px;border:1px solid rgba(190,220,240,.15);border-radius:999px;color:#9eb3bd;background:#0e1b25;font:700 .62rem/1 ui-monospace,monospace}.meta a{color:#68d4f8}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;margin-top:58px}.grid article{min-height:190px;padding:24px;border:1px solid rgba(190,220,240,.17);border-radius:15px;background:linear-gradient(145deg,#11202c,#0c1721)}.grid span{color:#526d7c;font:700 .65rem/1 ui-monospace,monospace}.grid h2{margin:28px 0 9px;color:#ebf4f7}.grid p{margin:0;color:#8fa3ae;font-size:.78rem;line-height:1.65}@media(max-width:700px){.grid{grid-template-columns:1fr}}
</style>
