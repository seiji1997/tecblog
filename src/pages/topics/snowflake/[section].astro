---
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [
    {
      params: { section: 'core' },
      props: {
        eyebrow: 'CERTIFICATION',
        title: 'SnowPro Core',
        examCode: 'COF-C03',
        heroNote: 'STUDYING',
        official: 'https://learn.snowflake.com/en/certifications/snowpro-core-jpn-C03/',
        overview: {
          lead: 'SnowPro Core（COF-C03）は、Snowflake AIデータクラウドを実践的に扱うための基礎力を確認する認定資格です。',
          description:
            'アーキテクチャ、アカウントと仮想ウェアハウス、データの入出力と変換、各種データ型、パフォーマンス、データ共有・保護、接続方法までを横断して学びます。公式では、Snowflakeを6か月以上使用した実務経験を持つ受験者が想定されています。',
          outcomes: [
            'Snowflakeの3層アーキテクチャとストレージ / コンピュート分離を説明できる',
            '仮想ウェアハウスを使ったCompute管理と基本的な運用判断ができる',
            'データをロード・アンロード・変換し、各データ型を扱える',
            'パフォーマンスを確認し、基本的な最適化ポイントを判断できる',
            'データ共有・保護・アクセス制御・接続の基本を理解できる',
          ],
        },
        studyAreas: [
          {
            no: '01',
            title: 'Architecture',
            summary:
              'Snowflakeを構成するDatabase Storage、Compute、Cloud Servicesの役割と、ストレージとコンピュートを分離したアーキテクチャを理解します。',
            learn: [
              'Database Storage / Compute / Cloud Services',
              'マイクロパーティションとSnowflake管理ストレージ',
              '仮想ウェアハウスが独立したComputeとして動く理由',
              'Cloud Servicesが認証・メタデータ・クエリ最適化を担うこと',
            ],
            outcome:
              '「データはどこに保存され、どこで計算され、どのレイヤーが全体を制御するのか」を説明できる状態を目指します。',
            docs: [
              ['Snowflakeの重要な概念およびアーキテクチャ', 'https://docs.snowflake.com/ja/user-guide/intro-key-concepts'],
            ],
          },
          {
            no: '02',
            title: 'Accounts & Virtual Warehouses',
            summary:
              'Snowflakeのアカウント管理と、SQL・DML・ロード処理にComputeを提供する仮想ウェアハウスの基本を整理します。',
            learn: [
              'Organization / Accountの位置づけ',
              'Warehouse size、Start / Suspend / Resume、Auto Suspend',
              'Warehouseとクエリ実行・DML・COPYの関係',
              'Concurrency、Scaling、Workload分離の考え方',
            ],
            outcome:
              'ワークロードに対して、どのWarehouseをどう動かすかを基本レベルで判断できる状態を目指します。',
            docs: [
              ['組織およびアカウントの使用', 'https://docs.snowflake.com/ja/guides-overview-manage'],
              ['ウェアハウスの概要', 'https://docs.snowflake.com/ja/user-guide/warehouses-overview'],
            ],
          },
          {
            no: '03',
            title: 'Loading, Unloading & Transformation',
            summary:
              'Snowflakeへデータを取り込み、外部へ出力し、ロード時に基本的な変換を行う一連のデータ移動を理解します。',
            learn: [
              'Internal / External Stage',
              'COPY INTO <table> とCOPY INTO <location>',
              'Bulk LoadとContinuous Loadの違い',
              'File Formatとロード時の列並べ替え・Cast・変換',
            ],
            outcome:
              'ファイルがStageからTableへ入り、必要に応じて変換され、再び外部へ出力される流れを説明できる状態を目指します。',
            docs: [
              ['データのロードの概要', 'https://docs.snowflake.com/ja/user-guide/data-load-overview'],
              ['データのアンロードの概要', 'https://docs.snowflake.com/ja/user-guide/data-unload-overview'],
              ['ロード中のデータ変換', 'https://docs.snowflake.com/ja/user-guide/data-load-transform'],
            ],
          },
          {
            no: '04',
            title: 'Structured, Semi-structured & Unstructured Data',
            summary:
              'Snowflakeが扱う構造化・半構造化・非構造化データと、それぞれに対応するデータ型・格納方法を整理します。',
            learn: [
              'NUMBER / VARCHAR / DATE / TIMESTAMPなどの基本データ型',
              'VARIANT / OBJECT / ARRAYとJSON等の半構造化データ',
              'FILE型、Stage、非構造化ファイルへのアクセス',
              'Structured / Semi-structured / Unstructuredの違い',
            ],
            outcome:
              'データの形に応じて、Snowflakeでどの型・格納方法を選ぶのかを説明できる状態を目指します。',
            docs: [
              ['データ型の概要', 'https://docs.snowflake.com/ja/sql-reference/intro-summary-data-types'],
              ['半構造化データのロード', 'https://docs.snowflake.com/ja/user-guide/semistructured-intro'],
              ['非構造化データの概要', 'https://docs.snowflake.com/ja/user-guide/unstructured-intro'],
            ],
          },
          {
            no: '05',
            title: 'Performance',
            summary:
              'クエリ実行時間やWarehouseの状態を確認し、Compute・Storage・Queryの観点から基本的なパフォーマンス最適化を学びます。',
            learn: [
              'Warehouse sizeとQuery performance',
              'Queue、Concurrency、Memory spill',
              'Warehouse cacheとQuery Acceleration',
              'Performanceを計測して変更効果を確認する考え方',
            ],
            outcome:
              '「遅いからWarehouseを大きくする」だけでなく、原因に応じた基本的な改善ポイントを切り分けられる状態を目指します。',
            docs: [
              ['Snowflakeでのパフォーマンスの最適化', 'https://docs.snowflake.com/ja/guides-overview-performance'],
              ['パフォーマンスに対するウェアハウスの最適化', 'https://docs.snowflake.com/ja/user-guide/performance-query-warehouse'],
            ],
          },
          {
            no: '06',
            title: 'Collaboration & Data Protection',
            summary:
              'データをコピーせずに共有するSecure Data Sharingと、履歴データの復旧・保護、アクセス制御の基本を整理します。',
            learn: [
              'Provider / Consumer / ShareとSecure Data Sharing',
              'Time Travelによる過去データ参照・Clone・UNDROP',
              'Fail-safeの位置づけ',
              'RBACを中心としたアクセス制御の基本',
            ],
            outcome:
              'データを安全に共有し、誤更新・削除から復旧し、誰が何へアクセスできるかを管理する基本を説明できる状態を目指します。',
            docs: [
              ['Secure Data Sharingについて', 'https://docs.snowflake.com/ja/user-guide/data-sharing-intro'],
              ['Time Travelの理解と使用', 'https://docs.snowflake.com/ja/user-guide/data-time-travel'],
              ['Fail-safeの理解と表示', 'https://docs.snowflake.com/ja/user-guide/data-failsafe'],
              ['アクセス制御の概要', 'https://docs.snowflake.com/ja/user-guide/security-access-control-overview'],
            ],
          },
          {
            no: '07',
            title: 'Connectivity',
            summary:
              'Snowsight、CLI、Drivers、Connectors、APIなど、Snowflakeへ接続する代表的な方法と認証の考え方を整理します。',
            learn: [
              'Snowsight / Snowflake CLI',
              'JDBC / ODBC / Python / Node.js等のDrivers',
              'Connectors / APIs / Third-party tools',
              'SSO、OAuth、Key-pair等の認証方式',
            ],
            outcome:
              '利用者・アプリケーション・外部ツールが、どのインターフェースと認証方式でSnowflakeへ接続するかを整理できる状態を目指します。',
            docs: [
              ['Snowflakeに接続するためのアプリケーションおよびツール', 'https://docs.snowflake.com/ja/guides-overview-connecting'],
              ['Snowflake認証の概要', 'https://docs.snowflake.com/ja/user-guide/security-authentication-overview'],
            ],
          },
        ],
        practicalNotes: [
          'Architecture / Warehouseで間違えたポイント',
          'COPY / Stage / File FormatのSQL例',
          'VARIANT / OBJECT / ARRAYの実データ例',
          'Performance / Sharing / Securityの挙動確認',
        ],
      },
    },
    {
      params: { section: 'data-engineer' },
      props: {
        eyebrow: 'CERTIFICATION',
        title: 'Advanced Data Engineer',
        examCode: 'DEA-C02',
        heroNote: 'PLANNED',
        official: 'https://learn.snowflake.com/en/certifications/snowpro-adv-dea-jpn-C02/',
        genericSections: [
          {
            no: '01',
            title: 'Overview',
            body: 'SnowPro Advanced: Data Engineer（DEA-C02）は、Snowflake上で包括的なデータエンジニアリングの原則を適用する高度な知識とスキルを確認する認定です。',
          },
          {
            no: '02',
            title: 'Key concepts',
            body: 'データソーシング、クラウド間の変換・複製・共有、Near Real-time Stream、スケーラブルなCompute、Performance metricsを中心に整理していきます。',
          },
          {
            no: '03',
            title: 'Practical notes',
            body: '実装・演習・模擬試験から得た内容を追加していきます。',
          },
          {
            no: '04',
            title: 'Review',
            body: '受験前のチェックリスト、弱点、再確認事項をまとめます。',
          },
        ],
      },
    },
    {
      params: { section: 'architect' },
      props: {
        eyebrow: 'CERTIFICATION',
        title: 'Advanced Architect',
        examCode: 'ARA-C01',
        heroNote: 'PLANNED',
        official: 'https://learn.snowflake.com/en/certifications/snowpro-adv-ara-jpn/',
        genericSections: [
          {
            no: '01',
            title: 'Overview',
            body: 'SnowPro Advanced: Architect（ARA-C01）は、Snowflakeを利用して包括的なアーキテクトソリューションを設計・適用する高度な知識とスキルを確認する認定です。',
          },
          {
            no: '02',
            title: 'Key concepts',
            body: 'End-to-End Data Flow、Security / Compliance、Performance、Shared Dataset、DataOps / DevOpsを中心に整理していきます。',
          },
          {
            no: '03',
            title: 'Practical notes',
            body: '設計判断、トレードオフ、実務Architectureの学びを追加していきます。',
          },
          {
            no: '04',
            title: 'Review',
            body: '受験前のチェックリスト、弱点、再確認事項をまとめます。',
          },
        ],
      },
    },
    { params: { section: 'architecture' }, props: { eyebrow: 'PLATFORM', title: 'Architecture' } },
    { params: { section: 'data-engineering' }, props: { eyebrow: 'PIPELINES', title: 'Data Engineering' } },
    { params: { section: 'storage-data' }, props: { eyebrow: 'DATA LAYER', title: 'Storage & Data' } },
    { params: { section: 'performance-cost' }, props: { eyebrow: 'EFFICIENCY', title: 'Performance & Cost' } },
    { params: { section: 'security-governance' }, props: { eyebrow: 'CONTROL', title: 'Security & Governance' } },
    { params: { section: 'sharing-integration' }, props: { eyebrow: 'CONNECT', title: 'Sharing & Integration' } },
    { params: { section: 'apps-development' }, props: { eyebrow: 'BUILD', title: 'Apps & Development' } },
  ];
}

const {
  eyebrow,
  title,
  examCode,
  heroNote = 'CONTENT TBD',
  official,
  overview,
  studyAreas,
  practicalNotes,
  genericSections = [
    { no: '01', title: 'Overview', body: 'TBD · この領域の全体像を整理します。' },
    { no: '02', title: 'Key concepts', body: 'TBD · 重要な概念を整理します。' },
    { no: '03', title: 'Practical notes', body: 'TBD · 実装・検証・学習メモを追加します。' },
    { no: '04', title: 'Review', body: 'TBD · 振り返りとチェックリストをまとめます。' },
  ],
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const isCore = title === 'SnowPro Core';
---

<BaseLayout title={`${title} | Snowflake | Seiji Tech Atlas`}>
  <main class="page">
    <a href={route('topics/snowflake/')} class="back">← Back to Snowflake</a>

    <section class="hero">
      <div class="label">SNOWFLAKE / {eyebrow}</div>
      <h1>{title}</h1>

      <div class="hero-meta">
        {examCode && <code>{examCode}</code>}
        <div class="status"><span></span>{heroNote}</div>
        {official && <a class="official-link" href={official} target="_blank" rel="noreferrer">公式 ↗</a>}
      </div>
    </section>

    {isCore && overview ? (
      <>
        <section class="overview">
          <div class="overview-copy">
            <span class="section-kicker">OVERVIEW</span>
            <h2>SnowPro Coreで学ぶこと</h2>
            <p class="lead">{overview.lead}</p>
            <p>{overview.description}</p>
          </div>

          <div class="outcomes">
            <span class="section-kicker">AFTER STUDYING</span>
            <h3>理解できるようになること</h3>
            <ul>
              {overview.outcomes.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </section>

        <section class="study-section">
          <div class="section-title">
            <span>01</span>
            <h2>Study map</h2>
          </div>

          <div class="study-grid">
            {studyAreas.map((area) => (
              <article class="study-card">
                <div class="card-head">
                  <span class="card-no">{area.no}</span>
                  <h3>{area.title}</h3>
                </div>

                <p class="summary">{area.summary}</p>

                <div class="learn-block">
                  <small>LEARN</small>
                  <ul>{area.learn.map((item) => <li>{item}</li>)}</ul>
                </div>

                <div class="outcome-block">
                  <small>GOAL</small>
                  <p>{area.outcome}</p>
                </div>

                <div class="docs">
                  {area.docs.map(([label, href]) => (
                    <a href={href} target="_blank" rel="noreferrer">
                      <span>{label}</span>
                      <i>↗</i>
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="bottom-grid">
          <article>
            <span class="section-kicker">02 · PRACTICAL NOTES</span>
            <h2>Hands-onで追加する</h2>
            <p>演習・模擬試験・実務で得た内容を、自分があとから再利用できる形で追加していきます。</p>
            <ul>{practicalNotes.map((item) => <li>{item}</li>)}</ul>
          </article>

          <article>
            <span class="section-kicker">03 · REVIEW</span>
            <h2>受験前に圧縮する</h2>
            <p>最後はこのStudy mapを基準に、弱点・間違えやすい点・直前に確認する公式ドキュメントを絞り込みます。</p>
            <ul>
              <li>TBD · 最終チェックリスト</li>
              <li>TBD · 間違えやすいポイント</li>
              <li>TBD · 直前レビュー</li>
            </ul>
          </article>
        </section>
      </>
    ) : (
      <section class="generic-grid">
        {genericSections.map((section) => (
          <article>
            <span>{section.no}</span>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 72% 10%, rgba(104,212,248,.12), transparent 30%),
      #0a1119;
  }

  .page {
    width: min(1140px, calc(100% - 40px));
    margin: 0 auto;
    padding: 42px 0 100px;
  }

  .back {
    color: #8fa4b0;
    font-size: .82rem;
  }

  .hero {
    padding: 82px 0 58px;
    border-bottom: 1px solid rgba(190,220,240,.18);
  }

  .label,
  .section-kicker {
    color: #68d4f8;
    font: 800 .66rem/1 ui-monospace,monospace;
    letter-spacing: .16em;
  }

  h1 {
    margin: 14px 0 24px;
    color: #f2f7fa;
    font-size: clamp(3.2rem,8vw,6.5rem);
    line-height: .9;
    letter-spacing: -.065em;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .hero-meta code,
  .status,
  .official-link {
    padding: 8px 11px;
    border-radius: 999px;
    font-size: .7rem;
  }

  .hero-meta code {
    border: 1px solid rgba(190,220,240,.16);
    color: #b9cbd5;
    background: rgba(17,29,41,.72);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(104,212,248,.28);
    color: #b9ced8;
    font: 700 .64rem/1 ui-monospace,monospace;
    letter-spacing: .08em;
  }

  .status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #68d4f8;
    box-shadow: 0 0 12px rgba(104,212,248,.65);
  }

  .official-link {
    border: 1px solid rgba(104,212,248,.34);
    color: #68d4f8;
    background: rgba(14,28,39,.68);
  }

  .official-link:hover {
    border-color: rgba(104,212,248,.65);
    color: #dff8ff;
  }

  .overview {
    display: grid;
    grid-template-columns: 1.08fr .92fr;
    gap: 18px;
    margin-top: 36px;
  }

  .overview-copy,
  .outcomes {
    padding: 28px;
    border: 1px solid rgba(190,220,240,.18);
    border-radius: 18px;
    background: linear-gradient(145deg,rgba(18,31,44,.95),rgba(11,21,31,.95));
  }

  .overview h2,
  .outcomes h3,
  .bottom-grid h2 {
    margin: 12px 0 14px;
    color: #eef6f9;
  }

  .overview-copy .lead {
    color: #d9e5eb;
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .overview-copy p,
  .outcomes li,
  .bottom-grid p,
  .bottom-grid li {
    color: #9fb0ba;
    line-height: 1.72;
    font-size: .82rem;
  }

  .outcomes ul,
  .bottom-grid ul {
    margin: 14px 0 0;
    padding-left: 18px;
  }

  .outcomes li,
  .bottom-grid li {
    margin-bottom: 8px;
  }

  .study-section {
    margin-top: 74px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }

  .section-title > span {
    color: #587383;
    font: 700 .7rem/1 ui-monospace,monospace;
  }

  .section-title h2 {
    margin: 0;
    color: #eef6f9;
    font-size: 2rem;
    letter-spacing: -.04em;
  }

  .study-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .study-card {
    padding: 24px;
    border: 1px solid rgba(190,220,240,.19);
    border-radius: 17px;
    background:
      radial-gradient(circle at 100% 0, rgba(104,212,248,.055), transparent 36%),
      linear-gradient(145deg,rgba(18,31,44,.95),rgba(11,21,31,.95));
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .card-no {
    color: #68d4f8;
    font: 800 .68rem/1 ui-monospace,monospace;
  }

  .study-card h3 {
    margin: 0;
    color: #f0f6f9;
    font-size: 1.22rem;
  }

  .summary {
    margin: 16px 0 0;
    color: #aebfc8;
    font-size: .82rem;
    line-height: 1.72;
  }

  .learn-block,
  .outcome-block {
    margin-top: 20px;
    padding-top: 17px;
    border-top: 1px solid rgba(190,220,240,.11);
  }

  .learn-block small,
  .outcome-block small {
    color: #6f8796;
    font: 800 .6rem/1 ui-monospace,monospace;
    letter-spacing: .14em;
  }

  .learn-block ul {
    margin: 12px 0 0;
    padding-left: 18px;
  }

  .learn-block li,
  .outcome-block p {
    margin: 0 0 7px;
    color: #93a8b4;
    font-size: .76rem;
    line-height: 1.6;
  }

  .outcome-block p {
    margin-top: 10px;
  }

  .docs {
    display: grid;
    gap: 7px;
    margin-top: 20px;
  }

  .docs a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 11px;
    border: 1px solid rgba(104,212,248,.17);
    border-radius: 9px;
    color: #a9c4cf;
    background: rgba(12,25,35,.7);
    font-size: .72rem;
  }

  .docs a:hover {
    border-color: rgba(104,212,248,.45);
    color: #e3f8ff;
  }

  .docs i {
    color: #68d4f8;
    font-style: normal;
  }

  .bottom-grid,
  .generic-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 74px;
  }

  .bottom-grid article,
  .generic-grid article {
    padding: 26px;
    border: 1px solid rgba(190,220,240,.18);
    border-radius: 17px;
    background: linear-gradient(145deg,rgba(18,31,44,.95),rgba(11,21,31,.95));
  }

  .generic-grid article > span {
    color: #526b7b;
    font: 700 .68rem/1 ui-monospace,monospace;
  }

  .generic-grid h2 {
    margin: 26px 0 10px;
    color: #eef6f9;
  }

  .generic-grid p {
    color: #9fb0ba;
    font-size: .82rem;
    line-height: 1.72;
  }

  @media (max-width: 760px) {
    .overview,
    .study-grid,
    .bottom-grid,
    .generic-grid {
      grid-template-columns: 1fr;
