---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import CoreNav from '../../../../../components/snowpro/CoreNav.astro';
import { diagrams, domains, diagramBySlug } from '../../../../../data/snowproCore';

export function getStaticPaths() {
  return diagrams.map((diagram) => ({ params: { slug: diagram.slug } }));
}

const { slug } = Astro.params;
const diagram = diagramBySlug(slug!);
if (!diagram) throw new Error(`Diagram not found: ${slug}`);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
const domain = diagram.domain === 'MASTER' ? null : domains.find((d) => d.id === diagram.domain)!;
const related = diagram.related.map((id) => diagrams.find((d) => d.id === id)).filter(Boolean);
---

<BaseLayout title={`${diagram.title} | SnowPro Core | Seiji Tech Atlas`}>
  <main class="page" style={domain ? `--accent:${domain.color}` : '--accent:#68d4f8'}>
    <a class="back" href={route('topics/snowflake/core/diagrams/')}>← Back to Diagram Library</a>
    <CoreNav />

    <section class="hero">
      <div>
        <div class="eyebrow">{diagram.id} · {domain ? domain.shortTitle.toUpperCase() : 'MASTER MAP'}</div>
        <h1>{diagram.title}</h1>
        <p>{diagram.purpose}</p>
      </div>
      <div class="state">
        <small>PRIORITY</small><strong>{diagram.priority}</strong>
        <span>{diagram.status.toUpperCase()}</span>
      </div>
    </section>

    <section class="visual">
      {diagram.id === 'M-01' ? (
        <div class="master-visual">
          <div class="core-node"><small>COF-C03</small><strong>SnowPro Core</strong></div>
          <div class="domain-nodes">
            {domains.map((d) => (
              <a href={route(`topics/snowflake/core/domains/${d.slug}/`)} style={`--node:${d.color}`}>
                <span>{d.id}</span>
                <strong>{d.weight}%</strong>
                <h3>{d.shortTitle}</h3>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="concept-visual">
          <div class="center-node"><small>{diagram.id}</small><strong>{diagram.title}</strong></div>
          <div class="satellites">
            {diagram.keywords.map((keyword, i) => (
              <div class={`satellite s${(i % 6) + 1}`}><span>{keyword}</span></div>
            ))}
          </div>
          <div class="visual-note">VISUAL DESIGN · {diagram.status === 'planned' ? 'TO BE BUILT' : diagram.status.toUpperCase()}</div>
        </div>
      )}
    </section>

    <section class="content-grid">
      <article>
        <small>WHAT TO UNDERSTAND</small>
        <h2>Concept goal</h2>
        <p>{diagram.purpose}</p>
        <div class="term-list">
          {diagram.keywords.map((keyword) => <span>{keyword}</span>)}
        </div>
      </article>

      <article>
        <small>EXAM VIEW</small>
        <h2>What to distinguish</h2>
        <p>
          このページでは、用語を単独で覚えるのではなく、似た機能との違い・処理の流れ・どの条件で選ぶかを図で整理します。
          詳細は図解制作時に公式仕様とともに追記します。
        </p>
      </article>
    </section>

    {diagram.docs.length > 0 && (
      <section class="links">
        <div class="section-title"><span>OFFICIAL</span><h2>Documentation</h2></div>
        <div class="link-list">
          {diagram.docs.map((doc) => <a href={doc.href} target="_blank" rel="noreferrer"><span>{doc.label}</span><i>↗</i></a>)}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="links">
        <div class="section-title"><span>NEXT</span><h2>Related diagrams</h2></div>
        <div class="related-grid">
          {related.map((item) => item && (
            <a href={route(`topics/snowflake/core/diagrams/${item.slug}/`)}><small>{item.id}</small><strong>{item.title}</strong></a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  :global(body){background:radial-gradient(circle at 75% 8%,color-mix(in srgb,var(--accent) 14%,transparent),transparent 31%),#08111a}.page{width:min(1120px,calc(100% - 40px));margin:0 auto;padding:34px 0 100px}.back{color:#8197a4;font-size:.78rem}.hero{display:grid;grid-template-columns:1fr auto;gap:35px;align-items:end;padding:60px 0 45px;border-bottom:1px solid rgba(190,220,240,.15)}.eyebrow,.content-grid small,.section-title span{color:var(--accent);font:800 .62rem/1 ui-monospace,monospace;letter-spacing:.15em}.hero h1{margin:15px 0 14px;color:#f0f7fa;font-size:clamp(2.8rem,6vw,5.4rem);line-height:.96;letter-spacing:-.055em}.hero p{max-width:720px;color:#9db0bb;line-height:1.7}.state{min-width:130px;padding:18px;border:1px solid rgba(190,220,240,.15);border-top:2px solid var(--accent);border-radius:13px;background:#0e1b25}.state small{color:#607a88;font:800 .56rem/1 ui-monospace,monospace}.state strong{display:block;margin:10px 0;color:#edf7fb;font-size:1.8rem}.state span{color:var(--accent);font:700 .58rem/1 ui-monospace,monospace}
  .visual{padding:55px 0;border-bottom:1px solid rgba(190,220,240,.14)}.concept-visual{position:relative;min-height:430px;border:1px solid rgba(190,220,240,.17);border-radius:22px;background:radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--accent) 12%,transparent),transparent 31%),linear-gradient(145deg,#10202d,#09151f);overflow:hidden}.center-node{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:min(280px,55%);padding:28px 20px;text-align:center;border:1px solid color-mix(in srgb,var(--accent) 42%,rgba(190,220,240,.18));border-radius:17px;background:#0e1e29;box-shadow:0 0 45px color-mix(in srgb,var(--accent) 11%,transparent)}.center-node small{color:var(--accent);font:800 .62rem/1 ui-monospace,monospace}.center-node strong{display:block;margin-top:10px;color:#eef7fa;font-size:1.25rem}.satellite{position:absolute;padding:9px 11px;border:1px solid rgba(190,220,240,.16);border-radius:999px;background:#122431;color:#a9bbc4;font-size:.68rem}.s1{left:8%;top:20%}.s2{right:8%;top:20%}.s3{left:6%;bottom:22%}.s4{right:6%;bottom:22%}.s5{left:39%;top:9%}.s6{left:39%;bottom:9%}.visual-note{position:absolute;right:16px;bottom:14px;color:#536d7c;font:700 .56rem/1 ui-monospace,monospace;letter-spacing:.12em}.master-visual{display:grid;grid-template-columns:190px 1fr;gap:16px;min-height:420px}.core-node{display:flex;flex-direction:column;justify-content:center;padding:24px;border:1px solid rgba(104,212,248,.3);border-radius:20px;background:radial-gradient(circle at 50% 38%,rgba(104,212,248,.16),transparent 43%),#0e1d28}.core-node small{color:#68d4f8;font:800 .62rem/1 ui-monospace,monospace}.core-node strong{margin-top:14px;color:#edf7fb;font-size:1.8rem}.domain-nodes{display:grid;grid-template-columns:repeat(2,1fr);gap:11px}.domain-nodes a{padding:19px;border:1px solid rgba(190,220,240,.16);border-top:2px solid var(--node);border-radius:14px;background:#0f1d28}.domain-nodes a:last-child{grid-column:1/-1}.domain-nodes span{color:var(--node);font:800 .6rem/1 ui-monospace,monospace}.domain-nodes strong{float:right;color:var(--node)}.domain-nodes h3{margin:22px 0 0;color:#eaf3f7}
  .content-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:55px 0;border-bottom:1px solid rgba(190,220,240,.14)}.content-grid article{padding:22px;border:1px solid rgba(190,220,240,.16);border-radius:15px;background:#0e1b26}.content-grid h2{margin:14px 0 10px;color:#edf5f8;font-size:1.2rem}.content-grid p{margin:0;color:#91a6b1;font-size:.78rem;line-height:1.7}.term-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:17px}.term-list span{padding:5px 7px;border:1px solid rgba(190,220,240,.12);border-radius:999px;color:#7f99a6;font-size:.58rem}.links{padding:50px 0;border-bottom:1px solid rgba(190,220,240,.13)}.section-title{margin-bottom:17px}.section-title h2{margin:8px 0 0;color:#edf5f8}.link-list{display:grid;gap:7px}.link-list a{display:flex;justify-content:space-between;padding:11px 13px;border:1px solid rgba(190,220,240,.14);border-radius:9px;background:#0d1a24;color:#a6bac4;font-size:.73rem}.link-list i{color:var(--accent);font-style:normal}.related-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.related-grid a{padding:15px;border:1px solid rgba(190,220,240,.14);border-radius:10px;background:#0d1a24}.related-grid small{display:block;color:var(--accent);font:800 .58rem/1 ui-monospace,monospace}.related-grid strong{display:block;margin-top:8px;color:#dfeaf0;font-size:.78rem}@media(max-width:760px){.hero,.content-grid,.master-visual{grid-template-columns:1fr}.state{width:fit-content}.domain-nodes,.related-grid{grid-template-columns:1fr}.domain-nodes a:last-child{grid-column:auto}.concept-visual{min-height:500px}}
</style>
