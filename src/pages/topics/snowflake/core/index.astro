---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CoreNav from '../../../../components/snowpro/CoreNav.astro';
import { exam, domains, diagrams, publicCapabilities } from '../../../../data/snowproCore';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path = '') => `${BASE}/${path.replace(/^\/+/, '')}`;
---

<BaseLayout title="SnowPro Core | Seiji Tech Atlas">
  <main class="core-page">
    <a class="back" href={route('topics/snowflake/')}>← Back to Snowflake</a>
    <CoreNav />

    <section class="hero">
      <div class="hero-copy">
        <div class="eyebrow">SNOWFLAKE / CERTIFICATION</div>
        <h1>SnowPro Core</h1>
        <p>
          COF-C03の試験範囲を、5つのドメイン・図解・重要用語・公式ドキュメントへつなげた学習Atlas。
          試験対策だけで終わらせず、あとから実務と再認定で使い直せる知識として整理します。
        </p>

        <div class="hero-meta">
          <code>{exam.code}</code>
          <span>5 DOMAINS</span>
          <span>{diagrams.length} DIAGRAMS</span>
        </div>
      </div>

      <div class="hero-scope">
        <small>EXAM SCOPE</small>
        <div class="scope-title">
          <strong>5 domains</strong>
          <span>100%</span>
        </div>

        <div class="scope-bar" aria-label="Exam domain weights">
          {domains.map((domain) => (
            <span style={`--accent:${domain.color}; --weight:${domain.weight}%`} title={`${domain.shortTitle} ${domain.weight}%`}></span>
          ))}
        </div>

        <div class="scope-legend">
          {domains.map((domain) => (
            <a href={route(`topics/snowflake/core/domains/${domain.slug}/`)} style={`--accent:${domain.color}`}>
              <i></i>
              <span>{domain.id}</span>
              <strong>{domain.weight}%</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="exam-map">
      <div class="section-head">
        <span>01 · EXAM MAP</span>
        <h2>Five domains, one map</h2>
      </div>

      <div class="domain-map">
        {domains.map((domain) => (
          <a
            class="domain-card"
            href={route(`topics/snowflake/core/domains/${domain.slug}/`)}
            style={`--accent:${domain.color}`}
          >
            <div class="domain-top">
              <div>
                <small>{domain.id}</small>
                <h3>{domain.shortTitle}</h3>
              </div>
              <strong>{domain.weight}%</strong>
            </div>

            <div class="domain-meter"><span style={`width:${domain.weight}%`}></span></div>
            <p>{domain.summary}</p>

            <div class="focus-chips">
              {domain.focus.slice(0, 5).map((item) => <span>{item}</span>)}
            </div>

            <div class="open-domain">Open domain ↗</div>
          </a>
        ))}
      </div>
    </section>

    <section class="section capability-section">
      <div class="section-head">
        <span>02 · CAPABILITY MAP</span>
        <h2>5 domains × 7 capabilities</h2>
      </div>

      <div class="capability-matrix" aria-label="Relationship between exam domains and required capabilities">
        <div class="matrix-head">
          <div class="matrix-corner">
            <small>CAPABILITY</small>
          </div>

          {domains.map((domain) => (
            <a
              class="matrix-domain"
              href={route(`topics/snowflake/core/domains/${domain.slug}/`)}
              style={`--accent:${domain.color}`}
            >
              <span>{domain.id}</span>
              <strong>{domain.shortTitle}</strong>
              <small>{domain.weight}%</small>
            </a>
          ))}
        </div>

        <div class="matrix-body">
          {publicCapabilities.map((capability, index) => (
            <div class="matrix-row">
              <div class="capability-label">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <strong>{capability.label}</strong>
              </div>

              {domains.map((domain) => {
                const related = capability.domains.includes(domain.id as never);
                return related ? (
                  <a
                    class="matrix-cell related"
                    href={route(`topics/snowflake/core/domains/${domain.slug}/`)}
                    style={`--accent:${domain.color}`}
                    aria-label={`${capability.label} → ${domain.shortTitle}`}
                  >
                    <i></i>
                    <small>{domain.id}</small>
                  </a>
                ) : (
                  <div class="matrix-cell empty" aria-hidden="true"><i></i></div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section library-section">
      <div class="section-head">
        <span>03 · REFERENCE LIBRARY</span>
        <h2>Diagrams, terms, sources, and notes</h2>
      </div>

      <div class="library-grid">
        <a href={route('topics/snowflake/core/diagrams/')}>
          <small>VISUAL</small>
          <strong>{diagrams.length}</strong>
          <h3>Diagram Library</h3>
          <p>試験範囲の概念と関係を、36枚の図解で整理する。</p>
          <span>Open library ↗</span>
        </a>

        <a href={route('topics/snowflake/core/glossary/')}>
          <small>TERMS</small>
          <strong>A–Z</strong>
          <h3>Glossary</h3>
          <p>重要用語をドメインと関連づけて、復習できる形で管理する。</p>
          <span>Open glossary ↗</span>
        </a>

        <a href={route('topics/snowflake/core/resources/')}>
          <small>SOURCE</small>
          <strong>Docs</strong>
          <h3>Official Resources</h3>
          <p>試験範囲と各概念をSnowflake公式ドキュメントへ直接つなぐ。</p>
          <span>Open resources ↗</span>
        </a>

        <a href={route('topics/snowflake/core/notes/')}>
          <small>PRACTICE</small>
          <strong>Notes</strong>
          <h3>Practical Notes</h3>
          <p>演習・模擬問題・実務で得た気づきを、自分の復習用に蓄積する。</p>
          <span>Open notes ↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: radial-gradient(circle at 72% 8%, rgba(68,190,235,.15), transparent 30%), #08111a;
  }

  .core-page { width:min(1180px, calc(100% - 40px)); margin:0 auto; padding:34px 0 100px; }
  .back { color:#8298a5; font-size:.78rem; }

  .hero {
    display:grid;
    grid-template-columns:1.15fr .85fr;
    gap:60px;
    align-items:center;
    padding:68px 0 58px;
    border-bottom:1px solid rgba(190,220,240,.18);
  }

  .eyebrow,
  .section-head span {
    color:#68d4f8;
    font:800 .64rem/1 ui-monospace,monospace;
    letter-spacing:.16em;
  }

  .hero h1 {
    margin:14px 0 18px;
    color:#f3f8fb;
    font-size:clamp(3.6rem,8vw,7rem);
    line-height:.88;
    letter-spacing:-.065em;
  }

  .hero p {
    max-width:700px;
    color:#a9bac4;
    font-size:.98rem;
    line-height:1.8;
  }

  .hero-meta {
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:24px;
  }

  .hero-meta > * {
    padding:7px 10px;
    border:1px solid rgba(190,220,240,.16);
    border-radius:999px;
    color:#a9c0cb;
    background:rgba(15,28,40,.78);
    font:700 .62rem/1 ui-monospace,monospace;
  }

  .hero-scope {
    min-height:250px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:28px;
    border:1px solid rgba(104,212,248,.25);
    border-radius:24px;
    background:
      radial-gradient(circle at 50% 35%, rgba(104,212,248,.13), transparent 46%),
      linear-gradient(145deg,#12202d,#0b1620);
  }

  .hero-scope > small {
    color:#698391;
    font:800 .62rem/1 ui-monospace,monospace;
    letter-spacing:.16em;
  }

  .scope-title {
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    gap:20px;
    margin-top:15px;
  }

  .scope-title strong {
    color:#edf8fc;
    font-size:2rem;
    letter-spacing:-.04em;
  }

  .scope-title span {
    color:#6ed8ff;
    font-size:1rem;
  }

  .scope-bar {
    display:flex;
    height:10px;
    overflow:hidden;
    margin-top:22px;
    border-radius:999px;
    background:#132431;
  }

  .scope-bar > span {
    width:var(--weight);
    background:var(--accent);
  }

  .scope-legend {
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:6px;
    margin-top:15px;
  }

  .scope-legend a {
    display:flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    min-width:0;
    padding:7px 6px;
    border:1px solid rgba(190,220,240,.1);
    border-radius:8px;
    color:#7f95a1;
    font-size:.58rem;
  }

  .scope-legend a:hover { border-color:color-mix(in srgb,var(--accent) 42%,transparent); color:#dcebf1; }
  .scope-legend i { width:6px; height:6px; border-radius:50%; background:var(--accent); }
  .scope-legend strong { color:var(--accent); font-size:.58rem; }

  .section {
    padding:76px 0;
    border-bottom:1px solid rgba(190,220,240,.15);
  }

  .section-head { margin-bottom:25px; }
  .section-head h2 { margin:10px 0 0; color:#eff7fb; font-size:2.2rem; letter-spacing:-.04em; }

  .domain-map {
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
  }

  .domain-card {
    display:block;
    padding:22px;
    border:1px solid rgba(190,220,240,.17);
    border-top:2px solid var(--accent);
    border-radius:16px;
    background:
      radial-gradient(circle at 100% 0, color-mix(in srgb,var(--accent) 9%,transparent), transparent 36%),
      linear-gradient(145deg,rgba(18,31,44,.96),rgba(10,20,30,.96));
    transition:.18s ease;
  }

  .domain-card:last-child { grid-column:1 / -1; }
  .domain-card:hover { transform:translateY(-2px); border-color:color-mix(in srgb,var(--accent) 42%,rgba(190,220,240,.18)); }

  .domain-top { display:flex; justify-content:space-between; gap:20px; align-items:flex-start; }
  .domain-top small { color:var(--accent); font:800 .62rem/1 ui-monospace,monospace; }
  .domain-top h3 { margin:8px 0 0; color:#eaf4f8; font-size:1.16rem; }
  .domain-top strong { color:var(--accent); font-size:1.35rem; }

  .domain-meter { height:4px; margin:15px 0; overflow:hidden; border-radius:999px; background:#132431; }
  .domain-meter span { display:block; height:100%; background:var(--accent); box-shadow:0 0 14px color-mix(in srgb,var(--accent) 55%,transparent); }

  .domain-card > p { margin:0; color:#91a5b0; font-size:.78rem; line-height:1.65; }

  .focus-chips { display:flex; flex-wrap:wrap; gap:5px; margin-top:15px; }
  .focus-chips span { padding:5px 7px; border:1px solid rgba(190,220,240,.12); border-radius:999px; color:#7f96a2; font-size:.56rem; }

  .open-domain { margin-top:18px; color:var(--accent); font-size:.68rem; }

  .capability-matrix {
    overflow:hidden;
    border:1px solid rgba(190,220,240,.16);
    border-radius:18px;
    background:linear-gradient(145deg,rgba(17,31,43,.96),rgba(9,19,28,.98));
  }

  .matrix-head,
  .matrix-row {
    display:grid;
    grid-template-columns:minmax(260px,1.35fr) repeat(5,minmax(92px,.72fr));
  }

  .matrix-head {
    border-bottom:1px solid rgba(190,220,240,.14);
    background:rgba(7,17,25,.5);
  }

  .matrix-corner,
  .matrix-domain,
  .capability-label,
  .matrix-cell {
    min-width:0;
    border-right:1px solid rgba(190,220,240,.09);
  }

  .matrix-corner,
  .matrix-domain { min-height:108px; }

  .matrix-corner {
    display:flex;
    align-items:flex-end;
    padding:18px 20px;
  }

  .matrix-corner small {
    color:#617986;
    font:800 .58rem/1 ui-monospace,monospace;
    letter-spacing:.16em;
  }

  .matrix-domain {
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    gap:5px;
    padding:16px 13px;
    border-top:2px solid var(--accent);
    color:#b7c9d2;
    background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 6%,transparent),transparent 70%);
  }

  .matrix-domain:hover { background:color-mix(in srgb,var(--accent) 10%,transparent); }
  .matrix-domain span { color:var(--accent); font:800 .61rem/1 ui-monospace,monospace; }
  .matrix-domain strong { color:#dbe8ee; font-size:.68rem; line-height:1.25; }
  .matrix-domain small { color:#6f8997; font:700 .56rem/1 ui-monospace,monospace; }

  .matrix-row { border-bottom:1px solid rgba(190,220,240,.085); }
  .matrix-row:last-child { border-bottom:0; }

  .capability-label {
    display:flex;
    align-items:center;
    gap:13px;
    min-height:76px;
    padding:14px 20px;
  }

  .capability-label span {
    flex:0 0 auto;
    color:#48616f;
    font:800 .58rem/1 ui-monospace,monospace;
  }

  .capability-label strong {
    color:#dbe7ec;
    font-size:.78rem;
    line-height:1.45;
  }

  .matrix-cell {
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    min-height:76px;
    transition:.16s ease;
  }

  .matrix-cell i {
    width:9px;
    height:9px;
    border-radius:50%;
  }

  .matrix-cell.empty i {
    width:3px;
    height:3px;
    background:rgba(190,220,240,.10);
  }

  .matrix-cell.related {
    background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 7%,transparent),transparent);
  }

  .matrix-cell.related:hover {
    background:color-mix(in srgb,var(--accent) 13%,transparent);
  }

  .matrix-cell.related i {
    background:var(--accent);
    box-shadow:0 0 14px color-mix(in srgb,var(--accent) 62%,transparent);
  }

  .matrix-cell.related small {
    color:var(--accent);
    font:800 .58rem/1 ui-monospace,monospace;
  }

  .library-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
  .library-grid > a { position:relative; display:block; min-height:220px; padding:22px; border:1px solid rgba(190,220,240,.16); border-radius:15px; background:linear-gradient(145deg,#11202c,#0c1721); transition:.18s ease; }
  .library-grid > a:hover { transform:translateY(-2px); border-color:rgba(104,212,248,.35); }
  .library-grid small { color:#68d4f8; font:800 .6rem/1 ui-monospace,monospace; letter-spacing:.13em; }
  .library-grid strong { display:block; margin-top:15px; color:#425e6d; font-size:1.7rem; }
  .library-grid h3 { margin:8px 0 8px; color:#e9f3f7; font-size:1.12rem; }
  .library-grid p { margin:0; color:#8fa3ae; font-size:.74rem; line-height:1.62; }
  .library-grid > a > span { position:absolute; left:22px; bottom:20px; color:#68d4f8; font-size:.68rem; }

  @media(max-width:800px) {
    .hero,
    .domain-map,
    .library-grid { grid-template-columns:1fr; }
    .domain-card:last-child { grid-column:auto; }
    .scope-legend { grid-template-columns:repeat(2,1fr); }

    .capability-matrix { overflow-x:auto; }
    .matrix-head,
    .matrix-row { min-width:850px; }
  }
</style>
